{
  "name": "jigsawlab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply jigsawlab-db --local",
    "db:migrate": "wrangler d1 migrations apply jigsawlab-db --remote",
    "astro": "astro",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260825.1",
    "playwright": "1.40.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
