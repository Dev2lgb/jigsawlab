---
import { BODY } from '../i18n/body';
// 소개 페이지 — 히어로 / 4가지 포인트 / 가이드(왼쪽 고정 목차 + 오른쪽 본문). 섹션 간격은 홈의 .sec 리듬과 동일
import Base from '../layouts/Base.astro';
import { altsFor, UI, prefix, type Lang } from '../i18n/ui';
import { WORKS } from '../data/works';
import Guide from './Guide.astro';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], P = prefix(lang), A = T.about;
---
<Base title={A.seoTitle} desc={A.lead} lang={lang} alts={altsFor('/about/')} path={`${P}/about/`}>
  <section class="hero"><div class="wrap hero-in"><h1>{A.title}</h1><p class="lead">{A.lead}</p><a class="btn primary lg" href={`${P}/play/`}>{T.nav.play}</a></div></section>
  <section class="sec"><div class="wrap"><div class="points">{A.points(WORKS.length).map(([h, b], i) => <div class="pt" data-reveal={String(i)}><span class="n">{i + 1}</span><h2>{h}</h2><p>{b}</p></div>)}</div></div></section>
  <Guide html={BODY[lang].about} prefix="g" heading={A.guide} />
  <style>
    .hero { background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
    .hero-in { padding-top: clamp(48px, 8vw, 110px); padding-bottom: clamp(40px, 6vw, 72px); }
    .hero h1 { font-family: var(--brand); font-size: clamp(2.2rem, 5vw, 4rem); letter-spacing: -.03em; } .lead { margin: 18px 0 28px; font-size: clamp(1.05rem, 1.6vw, 1.3rem); color: var(--ink-2); max-width: 40em; }
    .points { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    @media (max-width: 1000px) { .points { grid-template-columns: repeat(2, 1fr); } } @media (max-width: 560px) { .points { grid-template-columns: 1fr; } }
    .pt { padding: 28px; border-radius: var(--r); background: var(--bg-2); } .pt .n { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--ink); color: #fff; font-weight: 800; margin-bottom: 16px; } .pt h2 { font-size: 1.2rem; margin: 0 0 8px; } .pt p { margin: 0; color: var(--ink-2); }
  </style>
</Base>
