---
// 퍼즐 상자 하나 — 링크(a) 또는 버튼(button)
interface Props { p: { key: string; title: string; artist: string; year: string }; href?: string; on?: boolean }
const { p, href, on = false } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['box', { on }]} href={href} type={href ? undefined : 'button'} data-key={p.key} title={`${p.title} — ${p.artist}, ${p.year}`}>
  <span class="spine" aria-hidden="true"><span>{p.title}</span></span>
  <span class="front"><span class="box-top"><small>{p.year}</small><b>{p.title}</b></span><img src={`/jigsaw/t-${p.key}.jpg`} alt={p.title} loading="lazy" width="240" height="190" /><span class="box-foot"><span class="logo">jigsawlab</span><small>{p.artist}</small></span></span>
</Tag>
