---
// 랜딩 홈 — 풀블리드 히어로(오늘 그림의 색이 배경으로 번짐 + 조각 빠진 그림) → 흐르는 상자 마퀴 → 카테고리별 3D 상자 진열대 → 내 사진
import Box from './Box.astro';
import { UI, LI, prefix, type Lang } from '../i18n/ui';
import { DAILY_PIECES, todayKST, dailyPick } from '../lib/jigsaw';
import { DAILY_POOL, WORKS } from '../data/works';
import { shelvesFor } from '../lib/catalogView';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], li = LI[lang], P = prefix(lang);
const day = todayKST(), daily = dailyPick(day, DAILY_POOL), shelves = shelvesFor(lang), total = WORKS.length;
const all = shelves.flatMap((s) => s.items);
const marquee = all.filter((_, i) => i % 6 === 0).slice(0, 26);
---
<section class="hero" id="hero" data-key={daily.painting.key}>
  <div class="glow" aria-hidden="true"><img id="glow-img" src={`/jigsaw/t-${daily.painting.key}.webp`} alt="" /></div>
  <div class="wrap hero-in">
    <div class="hero-text">
      <h1 set:html={T.hero.h1.replace('\n', '<br />')} />
      <p class="sub">{T.hero.sub}</p>
      <ul class="feats">{T.hero.feats.map((f) => <li>{f}</li>)}</ul>
      <div class="nums"><div><b data-n={total}>{total}</b><span>{T.hero.statPuzzles}</span></div><div id="num-solved" hidden><b data-n="0">0</b><span>{T.hero.statSolved}</span></div></div>
      <div class="cta"><a class="btn primary lg" href="#catalog">{T.hero.pick}</a><a class="btn lg" href={`${P}/photo/`}>{T.hero.photo}</a></div>
      <p class="streak" id="hero-streak" hidden>🔥 <span></span></p>
    </div>
    <div class="hero-side">
      <a class="hero-art" id="hero-art" href={`${P}/board/?daily=1`} aria-label={T.hero.cta}><canvas id="hero-cv" width="720" height="560"></canvas></a>
      <a class="today-link" id="hero-today" href={`${P}/board/?daily=1`}>{T.hero.todayLink(daily.painting.title[li])}</a>
    </div>
  </div>
</section>

<section class="past wrap" id="past">
  <h2 class="past-h">{T.play.past}</h2>
  <div class="past-row" id="past-row"></div>
</section>

<section class="marq" aria-hidden="true">
  <div class="marq-track">{[...marquee, ...marquee].map((p) => <img src={`/jigsaw/t-${p.key}.webp`} alt="" loading="lazy" width="240" height="190" />)}</div>
</section>

<section class="sec" id="catalog">
  <div class="wrap">
    <div class="sec-head" data-reveal><div><h2 class="sec-h">{T.catalog.title}</h2>{T.catalog.sub && <p class="sec-sub">{T.catalog.sub}</p>}</div><div class="tools"><a class="btn" href={`${P}/play/`}>{T.catalog.all(total)} →</a></div></div>
  </div>
  {shelves.map((sh, i) => <div class="shelf wrap" data-reveal={String(Math.min(i, 3))}>
    <h3><span>{sh.name}</span><small>{sh.items.length}</small></h3>
    <div class="shelf-grid" id={`shelf-${sh.id}`}>{sh.items.slice(0, sh.top).map((p) => <Box p={p} href={`${P}/puzzle/${p.key}/`} />)}</div>
    <div class="plank" aria-hidden="true"></div>
    {sh.items.length > sh.top && <a class="shelf-all" href={`${P}/play/${sh.id}/`}>{T.catalog.showAll(sh.items.length)}</a>}
  </div>)}
</section>



<style>
  /* 히어로 — 오늘 그림을 크게 흐려 배경으로 깔고, 위에 흰 그라데이션 */
  .hero { position: relative; overflow: hidden; background: var(--bg); }
  .glow { position: absolute; inset: -20%; z-index: 0; pointer-events: none; } .glow img { width: 100%; height: 100%; object-fit: cover; filter: blur(70px) saturate(1.5); opacity: .5; transform: scale(1.1); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: 0; background: linear-gradient(180deg, rgba(255,255,255,.55) 0%, rgba(255,255,255,.35) 50%, var(--bg) 100%); }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding-top: clamp(12px, 3vw, 40px); padding-bottom: clamp(48px, 7vw, 96px); min-height: calc(100dvh - var(--top-h) - 40px); }
  .hero h1 { font-size: clamp(2.4rem, 5.4vw, 4.4rem); line-height: 1.08; letter-spacing: -0.04em; }
  .sub { margin: 18px 0 0; color: var(--ink-2); font-size: clamp(1rem, 1.5vw, 1.18rem); max-width: 34em; }
  .feats { list-style: none; margin: 26px 0 0; padding: 18px 0 0; border-top: 1px solid rgba(15,18,34,.18); display: grid; grid-template-columns: repeat(2, auto); justify-content: start; column-gap: clamp(20px, 3vw, 44px); row-gap: 10px; } .feats li { position: relative; padding-left: 16px; font-size: .95rem; font-weight: 600; color: var(--ink); } .feats li::before { content: ''; position: absolute; left: 0; top: .55em; width: 7px; height: 7px; background: var(--ink); }
  @media (max-width: 560px) { .feats { grid-template-columns: 1fr; } }
  .nums { display: flex; gap: clamp(24px, 4vw, 48px); margin: 24px 0 0; } .nums div { display: flex; flex-direction: column; } .nums b { font-family: var(--head); font-size: clamp(1.9rem, 3.4vw, 2.8rem); line-height: 1; letter-spacing: -.02em; font-variant-numeric: tabular-nums; } .nums span { color: var(--muted); font-size: .85rem; font-weight: 600; margin-top: 6px; }
  .hero-side { display: flex; flex-direction: column; gap: 14px; align-items: center; }
  .today-link { color: var(--ink-2); font-size: .9rem; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(15,18,34,.3); } .today-link:hover { color: var(--ink); text-decoration-color: var(--ink); } .today-link .stat { color: var(--ink); }
  .today { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 14px 6px 10px; border-radius: 999px; background: rgba(255,255,255,.7); border: 1px solid rgba(255,255,255,.9); backdrop-filter: blur(8px); color: var(--ink-2); font-size: .9rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .by { margin: 14px 0 0; color: var(--ink-2); font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 500; }
  .stat { margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 6px 14px; color: var(--accent); font-weight: 700; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0 0; }
  .note { margin: 18px 0 0; color: var(--muted); font-size: .95rem; max-width: 34em; }
  .hero-art { display: block; border-radius: var(--r); background: var(--bg); padding: 12px; box-shadow: 0 40px 80px -30px rgba(15,18,34,.45), 0 0 0 1px rgba(15,18,34,.06); transform: perspective(1400px) rotateY(-6deg) rotateX(2deg); transition: transform .6s var(--ease), box-shadow .6s var(--ease); }
  .hero-art:hover { transform: perspective(1400px) rotateY(0deg) rotateX(0deg) translateY(-4px); box-shadow: 0 50px 90px -30px rgba(15,18,34,.5), 0 0 0 1px rgba(15,18,34,.06); }
  .hero-art canvas { display: block; width: 100%; height: auto; border-radius: calc(var(--r) - 8px); background: var(--board); }
  /* 등장 시퀀스: 텍스트가 순서대로, 그림은 마지막에 떠오름 */
  .hero-text > * { animation: rise .8s var(--ease) both; } .hero-text > :nth-child(1) { animation-delay: .05s; } .hero-text > :nth-child(2) { animation-delay: .15s; } .hero-text > :nth-child(3) { animation-delay: .25s; } .hero-text > :nth-child(4) { animation-delay: .32s; } .hero-text > :nth-child(5) { animation-delay: .4s; } .hero-text > :nth-child(6) { animation-delay: .48s; }
  .hero-side { animation: float-in 1s var(--ease) .25s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes float-in { from { opacity: 0; transform: perspective(1400px) rotateY(-14deg) translateY(30px); } to { opacity: 1; transform: perspective(1400px) rotateY(-6deg) rotateX(2deg); } }
  @media (max-width: 900px) { .hero-in { grid-template-columns: 1fr; min-height: 0; padding-top: 28px; } .hero-art { transform: none; } .hero h1 br { display: none; } @keyframes float-in { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } } .hero-art:hover { transform: translateY(-2px); } }

  .streak { margin: 14px 0 0; font-weight: 700; color: var(--gold); }
  .past { padding-top: 28px; } .past-h { font-size: 1.05rem; font-weight: 700; margin: 0 0 12px; color: var(--ink-2); }
  .past-row { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; } .past-row::-webkit-scrollbar { display: none; }
  .past-row :global(.pd) { flex: none; width: 118px; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: var(--bg); color: var(--ink); text-decoration: none; transition: transform .2s var(--ease), box-shadow .2s; } .past-row :global(.pd:hover) { transform: translateY(-3px); box-shadow: 0 14px 26px -16px rgba(15,18,34,.5); text-decoration: none; }
  .past-row :global(.pd img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--board); } .past-row :global(.pd .pd-d) { display: flex; justify-content: space-between; align-items: center; gap: 4px; padding: 6px 8px; font-size: .72rem; font-weight: 700; color: var(--ink-2); } .past-row :global(.pd .ok) { color: var(--accent); } .past-row :global(.pd .no) { color: var(--muted); font-weight: 500; }
  .past-row :global(.pd.today) { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  /* 흐르는 그림 띠 */
  .marq { overflow: hidden; padding: 10px 0 0; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marq-track { display: flex; gap: 14px; width: max-content; animation: marq 70s linear infinite; } .marq:hover .marq-track { animation-play-state: paused; }
  .marq img { width: 150px; height: 112px; object-fit: cover; border-radius: 12px; box-shadow: 0 8px 20px -10px rgba(15,18,34,.4); }
  @keyframes marq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marq-track { animation: none; } }

  .tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; } .none { padding-top: 10px; }
  /* 진열대 */
  .shelf { position: relative; margin-top: clamp(30px, 4vw, 52px); }
  .shelf h3 { display: flex; align-items: baseline; gap: 10px; font-size: 1.2rem; margin: 0; } .shelf h3 small { color: var(--muted); font-weight: 600; font-size: .9rem; }
  .plank { height: 10px; margin: -14px 0 0; border-radius: 6px; background: linear-gradient(180deg, #e9ebf0, #d6dae3); box-shadow: 0 10px 18px -10px rgba(15,18,34,.35); }
  .shelf-grid { --w: 210px; --h: 190px; --d: 44px; padding-top: 22px; }
  .shelf-all { margin-top: 18px; }
  @media (max-width: 640px) { .shelf-grid { --w: clamp(112px, 35vw, 172px); --h: calc(var(--w) * .9); --d: 28px; } }

  /* 내 사진 */
  .photo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: center; padding: clamp(28px, 5vw, 64px); border-radius: calc(var(--r) * 1.4); background: var(--ink); color: #fff; overflow: hidden; position: relative; transition: transform .4s var(--ease), box-shadow .4s var(--ease); }
  .photo:hover { text-decoration: none; transform: translateY(-3px); box-shadow: 0 40px 70px -40px rgba(15,18,34,.8); }
  .photo h2 { font-size: clamp(1.7rem, 3.4vw, 2.6rem); } .photo p { margin: 14px 0 26px; color: #b9bfd6; font-size: 1.08rem; max-width: 32em; }
  .photo-art { position: relative; height: clamp(200px, 26vw, 320px); }
  .ph { position: absolute; border-radius: 16px; background: linear-gradient(135deg, #5f7bff, #b98cff); box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); transition: transform .6s var(--ease); }
  .p1 { left: 8%; top: 14%; width: 44%; height: 62%; transform: rotate(-8deg); background: linear-gradient(135deg, #ffb35a, #ff5f8a); } .p2 { left: 32%; top: 4%; width: 44%; height: 66%; transform: rotate(4deg); background: linear-gradient(135deg, #14172a, #7fd3ff); } .p3 { left: 54%; top: 22%; width: 40%; height: 60%; transform: rotate(12deg); background: linear-gradient(135deg, #8bf1b0, #3ac9a5); }
  .photo:hover .p1 { transform: rotate(-12deg) translateY(-6px); } .photo:hover .p2 { transform: rotate(1deg) translateY(-10px); } .photo:hover .p3 { transform: rotate(16deg) translateY(-4px); }
  .piece { position: absolute; left: 40%; top: 30%; width: 26%; fill: #fff; filter: drop-shadow(0 20px 30px rgba(0,0,0,.5)); animation: bob 4s ease-in-out infinite; } @keyframes bob { 50% { transform: translateY(-10px) rotate(6deg); } }
  @media (max-width: 760px) { .photo { grid-template-columns: 1fr; } .photo-art { order: -1; height: 180px; } }

</style>

<script>
  import { drawPopped } from '../lib/hero';
  import { DAILY_PIECES, todayKST, dailyPick } from '../lib/jigsaw';
  import { DAILY_POOL } from '../data/works';
  import { getStreak, getBest } from '../lib/store';
  import { initFavUI } from '../lib/fav';
  import { UI, type Lang } from '../i18n/ui';
  const hl = document.documentElement.lang, LANG = (hl === 'en' || hl === 'ja' ? hl : 'ko') as Lang, LI = { ko: 0, en: 1, ja: 2 }[LANG], T = UI[LANG];
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  initFavUI();
  const day = todayKST(), pick = dailyPick(day, DAILY_POOL);
  const P = LANG === 'ko' ? '' : `/${LANG}`;
  { const st = getStreak(); if (st > 0) { const el = document.getElementById('hero-streak')!; el.querySelector('span')!.textContent = T.play.streak(st); el.hidden = false; } }
  { const row = document.getElementById('past-row')!; for (let i = 0; i < 7; i++) { const d = new Date(Date.now() + 9 * 3600e3 - i * 86400e3).toISOString().slice(0, 10); const pk = dailyPick(d, DAILY_POOL); const done = getBest(`daily:${d}`) !== null; const a = document.createElement('a'); a.className = 'pd' + (i === 0 ? ' today' : ''); a.href = `${P}/board/?daily=${i === 0 ? '1' : d}`; a.title = pk.painting.title[LI]; a.innerHTML = `<img src="/jigsaw/t-${pk.painting.key}.webp" alt="" loading="lazy" width="240" height="190"><span class="pd-d"><span>${i === 0 ? T.play.today : d.slice(5).replace('-', '.')}</span><span class="${done ? 'ok' : 'no'}">${done ? '✓ ' + T.play.done : T.play.notYet}</span></span>`; row.appendChild(a); } }
  { const a = document.getElementById('hero-today') as HTMLAnchorElement; a.firstChild!.textContent = T.hero.todayLink(pick.painting.title[LI]); }
  (document.getElementById('glow-img') as HTMLImageElement).src = `/jigsaw/t-${pick.painting.key}.webp`;
  drawPopped(document.getElementById('hero-cv') as HTMLCanvasElement, `/jigsaw/${pick.painting.key}.webp`, pick.seed, DAILY_PIECES, 5);
  const countUp = (el: HTMLElement, to: number) => { const t0 = performance.now(), dur = 1100, from = 0; const f = (t: number) => { const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3); el.textContent = Math.round(from + (to - from) * e).toLocaleString(); if (k < 1) requestAnimationFrame(f); }; requestAnimationFrame(f); };
  document.querySelectorAll<HTMLElement>('.nums b[data-n]').forEach((b) => { if (!b.closest('[hidden]')) countUp(b, Number(b.dataset.n)); });
  fetch('/api/stats').then((r) => r.json<any>()).then((d) => { if (d.solved > 0) { const w = document.getElementById('num-solved')!; w.hidden = false; countUp(w.querySelector('b')!, d.solved); } }).catch(() => {});
</script>
