---
// 랜딩 홈: 오늘의 퍼즐(조각 빠진 그림) → 하는 법 → 퍼즐 상자 진열대 → 내 사진 → 오늘의 랭킹 → 가이드
import Box from './Box.astro';
import { UI, LI, prefix, type Lang } from '../i18n/ui';
import { JIGSAW } from '../i18n/jigsaw';
import { PAINTINGS, DAILY_PIECES, todayKST, dailyPick } from '../lib/jigsaw';
import { shelvesFor } from '../lib/catalogView';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], li = LI[lang], P = prefix(lang);
const day = todayKST(), daily = dailyPick(day, PAINTINGS), shelves = shelvesFor(lang), total = PAINTINGS.length;
---
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-text">
      <p class="today">{T.hero.today} · {day.replace(/-/g, '.')}</p>
      <h1 class="serif" id="hero-title">{daily.painting.title[li]}</h1>
      <p class="by" id="hero-by">{daily.painting.artist[li]} · {daily.painting.year} · {T.hero.pieces(DAILY_PIECES)}</p>
      <p class="stat"><span id="hero-solved">{T.hero.solved(0)}</span><span id="hero-fast" hidden></span></p>
      <div class="cta"><a class="btn primary lg" id="hero-cta" href={`${P}/play/?daily=1`}>{T.hero.cta}</a><a class="btn lg" href={`${P}/play/?photo=1`}>{T.hero.photo}</a></div>
      <p class="note">{T.hero.sameForAll}</p>
    </div>
    <a class="hero-art" id="hero-art" href={`${P}/play/?daily=1`} aria-label={T.hero.cta} data-key={daily.painting.key} data-seed={daily.seed}>
      <canvas id="hero-cv" width="720" height="560"></canvas>
    </a>
  </div>
</section>

<section class="sec how">
  <div class="wrap">
    <h2 class="sec-h">{T.how.title}</h2>
    <ol class="steps">{T.how.steps.map(([h, b], i) => <li><span class="n">{i + 1}</span><div><b>{h}</b><p>{b}</p></div></li>)}</ol>
  </div>
</section>

<section class="sec" id="catalog">
  <div class="wrap">
    <h2 class="sec-h">{T.catalog.title} <span class="cnt">{T.catalog.all(total)}</span></h2>
    <p class="sec-sub">{T.catalog.sub}</p>
    {shelves.map((sh) => <div class="shelf"><h3>{sh.name}<span class="muted">{sh.items.length}</span></h3><div class="boxes">{sh.items.map((p) => <Box p={p} href={`${P}/puzzle/${p.key}/`} />)}</div></div>)}
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <a class="photo-card" href={`${P}/play/?photo=1`}>
      <div class="photo-ic" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="8.5" cy="10" r="1.6"/><path d="m21 15-4.8-4.8a1.5 1.5 0 0 0-2.1 0L6 18"/></svg></div>
      <div><h2 class="serif">{T.photo.title}</h2><p>{T.photo.body}</p><span class="btn primary">{T.photo.cta}</span></div>
    </a>
  </div>
</section>

<section class="sec" id="rank">
  <div class="wrap rank-in">
    <div>
      <h2 class="sec-h">{T.rank.title}</h2>
      <p class="sec-sub">{T.rank.sub}</p>
      <p class="muted" id="rank-total"></p>
      <a class="btn primary" href={`${P}/play/?daily=1`}>{T.rank.more}</a>
    </div>
    <div class="card"><ol class="lb" id="rank-list"><li class="empty">…</li></ol></div>
  </div>
</section>

<section class="sec">
  <div class="wrap"><h2 class="sec-h">{T.guide}</h2><article class="seo" set:html={JIGSAW[lang].seo} /></div>
</section>

<style>
  .hero { background: linear-gradient(180deg, var(--white) 0%, var(--paper) 100%); border-bottom: 1px solid var(--line-soft); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 40px; align-items: center; padding-top: 48px; padding-bottom: 56px; }
  .today { margin: 0 0 10px; color: var(--muted); font-size: .95rem; font-variant-numeric: tabular-nums; }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.12; }
  .by { margin: 10px 0 0; color: var(--ink-2); font-size: 1.05rem; }
  .stat { margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px 14px; color: var(--accent); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 0; }
  .note { margin: 16px 0 0; color: var(--muted); font-size: .92rem; max-width: 34em; }
  .hero-art { display: block; border-radius: 6px; background: var(--white); padding: 10px; box-shadow: 0 30px 50px -30px rgba(20,23,42,.55), 0 2px 0 rgba(255,255,255,.9) inset, 0 0 0 1px var(--line-soft); transform: rotate(-1.2deg); transition: transform .25s ease; }
  .hero-art:hover { transform: rotate(0deg) translateY(-2px); }
  .hero-art canvas { display: block; width: 100%; height: auto; background: var(--board); }
  @media (max-width: 860px) { .hero-in { grid-template-columns: 1fr; gap: 28px; padding-top: 28px; padding-bottom: 40px; } .hero-art { transform: none; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps li { display: flex; gap: 14px; } .steps .n { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: #fff; font-weight: 700; font-family: var(--serif); }
  .steps b { display: block; font-size: 1.05rem; margin: 5px 0 4px; } .steps p { margin: 0; color: var(--ink-2); font-size: .95rem; }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; gap: 16px; } }

  .cnt { font-family: var(--sans); font-weight: 400; font-size: .95rem; color: var(--muted); margin-left: 8px; }
  .shelf { margin: 0 0 30px; padding: 0 0 26px; border-bottom: 1px solid var(--line-soft); } .shelf:last-child { border: 0; }
  .shelf h3 { display: flex; align-items: baseline; gap: 8px; font-size: 1.05rem; font-weight: 600; margin: 0 0 14px; } .shelf h3 .muted { font-weight: 400; font-size: .88rem; }

  .photo-card { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; padding: 28px; border: 1.5px dashed var(--line); border-radius: 22px; background: var(--white); color: var(--ink); }
  .photo-card:hover { text-decoration: none; border-color: var(--accent); background: #fbfcff; }
  .photo-ic { width: 72px; height: 72px; border-radius: 18px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .photo-card h2 { font-size: 1.4rem; margin: 0 0 6px; } .photo-card p { margin: 0 0 14px; color: var(--ink-2); max-width: 46em; }
  @media (max-width: 560px) { .photo-card { grid-template-columns: 1fr; padding: 22px; } }

  .rank-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px; align-items: start; }
  .rank-in .btn { margin-top: 8px; }
  @media (max-width: 760px) { .rank-in { grid-template-columns: 1fr; gap: 18px; } }
</style>

<script>
  import { drawPopped } from '../lib/hero';
  import { PAINTINGS, DAILY_PIECES, todayKST, dailyPick } from '../lib/jigsaw';
  import { UI, type Lang } from '../i18n/ui';
  const hl = document.documentElement.lang, LANG = (hl === 'en' || hl === 'ja' ? hl : 'ko') as Lang, LI = { ko: 0, en: 1, ja: 2 }[LANG], T = UI[LANG];
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  // 방문 시각 기준으로 오늘의 그림을 다시 계산 (빌드 시각과 다를 수 있음)
  const day = todayKST(), pick = dailyPick(day, PAINTINGS);
  document.getElementById('hero-title')!.textContent = pick.painting.title[LI];
  document.getElementById('hero-by')!.textContent = `${pick.painting.artist[LI]} · ${pick.painting.year} · ${T.hero.pieces(DAILY_PIECES)}`;
  drawPopped(document.getElementById('hero-cv') as HTMLCanvasElement, `/jigsaw/${pick.painting.key}.jpg`, pick.seed, DAILY_PIECES, 5);
  (async () => {
    try {
      const r = await fetch('/api/daily', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'ranking' }) }); const rk = await r.json();
      document.getElementById('hero-solved')!.textContent = T.hero.solved(rk.total);
      if (rk.rows[0]) { const f = document.getElementById('hero-fast')!; f.textContent = T.hero.fastest(fmt(rk.rows[0].ms / 1000)); f.hidden = false; }
      document.getElementById('rank-total')!.textContent = rk.total ? T.rank.total(rk.total) : '';
      const ol = document.getElementById('rank-list')!; ol.innerHTML = '';
      if (!rk.rows.length) { ol.innerHTML = `<li class="empty">${T.rank.empty}</li>`; return; }
      for (const [i, row] of (rk.rows as any[]).slice(0, 10).entries()) { const li = document.createElement('li'); const a = document.createElement('span'); a.className = 'rank'; a.textContent = String(i + 1); const b = document.createElement('span'); b.className = 'nick'; b.textContent = row.nick; const c = document.createElement('span'); c.className = 'score'; c.innerHTML = `${fmt(row.ms / 1000)}<small> · ${Number(row.tries)}</small>`; li.append(a, b, c); ol.appendChild(li); }
    } catch { document.getElementById('rank-list')!.innerHTML = `<li class="empty">${T.rank.fail}</li>`; }
  })();
</script>
