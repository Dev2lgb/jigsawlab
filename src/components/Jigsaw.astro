    complete = true; if (hasIDB() && src && !room) { saves.del(saveId()).catch(() => {}); dropRemote(saveId()); if (src.kind === 'photo' && src.photoId) images.del(src.photoId).catch(() => {}); } tray.hidden = true; $('jg-hint').hidden = true; $('jg-edge').hidden = true; showHint = false; $('jg-hint').setAttribute('aria-pressed', 'false');
    requestAnimationFrame(() => { resize(); fit(); });
    const t1 = performance.now(); const fade = () => { completeAlpha = Math.min(1, (performance.now() - t1) / 900); draw(); if (completeAlpha < 1) requestAnimationFrame(fade); }; requestAnimationFrame(fade);
    navigator.vibrate?.([10, 40, 20]); prepareResult(sec);
    celebrate(() => scenes.go('result'));
  }
  function prepareResult(sec: number) {
    $('jg-res-time').textContent = fmt(sec); $('jg-res-n').textContent = String(total); $('jg-res-m').textContent = String(moves); $('jg-res-name').textContent = src!.name;
    const key = bestKey(total); const isBest = saveBest(key, sec, 'asc'); const b = getBest(key); $('jg-res-best').textContent = isBest ? T.newBest : b ? T.best(fmt(b)) : '';
    if (src!.kind === 'daily') bumpStreak(src!.day!);
    fetch('/api/stats', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'solved' }), keepalive: true }).catch(() => {});
    { const entry = { key: src!.kind === 'photo' ? (src!.photoId ?? 'photo') : src!.key, kind: src!.kind, name: src!.name, n: total, sec, moves, day: src!.day, at: Date.now() }; addDone(entry); syncDone(entry); }
    const sb = document.querySelector<HTMLButtonElement>('.share-btn')!; const pTitle = src!.kind !== 'photo' ? WORKS.find((x) => x.key === src!.key)!.title[LI] : '';
    sb.dataset.title = src!.kind === 'daily' ? T.shareDaily(total, fmt(sec), pTitle) : T.shareTitle(total, fmt(sec)); sb.dataset.text = T.shareText;
    const Pfx = LANG === 'ko' ? '' : `/${LANG}`; sb.dataset.url = src!.kind === 'photo' ? `${location.origin}${Pfx}/photo/` : `${location.origin}${Pfx}/s/?k=${src!.key}&n=${total}&t=${sec}&m=${moves}${src!.kind === 'daily' ? '&d=1' : ''}`;
    const rc = $('jg-res-img') as HTMLCanvasElement; const k = Math.min(1200 / cut.W, 900 / cut.H, 1); rc.width = Math.round(cut.W * k); rc.height = Math.round(cut.H * k); rc.getContext('2d')!.drawImage(img!, 0, 0, rc.width, rc.height);
  }
  document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((b) => b.addEventListener('click', async () => { const r = await share({ title: b.dataset.title!, text: b.dataset.text, url: b.dataset.url || undefined }); const I = (window as any).__i18n; if (r === 'copied') toast(I.copied); else if (r === 'failed') toast(I.shareFail); }));
  // 테스트·썸네일용: 트레이 앞 n개를 제자리에 놓음
  (window as any).__jigsaw = { demo: (n: number) => { for (const p of order.filter((q) => !q.locked && !q.g).slice(0, n)) { p.el?.remove(); lockGroup(makeGroup(p, 0, 0)); } }, state: () => ({ total, lockedN, moves, board: groups.length, tray: tray.children.length, loose: groups.flatMap((g) => g.pieces.map((p) => ({ r: p.r, c: p.c, x: px(p), y: py(p), g: g.id }))), groups: groups.map((g) => g.pieces.length), pw: cut.pw, ph: cut.ph, view: { ...view } }) };
  tray.addEventListener('wheel', (e) => { if (tray.scrollWidth > tray.clientWidth && Math.abs(e.deltaY) > Math.abs(e.deltaX)) { e.preventDefault(); tray.scrollLeft += e.deltaY; } }, { passive: false });
  // ── 부팅 2단계: 한 진입점. URL 이 첫 화면을 정한다 (1단계는 head 의 PlayBoot — 같은 규칙으로 첫 페인트 전에 로딩 화면을 띄워 둔다)
  //   ?room=<id> 방 참가 · ?resume=<id> 하던 퍼즐 · ?daily=1|YYYY-MM-DD 오늘의 퍼즐(과거 판 가능) · ?k=<key>&n=<조각> 그림 · ?photo=<id>&n=<조각> /photo/ 에서 고른 사진 · 없음 → /play/ 로
  //   그림·오늘의 퍼즐·이어하기는 로딩 화면(썸네일·이름) → 판. 실패하면 로딩 화면을 걷고 선택 화면으로
  async function boot() {
    const q = new URLSearchParams(location.search); const k = q.get('k'), pn = Number(q.get('n')), pt = WORKS.find((x) => x.key === k);
    const clean = () => history.replaceState(null, '', location.pathname);
    const bail = (msg?: string) => { fullLoad(false); goPick(msg); };
    if (q.get('room')) return joinRoom(q.get('room')!.toLowerCase());
    if (q.get('resume')) {
      const id = q.get('resume')!; clean(); fullLoad(true, T.opening);
      let sv: SaveData | null = null; try { sv = (await saves.get(id)) ?? null; } catch {}
      if (!sv) { await remoteReady; if (remoteSaves.some((m) => m.id === id)) sv = await fetchSave(id); }
      if (!sv) return bail(T.saveGone);
      fullLoad(true, T.opening, { img: sv.thumb, name: sv.name }); await resumeSave(sv); if (!img) bail(); return;
    }
    if (q.get('photo')) {
      const ph = q.get('photo')!;
      // /photo/ 에서 고른 사진 — 파일은 URL 로 못 넘기니 IndexedDB 에 임시로 담아 두고 id 만 넘어온다
      if (ph !== '1') {
        clean(); let blob: Blob | undefined;
        if (hasIDB()) { try { blob = await images.get(ph); } catch {} }
        if (!blob) return bail(T.imgFail);
        images.del(ph).catch(() => {});
        // n 이 함께 오면(=/photo/ 에서 조각 수까지 정하고 온 것) 다이얼로그 없이 바로 판을 편다
        const auto = pn >= 6 && pn <= 2000; if (auto) wantN = pn;
        const together = auto && q.get('together') === '1'; // /photo/ 에서 '친구랑 같이' 로 온 경우
        fullLoad(true, T.loading);
        await loadSource({ kind: 'photo', key: 'photo', name: T.myPhoto, file: new File([blob], 'photo', { type: blob.type || 'image/jpeg' }) }, auto && !together);
        if (!img) return bail(); // loadSource 가 실패하면 이미 토스트를 띄운다
        // 사진 방은 판이 있어야 만들 수 있다(조각 상태를 함께 올린다). 판을 먼저 펴고 방 만들기를 누른다
        if (together) { await start(); $('jg-tosolo-invite').click(); return; }
        if (!auto) fullLoad(false); // auto 면 start() 가 화면을 넘긴다
        return;
      }
      location.replace(`${PFX}/photo/`); return; // 사진 고르기는 /photo/ 가 맡는다
    }
    if (q.get('daily') || (pt && q.get('d') === '1')) {
      const dq = q.get('daily') ?? '1'; const dd = /^\d{4}-\d{2}-\d{2}$/.test(dq) && dq <= day ? dq : day; const pk = dd === day ? pick : dailyPick(dd, DAILY_POOL);
      const name = `${T.daily} ${dd === day ? '' : dd.replace(/-/g, '.')} · ${pk.painting.title[LI]}`.replace('  ', ' ');
      clean(); fullLoad(true, T.opening, { img: `/jigsaw/t-${pk.painting.key}.webp`, name });
      await loadSource({ kind: 'daily', key: pk.painting.key, name, url: `/jigsaw/${pk.painting.key}.webp`, seed: pk.seed, day: dd, fixedN: DAILY_PIECES }, true); if (!img) bail(); return;
    }
    if (pt) {
      if (pn >= 6 && pn <= 2000) wantN = pn; const name = T.paintingBy(pt.title[LI], pt.artist[LI], pt.year);
      clean(); fullLoad(true, T.opening, { img: `/jigsaw/t-${pt.key}.webp`, name });
      await loadSource({ kind: 'gallery', key: pt.key, name, url: `/jigsaw/${pt.key}.webp` }, true); if (!img) bail(); return;
    }
    if (k) return bail(T.imgFail); // 모르는 key
    goPick(); // 쿼리가 없으면 열 판이 없다
  }
  boot();
  $('jg-start').addEventListener('click', () => start());
  $('jg-retry').addEventListener('click', () => start());
</script>
