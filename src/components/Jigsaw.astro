---
// 판(/board/) — 쿼리가 가리키는 퍼즐을 열어 플레이(캔버스 보드 + 트레이) → 완성 감상 → 결과.
// 고르는 화면은 Picker.astro(/play/), 사진 만들기는 Photo.astro(/photo/) 가 맡는다
import { JIGSAW } from '../i18n/jigsaw';
import { UI, LI, prefix, type Lang } from '../i18n/ui';
import { DAILY_PIECES, todayKST, dailyPick } from '../lib/jigsaw';
import { DAILY_POOL } from '../data/works';
import { icon } from '../lib/icons';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const t = JIGSAW[lang], li = LI[lang], P = prefix(lang), U = UI[lang];
const PRESETS = [48, 100, 200, 300, 500, 1000];
const day = todayKST(), daily = dailyPick(day, DAILY_POOL);
---
<!-- 로딩 화면 — 첫 페인트 전에 head 의 PlayBoot 가 html[data-boot] 로 먼저 띄우고(썸네일은 --boot-art), 엔진의 boot() 가 이어받는다 -->
<div class="fullload" id="jg-fullload" role="status"><span class="fl-art" aria-hidden="true"></span><b class="fl-name" id="jg-fullload-name"></b><span class="spin"></span><p id="jg-fullload-txt"><span class="fl-t-open">{t.opening}</span><span class="fl-t-room">{U.play.joining}</span></p></div>
  <div class="modal" id="jg-gate" hidden>
    <div class="modal-bg"></div>
    <div class="dialog gate" role="dialog" aria-modal="true" aria-labelledby="jg-gate-h">
      <p class="gate-k">{U.play.gate.kicker}</p>
      <div class="chosen"><img id="jg-gate-img" alt="" /><div><b id="jg-gate-h"></b><span class="grid-lbl" id="jg-gate-sub"></span></div></div>
      <button type="button" class="btn primary lg gate-login" id="jg-gate-login"><Fragment set:html={icon('user', 18)} /><span>{U.play.gate.login}</span></button>
      <p class="muted gate-sub">{U.play.gate.loginSub}</p>
      <p class="gate-or"><span>{U.play.gate.or}</span></p>
      <form class="gate-guest" id="jg-gate-form"><input class="input" id="jg-gate-nick" maxlength="12" placeholder={U.play.gate.nickPh} autocomplete="nickname" /><button type="submit" class="btn lg">{U.play.gate.guest}</button></form>
      <p class="muted gate-sub">{U.play.gate.guestSub}</p>
    </div>
  </div>
<div class="modal" id="jg-setup" hidden>
  <div class="modal-bg" id="jg-modal-bg"></div>
  <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="jg-chosen-name">
    <button type="button" class="close" id="jg-close" aria-label={t.toTitle}>✕</button>
    <div class="chosen"><img id="jg-thumb" alt="" /><div><b id="jg-chosen-name">{t.chosen}</b><span class="grid-lbl" id="jg-grid"></span></div></div>
    <p class="lbl">{t.pieces}</p>
    <div class="pieces">{PRESETS.map((n) => <button type="button" data-n={n} class:list={[{ on: n === 48 }]}>{n}</button>)}<input class="input custom" id="jg-custom" type="number" min="6" max="2000" placeholder={t.custom} /></div>
    <p class="muted note-solo"><Fragment set:html={icon('users', 14)} /> {U.play.photoSolo}</p>
    <div class="row"><button class="btn primary" id="jg-start">{t.start}</button></div>
  </div>
</div>

<section class="scene play" data-scene="play">
  <div class="play-wrap">
    <div class="hud">
      <span class="chip"><Fragment set:html={icon('clock', 14)} /> <b id="jg-time">0:00</b></span>
      <span class="chip" id="jg-left"></span>
      <span class="hud-name muted" id="jg-hud-name"></span>
      <button type="button" class="tb" id="jg-tosolo-invite" hidden><Fragment set:html={icon('users', 15)} /><span>{U.play.together}</span></button>
      <span class="roombar" id="jg-roombar" hidden><button type="button" class="tb" id="jg-players-btn" title={U.play.players}><Fragment set:html={icon('user', 15)} /><b id="jg-pcount">1</b></button><button type="button" class="tb" id="jg-invite"><Fragment set:html={icon('user-plus', 15)} /><span>{U.play.invite}</span></button></span>
      <span class="sp"></span>
      <button type="button" class="ib" id="jg-hint" title={t.hint} aria-pressed="false"><Fragment set:html={icon('eye', 18)} /></button>
      <button type="button" class="ib" id="jg-edge" title={t.edgeOnly} aria-pressed="false"><Fragment set:html={icon('edge', 18)} /></button>
      <button type="button" class="ib" id="jg-outline" title={U.play.outline} aria-pressed="false"><Fragment set:html={icon('grid', 18)} /></button>
      <button type="button" class="ib" id="jg-cloud" title={U.play.cloudSave} hidden><Fragment set:html={icon('cloud', 18)} /></button>
      <button type="button" class="ib" id="jg-restart" title={U.play.startOver}><Fragment set:html={icon('rotate', 18)} /></button>
      <button type="button" class="ib" id="jg-quit" title={t.toTitle}><Fragment set:html={icon('x', 18)} /></button>
    </div>
    <div class="progress" aria-hidden="true"><i id="jg-prog"></i></div>
    <div class="boardwrap" id="jg-boardwrap"><canvas id="jg-board"></canvas><p class="loading muted" id="jg-loading">{t.loading}</p>
      <canvas class="fx" id="jg-fx"></canvas>
    </div>
    <div class="tray-bar" id="jg-traybar"><div class="piles" id="jg-piles"></div><span class="sp"></span><button type="button" class="tb" id="jg-sort" title={U.play.sortColor}><Fragment set:html={icon('palette', 15)} /><span>{U.play.sortColor}</span></button><button type="button" class="tb" id="jg-shuffle" title={U.play.shuffle}><Fragment set:html={icon('shuffle', 15)} /></button></div>
    <div class="tray" id="jg-tray" aria-label={t.trayHint}></div>
    <div class="pilepick" id="jg-pilepick" hidden><p class="pp-h">{U.play.moveTo}</p><div class="pp-list" id="jg-pilepick-list"></div></div>
    <div class="modal" id="jg-pldlg" hidden>
      <div class="modal-bg" id="jg-pldlg-bg"></div>
      <div class="dialog pldlg" role="dialog" aria-modal="true" aria-labelledby="jg-pldlg-h">
        <button type="button" class="close" id="jg-pldlg-close" aria-label={t.toTitle}>✕</button>
        <h3 id="jg-pldlg-h">{U.play.players} <span class="muted" id="jg-pldlg-n"></span></h3>
        <p class="pl-lead" id="jg-pldlg-lead" hidden>{U.play.inviteLead}</p>
        <ul class="pl-list" id="jg-players"></ul>
        <div class="row"><button type="button" class="btn primary" id="jg-invite2"><Fragment set:html={icon('user-plus', 16)} /><span>{U.play.invite}</span></button></div>
      </div>
    </div>
  </div>
</section>

<section class="scene page result" data-scene="result">
  <div class="res-wrap">
    <div class="res-art"><canvas id="jg-res-img" width="320" height="240"></canvas><span class="stamp">{t.done}</span></div>
    <div class="res-info">
      <p class="res-kicker">{t.done}</p>
      <h2 class="res-title" id="jg-res-name"></h2>
      <div class="res-stats"><div><b id="jg-res-time">0:00</b><small>{t.resTime}</small></div><div><b id="jg-res-n">0</b><small>{t.resPieces}</small></div><div><b id="jg-res-m">0</b><small>{t.resMoves}</small></div></div>
      <p class="best-line" id="jg-res-best"></p>
      <div class="row">
        <button class="btn primary" id="jg-retry">{t.retry}</button>
        <button class="btn share-btn" data-title="" data-text="">{t.share}</button>
        <a class="btn" href={`${P}/play/`}>{t.another}</a>
        <a class="btn ghost" href={`${P}/`}>{U.foot.toHome}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* 방 들어가는 중 — 전체 화면 로더 */
  .fullload { display: none; position: fixed; inset: 0; z-index: 200; background: var(--bg); flex-direction: column; align-items: center; justify-content: center; gap: 18px; color: var(--muted); }
  :global(html[data-boot]) .fullload, .fullload.on { display: flex; }
  .fl-art { display: none; width: min(240px, 62vw); aspect-ratio: 4 / 3; border-radius: 14px; background: var(--boot-art) center / cover no-repeat, var(--line); box-shadow: 0 18px 40px rgba(15, 18, 34, .16); }
  :global(html[data-boot-art]) .fl-art { display: block; }
  .fl-name { display: none; max-width: min(560px, 86vw); padding: 0 16px; text-align: center; color: var(--ink); font-weight: 700; line-height: 1.4; } .fl-name.on { display: block; }
  .fl-t-room { display: none; } :global(html[data-boot="room"]) .fl-t-open { display: none; } :global(html[data-boot="room"]) .fl-t-room { display: inline; }
  .spin { width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--ink); animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin { animation-duration: 2s; } }
  /* 조각 수 다이얼로그 — 내 사진 조각 수 고를 때만 */
  .modal { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .modal-bg { position: absolute; inset: 0; background: rgba(23,26,36,.45); }
  .dialog { position: relative; width: min(92vw, 420px); max-height: 92%; overflow: auto; padding: 20px; background: var(--bg); border-radius: 18px; box-shadow: 0 20px 60px rgba(23,26,36,.25); animation: pop .16s ease-out; }
  @keyframes pop { from { transform: scale(.96); opacity: 0; } to { transform: none; opacity: 1; } }
  .close { position: absolute; top: 10px; right: 10px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); cursor: pointer; }
  .chosen { display: flex; align-items: center; gap: 12px; margin: 0 32px 4px 0; } .chosen img { width: 72px; height: 72px; object-fit: cover; border-radius: 10px; background: var(--board); flex: none; } .chosen div { display: flex; flex-direction: column; } .grid-lbl { color: var(--accent); font-weight: 600; }
  .lbl { color: var(--muted); font-size: .85rem; font-weight: 600; margin: 14px 0 6px; }
  .pieces { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .pieces button { border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--ink); font-weight: 600; padding: 6px 13px; cursor: pointer; } .pieces button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .custom { width: 96px; min-height: 36px; padding: 4px 10px; }
  .row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin: 16px 0 0; }
  .best { text-align: center; margin: 10px 0 0; min-height: 1.3em; font-size: .9rem; }

  /* 플레이 */
  .play-wrap { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .hud { display: flex; align-items: center; gap: 6px; padding: 8px 10px; flex: none; background: var(--bg-2); border-bottom: 1px solid var(--line-soft); } .sp { flex: 1; }
  .hud .chip { white-space: nowrap; } .hud .chip b { font-variant-numeric: tabular-nums; }
  .roombar { display: inline-flex; align-items: center; gap: 6px; margin-left: 8px; }
  #jg-players-btn, #jg-invite, #jg-tosolo-invite { display: inline-flex; align-items: center; gap: 5px; } #jg-players-btn b { font-variant-numeric: tabular-nums; }
  :global(.ico) { flex: none; display: block; } .hud .chip { display: inline-flex; align-items: center; gap: 4px; } #jg-sort, #jg-shuffle { display: inline-flex; align-items: center; gap: 5px; }
  .gate .gate-k { margin: 0 0 10px; font-size: .8rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .gate .chosen { margin-bottom: 18px; } .gate .gate-login { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; } .gate .gate-sub { margin: 8px 0 0; font-size: .8rem; line-height: 1.5; }
  .gate .gate-or { display: flex; align-items: center; gap: 12px; margin: 16px 0; color: var(--muted); font-size: .8rem; } .gate .gate-or::before, .gate .gate-or::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .gate .gate-guest { display: flex; gap: 8px; } .gate .gate-guest .input { flex: 1; min-width: 0; } .gate .gate-guest .btn { flex: none; }
  .gate[data-noauth="1"] .gate-login, .gate[data-noauth="1"] .gate-login + .gate-sub, .gate[data-noauth="1"] .gate-or { display: none; }
  .note-solo { display: flex; align-items: center; gap: 6px; margin: 12px 0 0; font-size: .82rem; }
  .pl-lead { margin: -4px 0 12px; color: var(--ink-2); font-size: .9rem; line-height: 1.5; }
  .pldlg h3 { margin: 0 0 12px; font-size: 1.05rem; } .pldlg h3 .muted { font-weight: 600; font-size: .9rem; }
  .pl-list { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .pl-list :global(li) { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; background: var(--bg-2); font-weight: 700; font-size: .92rem; }
  .pl-list :global(li i) { width: 12px; height: 12px; border-radius: 50%; flex: none; } .pl-list :global(li b) { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
  .pl-list :global(li .rn) { flex: none; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); font-size: .75rem; font-weight: 600; cursor: pointer; }
  .pldlg .row { display: flex; justify-content: flex-end; } .pldlg .btn { display: inline-flex; align-items: center; gap: 6px; }
  @media (max-width: 640px) { .roombar { margin-left: 0; gap: 4px; } #jg-invite, #jg-tosolo-invite, #jg-players-btn { height: 32px; padding: 0 9px; border-radius: 10px; font-size: .9rem; } #jg-invite :global(span), #jg-tosolo-invite :global(span) { display: none; } #jg-invite, #jg-tosolo-invite { width: 32px; padding: 0; justify-content: center; } .hud { flex-wrap: nowrap; overflow: hidden; gap: 4px; } }
  .hud-name { font-size: .85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; margin-left: 4px; } @media (max-width: 640px) { .hud-name { display: none; } .hud .chip:nth-child(2) { display: none; } }
  .progress { height: 3px; background: var(--line-soft); flex: none; } .progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .25s ease; }
  @media (max-width: 480px) { .hud { gap: 4px; padding: 6px 8px; } .hud .chip { font-size: .78rem; padding: 3px 8px; } .ib { width: 32px; height: 32px; } }
  .ib { width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font-size: 1rem; cursor: pointer; display: grid; place-items: center; } .ib[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .boardwrap { position: relative; flex: 1; min-height: 0; background: var(--board); background-image: radial-gradient(rgba(23,26,36,.09) 1px, transparent 1px); background-size: 22px 22px; }
  .boardwrap canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; } .boardwrap canvas.drag { cursor: grabbing; }
  .loading { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); margin: 0; pointer-events: none; }
  .done { position: absolute; left: 50%; top: 12px; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 16px; border-radius: 999px; background: var(--bg); border: 1px solid var(--gold); box-shadow: 0 8px 24px rgba(233,168,32,.25); white-space: nowrap; z-index: 3; font-weight: 600; }
  .done b { font-variant-numeric: tabular-nums; color: var(--accent); }
  .tray-bar { flex: none; display: flex; align-items: center; gap: 6px; padding: 6px 10px 0; background: var(--bg-2); border-top: 1px solid var(--line); }
  .piles { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; } .piles::-webkit-scrollbar { display: none; }
  .piles :global(.pile-tab) { flex: none; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); font-size: .78rem; font-weight: 700; color: var(--ink-2); cursor: pointer; white-space: nowrap; font-family: inherit; transition: transform .15s var(--ease); } .piles :global(.pile-tab[aria-pressed="true"]) { background: var(--ink); color: #fff; border-color: var(--ink); } .piles :global(.pile-tab.over) { background: var(--accent); color: #fff; border-color: var(--accent); transform: scale(1.08); } .piles :global(.pile-tab small) { opacity: .7; font-weight: 500; margin-left: 4px; }
  .pilepick { position: fixed; z-index: 12; left: 50%; transform: translateX(-50%); width: min(92vw, 420px); padding: 14px; border-radius: 18px; background: var(--bg); box-shadow: 0 24px 60px -20px rgba(15,18,34,.55), 0 0 0 1px var(--line); animation: pp .18s var(--ease); } @keyframes pp { from { opacity: 0; transform: translate(-50%, 8px); } to { opacity: 1; transform: translate(-50%, 0); } }
  .pp-h { margin: 0 0 10px; font-size: .85rem; font-weight: 700; color: var(--muted); } .pp-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .pp-list :global(button) { padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); font: inherit; font-weight: 700; cursor: pointer; } .pp-list :global(button[aria-pressed="true"]) { background: var(--ink); color: #fff; border-color: var(--ink); } .pp-list :global(button.new) { border-style: dashed; color: var(--muted); }
  .tb { flex: none; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); font-size: .78rem; font-weight: 600; cursor: pointer; }
  .tray { flex: none; height: 104px; display: flex; gap: 8px; align-items: center; padding: 8px 10px; overflow-x: auto; overflow-y: hidden; background: var(--bg-2); touch-action: pan-x; scrollbar-width: thin; }
  .tray :global(.tp) { flex: none; width: 80px; height: 80px; border-radius: 10px; background: var(--bg); border: 1px solid var(--line-soft); display: grid; place-items: center; cursor: grab; touch-action: pan-x; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  .tray :global(.tp canvas) { max-width: 72px; max-height: 72px; pointer-events: none; filter: drop-shadow(0 2px 3px rgba(23,26,36,.3)); }
  .tray :global(.tp.lift) { visibility: hidden; }

  /* 완성 연출 */
  .fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 4; }
  /* 결과 */
  .result { padding-top: clamp(24px, 4vw, 48px); }
  .res-wrap { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 860px) { .res-wrap { grid-template-columns: 1fr; gap: 26px; } }
  .res-art { position: relative; animation: art-in .9s var(--ease) both; } .res-art canvas { display: block; width: 100%; height: auto; border-radius: 18px; box-shadow: 0 40px 80px -30px rgba(15,18,34,.55), 0 0 0 1px rgba(15,18,34,.06); background: var(--board); }
  .stamp { position: absolute; right: -6px; top: -14px; padding: 8px 16px; border-radius: 999px; background: var(--gold); color: #fff; font-weight: 800; font-size: 1rem; transform: rotate(6deg); box-shadow: 0 10px 24px -10px rgba(240,167,27,.8); animation: stamp-in .5s var(--ease) .5s both; }
  @keyframes art-in { from { opacity: 0; transform: scale(.94) translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes stamp-in { from { opacity: 0; transform: rotate(6deg) scale(1.6); } to { opacity: 1; transform: rotate(6deg) scale(1); } }
  .res-info > * { animation: rise .7s var(--ease) both; } .res-info > :nth-child(2) { animation-delay: .08s; } .res-info > :nth-child(3) { animation-delay: .16s; } .res-info > :nth-child(4) { animation-delay: .22s; } .res-info > :nth-child(5) { animation-delay: .3s; } .res-info > :nth-child(6) { animation-delay: .36s; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .res-kicker { margin: 0 0 6px; color: var(--accent); font-weight: 800; font-size: 1.05rem; }
  .res-title { font-size: clamp(1.7rem, 3.6vw, 2.8rem); letter-spacing: -.04em; margin: 0 0 18px; }
  .res-stats { display: flex; gap: clamp(18px, 3vw, 40px); padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); } .res-stats div { display: flex; flex-direction: column; } .res-stats b { font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 800; letter-spacing: -.03em; font-variant-numeric: tabular-nums; line-height: 1.1; } .res-stats small { color: var(--muted); font-size: .85rem; font-weight: 600; }
  .best-line { margin: 14px 0 0; color: var(--gold); font-weight: 800; min-height: 1.4em; }
  .result .row { justify-content: flex-start; margin-top: 18px; }
  .submit { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; margin: 22px 0 0; padding: 18px; border-radius: var(--r); background: var(--bg-2); } .submit .field { flex: 1; min-width: 150px; }
</style>

<script>
  import { JIGSAW } from '../i18n/jigsaw';
  import { gridFor, seeded, makeCut, renderPiece, piecePath, DAILY_PIECES, todayKST, dailyPick, type Cut, type PieceBitmap } from '../lib/jigsaw';
  import { DAILY_POOL, WORKS } from '../data/works';
  import { initScenes } from '../lib/scene';
  import { getBest, saveBest, getNick, setNick, bumpStreak, addDone } from '../lib/store';
  import { share, toast } from '../lib/share';
  import { saves, images, hasIDB, type SaveData } from '../lib/db';
  import { sendBlob, recvBlob, type Peer } from '../lib/rtc';
  import { me, syncDone, syncSave, syncDelSave, fetchSync, fetchSave, authAvailable, type SaveMeta } from '../lib/account';
  import { openLogin, askNick } from '../lib/authui';
  import { setNickRemote } from '../lib/account';
