  tray.addEventListener('wheel', (e) => { if (tray.scrollWidth > tray.clientWidth && Math.abs(e.deltaY) > Math.abs(e.deltaX)) { e.preventDefault(); tray.scrollLeft += e.deltaY; } }, { passive: false });
  // 공유 페이지에서 '나도 해보기'로 들어온 경우: 같은 명화·조각 수를 미리 선택
  { const q = new URLSearchParams(location.search); const k = q.get('k'), pn = Number(q.get('n')); const pt = WORKS.find((x) => x.key === k);
    if (q.get('resume')) { const id = q.get('resume')!; history.replaceState(null, '', location.pathname); saves.get(id).then((sv) => { if (sv) resumeSave(sv); }).catch(() => {}); }
    else if (q.get('photo') === '1') { const d = $('jg-drop'); d.classList.add('pulse'); d.scrollIntoView({ block: 'center' }); setTimeout(() => d.classList.remove('pulse'), 4000); history.replaceState(null, '', location.pathname); }
    else if (q.get('daily') || (pt && q.get('d') === '1')) { const dq = q.get('daily') ?? '1'; const dd = /^\d{4}-\d{2}-\d{2}$/.test(dq) && dq <= day ? dq : day; const pk = dd === day ? pick : dailyPick(dd, DAILY_POOL); loadSource({ kind: 'daily', key: pk.painting.key, name: `${T.daily} ${dd === day ? '' : dd.replace(/-/g, '.')} · ${pk.painting.title[LI]}`.replace('  ', ' '), url: `/jigsaw/${pk.painting.key}.webp`, seed: pk.seed, day: dd, fixedN: DAILY_PIECES }, true); history.replaceState(null, '', location.pathname); }
    else if (pt) { if (pn >= 6 && pn <= 2000) wantN = pn; document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((x) => x.classList.toggle('on', Number(x.dataset.n) === wantN)); loadSource({ kind: 'gallery', key: pt.key, name: T.paintingBy(pt.title[LI], pt.artist[LI], pt.year), url: `/jigsaw/${pt.key}.webp` }, pn >= 6 && pn <= 2000); history.replaceState(null, '', location.pathname); } }
  $('jg-start').addEventListener('click', () => start());
  $('jg-retry').addEventListener('click', () => start());
  $('jg-title').addEventListener('click', () => scenes.go('title'));
</script>
