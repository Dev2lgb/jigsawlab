    if (lifting) drawPiece(lifting, 1.04);
  }
  function drawPiece(p: Piece, k: number) { const b = p.bmp; const x = p.x + b.ox, y = p.y + b.oy; if (k !== 1) { ctx.save(); ctx.shadowColor = 'rgba(23,26,36,.45)'; ctx.shadowBlur = 16 / view.s; ctx.shadowOffsetY = 6 / view.s; ctx.translate(x + b.w / 2, y + b.h / 2); ctx.scale(k, k); ctx.drawImage(b.canvas, -b.w / 2, -b.h / 2, b.w, b.h); ctx.restore(); } else ctx.drawImage(b.canvas, x, y, b.w, b.h); }
  function hit(bx: number, by: number): Piece | null {
    for (let i = boardOrder.length - 1; i >= 0; i--) { const p = boardOrder[i]; if (bx >= p.x && bx <= p.x + cut.pw && by >= p.y && by <= p.y + cut.ph) return p; }
    for (let i = boardOrder.length - 1; i >= 0; i--) { const p = boardOrder[i]; if (bx >= p.x - cut.padX && bx <= p.x + cut.pw + cut.padX && by >= p.y - cut.padY && by <= p.y + cut.ph + cut.padY) return p; }
    return null;
  }
  function place(p: Piece) {
    moves++; const tol = Math.min(cut.pw, cut.ph) * 0.45;
    if (Math.abs(p.x - p.c * cut.pw) < tol && Math.abs(p.y - p.r * cut.ph) < tol) {
      p.x = p.c * cut.pw; p.y = p.r * cut.ph; p.locked = true; p.onBoard = false; boardOrder = boardOrder.filter((q) => q !== p);
      const lc = lockedLayer.getContext('2d')!; lc.drawImage(p.bmp.canvas, p.x + p.bmp.ox, p.y + p.bmp.oy, p.bmp.w, p.bmp.h);
      lockedN++; updateHud(); navigator.vibrate?.(8); if (lockedN === total) finish();
    } else { p.onBoard = true; if (!boardOrder.includes(p)) boardOrder.push(p); }
    p.el?.remove(); draw();
  }

  // ── 보드 포인터: 조각 드래그 / 한 손가락 이동 / 두 손가락 핀치
  const ptrs = new Map<number, { x: number; y: number }>(); let dragOff = { x: 0, y: 0 }, pinch: { d0: number; s0: number; bx: number; by: number } | null = null;
  const startPinch = () => { const [a, b] = [...ptrs.values()]; const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2, bm = toBoard(mx, my); pinch = { d0: Math.max(1, Math.hypot(a.x - b.x, a.y - b.y)), s0: view.s, bx: bm.x, by: bm.y }; };
  canvas.addEventListener('pointerdown', (e) => {
    if (ptrs.size >= 2) return;
    canvas.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (ptrs.size === 2) { if (dragging) { dragging.onBoard = true; if (!boardOrder.includes(dragging)) boardOrder.push(dragging); dragging = null; canvas.classList.remove('drag'); } startPinch(); return; }
    const b = toBoard(e.clientX, e.clientY); const p = hit(b.x, b.y);
    if (p) { dragging = p; dragOff = { x: b.x - p.x, y: b.y - p.y }; boardOrder = [...boardOrder.filter((q) => q !== p), p]; canvas.classList.add('drag'); draw(); }
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!ptrs.has(e.pointerId)) return; const prev = ptrs.get(e.pointerId)!; ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pinch && ptrs.size === 2) {
      const [a, b] = [...ptrs.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y), mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2; const r = wrap.getBoundingClientRect();
      view.s = Math.max(fitS * 0.5, Math.min(fitS * 6, pinch.s0 * (d / pinch.d0)));
      view.tx = (mx - r.left) - pinch.bx * view.s; view.ty = (my - r.top) - pinch.by * view.s; draw(); return;
    }
    if (dragging) { const b = toBoard(e.clientX, e.clientY); dragging.x = b.x - dragOff.x; dragging.y = b.y - dragOff.y; draw(); }
    else if (ptrs.size === 1) { view.tx += e.clientX - prev.x; view.ty += e.clientY - prev.y; draw(); }
  });
  const up = (e: PointerEvent) => { if (!ptrs.has(e.pointerId)) return; ptrs.delete(e.pointerId); if (ptrs.size < 2) pinch = null; if (dragging && ptrs.size === 0) { place(dragging); dragging = null; canvas.classList.remove('drag'); } };
  for (const ev of ['touchstart', 'touchmove'] as const) canvas.addEventListener(ev, (e) => e.preventDefault(), { passive: false });
  for (const ev of ['gesturestart', 'gesturechange'] as const) canvas.addEventListener(ev, (e) => e.preventDefault());
  canvas.addEventListener('pointerup', up); canvas.addEventListener('pointercancel', up);
  canvas.addEventListener('wheel', (e) => { e.preventDefault(); zoomAt(e.deltaY < 0 ? 1.15 : 1 / 1.15, e.clientX, e.clientY); }, { passive: false });
  $('jg-zin').addEventListener('click', () => { const r = wrap.getBoundingClientRect(); zoomAt(1.3, r.left + r.width / 2, r.top + r.height / 2); });
  $('jg-zout').addEventListener('click', () => { const r = wrap.getBoundingClientRect(); zoomAt(1 / 1.3, r.left + r.width / 2, r.top + r.height / 2); });
  $('jg-fit').addEventListener('click', fit);
  $('jg-hint').addEventListener('click', () => { showHint = !showHint; $('jg-hint').setAttribute('aria-pressed', String(showHint)); draw(); });
  let edgeOnly = false; const isEdge = (p: Piece) => p.r === 0 || p.c === 0 || p.r === cut.rows - 1 || p.c === cut.cols - 1;
  function applyEdgeFilter() { for (const p of pieces) if (p.el) p.el.hidden = edgeOnly && !isEdge(p); }
  $('jg-edge').addEventListener('click', () => { edgeOnly = !edgeOnly; $('jg-edge').setAttribute('aria-pressed', String(edgeOnly)); applyEdgeFilter(); });
  $('jg-quit').addEventListener('click', () => { running = false; clearInterval(timer); scenes.go('title'); });
  new ResizeObserver(() => { if (scenes.current === 'play') onResize(); }).observe(wrap);

  // ── 트레이: 옆으로 밀면 스크롤, 위로 올리면 꺼내기
  function bindTray(el: HTMLElement, p: Piece) {
    let sx = 0, sy = 0, id = -1, lifted = false, isMouse = false;
    el.addEventListener('pointerdown', (e) => { if (e.pointerType === 'touch') return; sx = e.clientX; sy = e.clientY; id = e.pointerId; lifted = false; isMouse = e.pointerType === 'mouse'; try { el.setPointerCapture(id); } catch {} });
    el.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return; const dx = e.clientX - sx, dy = e.clientY - sy;
      if (!lifted) { const go = isMouse ? Math.hypot(dx, dy) > 6 : (dy < -8 && Math.abs(dy) > Math.abs(dx) * 0.8) || e.clientY < tray.getBoundingClientRect().top; if (!go) return; lifted = true; el.classList.add('lift'); lifting = p; }
      const b = toBoard(e.clientX, e.clientY); p.x = b.x - cut.pw / 2; p.y = b.y - cut.ph / 2; draw();
    });
    const done = (e: PointerEvent) => { if (e.pointerId !== id) return; id = -1; if (!lifted) return; lifted = false; lifting = null; const r = wrap.getBoundingClientRect(); if (e.type === 'pointerup' && e.clientY < r.bottom) place(p); else { el.classList.remove('lift'); draw(); } };
    el.addEventListener('pointerup', done); el.addEventListener('pointercancel', done);
    // 터치(아이폰 사파리): pan-x 스크롤 판정에 pointercancel 되는 문제를 피해 터치 이벤트로 직접. 위로 6px 이상이면 스크롤을 막고 들어 올림
    let tx = 0, ty = 0, tid = -1, tlift = false;
    el.addEventListener('touchstart', (e) => { if (e.touches.length !== 1) return; const t = e.touches[0]; tx = t.clientX; ty = t.clientY; tid = t.identifier; tlift = false; }, { passive: true });
    el.addEventListener('touchmove', (e) => {
      const t = [...e.changedTouches].find((x) => x.identifier === tid); if (!t) return; const dx = t.clientX - tx, dy = t.clientY - ty;
      if (!tlift) { if (dy < -6 && Math.abs(dy) > Math.abs(dx)) { tlift = true; el.classList.add('lift'); lifting = p; } else return; }
      e.preventDefault(); const b = toBoard(t.clientX, t.clientY); p.x = b.x - cut.pw / 2; p.y = b.y - cut.ph / 2; draw();
    }, { passive: false });
    const tend = (e: TouchEvent) => { const t = [...e.changedTouches].find((x) => x.identifier === tid); if (!t) return; tid = -1; if (!tlift) return; tlift = false; lifting = null; const r = wrap.getBoundingClientRect(); if (e.type === 'touchend' && t.clientY < r.bottom) place(p); else { el.classList.remove('lift'); draw(); } };
    el.addEventListener('touchend', tend); el.addEventListener('touchcancel', tend);
  }

  // ── 완성
  function finish() {
    running = false; clearInterval(timer); const sec = Math.max(1, Math.round((performance.now() - t0) / 1000));
    complete = true; tray.hidden = true; $('jg-hint').hidden = true; $('jg-edge').hidden = true; showHint = false; $('jg-hint').setAttribute('aria-pressed', 'false');
    requestAnimationFrame(() => { resize(); fit(); });
    const t1 = performance.now(); const fade = () => { completeAlpha = Math.min(1, (performance.now() - t1) / 900); draw(); if (completeAlpha < 1) requestAnimationFrame(fade); }; requestAnimationFrame(fade);
    $('jg-done-time').textContent = fmt(sec); $('jg-done').hidden = false; navigator.vibrate?.([10, 40, 20]);
    prepareResult(sec);
  }
  function prepareResult(sec: number) {
    $('jg-res-time').textContent = fmt(sec); $('jg-res-n').textContent = String(total); $('jg-res-m').textContent = String(moves); $('jg-res-name').textContent = src!.name;
    const key = bestKey(total); const isBest = saveBest(key, sec, 'asc'); const b = getBest(key); $('jg-res-best').textContent = isBest ? T.newBest : b ? T.best(fmt(b)) : '';
    if (src!.kind === 'daily') bumpStreak(src!.day!);
    const sb = document.querySelector<HTMLButtonElement>('.share-btn')!; const pTitle = src!.kind !== 'photo' ? PAINTINGS.find((x) => x.key === src!.key)!.title[LI] : '';
    sb.dataset.title = src!.kind === 'daily' ? T.shareDaily(total, fmt(sec), pTitle) : T.shareTitle(total, fmt(sec)); sb.dataset.text = T.shareText;
    const Pfx = LANG === 'ko' ? '' : `/${LANG}`; sb.dataset.url = src!.kind === 'photo' ? `${location.origin}${Pfx}/play/` : `${location.origin}${Pfx}/s/?k=${src!.key}&n=${total}&t=${sec}&m=${moves}${src!.kind === 'daily' ? '&d=1' : ''}`;
    const form = $('jg-submit') as HTMLFormElement; form.hidden = src!.kind !== 'daily'; form.dataset.score = String(sec); ($('jg-nick') as HTMLInputElement).value = getNick();
    const rc = $('jg-res-img') as HTMLCanvasElement; const k = Math.min(720 / cut.W, 540 / cut.H, 1); rc.width = Math.round(cut.W * k); rc.height = Math.round(cut.H * k); rc.getContext('2d')!.drawImage(img!, 0, 0, rc.width, rc.height);
  }
  $('jg-toresult').addEventListener('click', () => scenes.go('result'));
  document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((b) => b.addEventListener('click', async () => { const r = await share({ title: b.dataset.title!, text: b.dataset.text, url: b.dataset.url || undefined }); const I = (window as any).__i18n; if (r === 'copied') toast(I.copied); else if (r === 'failed') toast(I.shareFail); }));
  // 오늘의 퍼즐 랭킹(날짜별, 기기당 최고 1건)
  const loadRank = () => {}; // 랭킹 목록은 홈에서 보여줌
  ($('jg-submit') as HTMLFormElement).addEventListener('submit', async (e) => { e.preventDefault(); const form = e.target as HTMLFormElement; const nick = ($('jg-nick') as HTMLInputElement).value.trim(); if (!nick) return; try { setNick(nick); const r = await api({ action: 'solve', nick, device: deviceId(), ms: Number(form.dataset.score) * 1000, tries: moves }); if (r.error) throw new Error(r.error); toast(T.registered(r.rank)); form.hidden = true; loadRank(); } catch { toast(T.rankFail); } });
  // 테스트·썸네일용: 트레이 앞 n개를 제자리에 놓음
  (window as any).__jigsaw = { demo: (n: number) => { for (const p of order.filter((q) => !q.locked).slice(0, n)) { p.x = p.c * cut.pw; p.y = p.r * cut.ph; place(p); } }, state: () => ({ total, lockedN, moves, board: boardOrder.length, tray: tray.children.length, loose: boardOrder.map((p) => ({ r: p.r, c: p.c, x: p.x, y: p.y })), pw: cut.pw, ph: cut.ph, view: { ...view } }) };
  tray.addEventListener('wheel', (e) => { if (tray.scrollWidth > tray.clientWidth && Math.abs(e.deltaY) > Math.abs(e.deltaX)) { e.preventDefault(); tray.scrollLeft += e.deltaY; } }, { passive: false });
  // 공유 페이지에서 '나도 해보기'로 들어온 경우: 같은 명화·조각 수를 미리 선택
  { const q = new URLSearchParams(location.search); const k = q.get('k'), pn = Number(q.get('n')); const pt = PAINTINGS.find((x) => x.key === k);
    if (q.get('photo') === '1') { const d = $('jg-drop'); d.classList.add('pulse'); d.scrollIntoView({ block: 'center' }); setTimeout(() => d.classList.remove('pulse'), 4000); history.replaceState(null, '', location.pathname); }
    else if (q.get('daily') === '1' || (pt && q.get('d') === '1')) { dailyBtn.click(); history.replaceState(null, '', location.pathname); }
    else if (pt) { if (pn >= 6 && pn <= 300) { wantN = pn; document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((x) => x.classList.toggle('on', Number(x.dataset.n) === pn)); if (![12, 24, 48, 96, 150, 200].includes(pn)) ($('jg-custom') as HTMLInputElement).value = String(pn); } document.querySelector<HTMLButtonElement>(`#jg-gallery .box[data-key="${pt.key}"]`)?.click(); history.replaceState(null, '', location.pathname); } }
  $('jg-start').addEventListener('click', start);
  $('jg-retry').addEventListener('click', start);
  $('jg-title').addEventListener('click', () => scenes.go('title'));
</script>
