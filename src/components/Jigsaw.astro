  const workName = (w: Work) => T.paintingBy(w.title[LI], w.artist[LI], w.year);

  // ── 오늘의 퍼즐 (빌드 시각과 방문 시각의 날짜가 다를 수 있어 클라이언트에서 다시 계산)
  const day = todayKST(), pick = dailyPick(day, DAILY_POOL);

  // ── 소스 선택 (내 사진 / 오늘의 퍼즐 / 명화)
  type Source = { kind: 'photo' | 'daily' | 'gallery'; key: string; name: string; url?: string; file?: File; blob?: Blob; seed?: number; day?: string; fixedN?: number; photoId?: string };
  const gallerySrc = (w: Work): Source => ({ kind: 'gallery', key: w.key, name: workName(w), url: artUrl(w.key) });
  let pendingSave: SaveData | null = null; // 선택한 그림·조각 수에 저장된 판이 있으면 여기에
  let src: Source | null = null, wantN = 48, img: ImageBitmap | null = null, imgW = 0, imgH = 0;
  let photoBlob: Blob | null = null; // 내 사진(webp). 사진 방에서 친구에게 WebRTC 로 보내는 원본
  const setup = $('jg-setup'), thumb = $('jg-thumb') as HTMLImageElement;
  const closeSetup = () => { setup.hidden = true; }; $('jg-close').addEventListener('click', closeSetup); $('jg-modal-bg').addEventListener('click', closeSetup);
  const MAXSIDE = 2400;
  /** 조각 수 프리셋 버튼 표시 (null 이면 모두 끔 — 직접 입력) */
  const markPreset = (n: number | null) => document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((b) => b.classList.toggle('on', n !== null && Number(b.dataset.n) === n));
  /** 그림을 읽어 판을 준비한다. auto = 바로 시작(설정 없이), quiet = 설정 다이얼로그를 띄우지 않는다 (둘 다 아니면 사진일 때만 조각 수를 묻는다) */
  async function loadSource(s: Source, o: { auto?: boolean; quiet?: boolean } = {}) {
    const auto = !!o.auto, quiet = !!o.quiet;
    src = s; img = null; pendingSave = null; setup.hidden = s.kind !== 'photo' || auto || quiet; $('jg-chosen-name').textContent = s.name; $('jg-grid').textContent = '…';
    const file = s.file ?? s.blob; const blobUrl = file ? URL.createObjectURL(file) : s.url!; thumb.src = blobUrl;
    try {
      let bmp: ImageBitmap | HTMLImageElement;
      if (file && 'createImageBitmap' in window) { try { bmp = await createImageBitmap(file, { imageOrientation: 'from-image' } as any); } catch { bmp = await loadImg(blobUrl); } } else bmp = await loadImg(blobUrl);
      const w = 'naturalWidth' in bmp ? bmp.naturalWidth : bmp.width, h = 'naturalHeight' in bmp ? bmp.naturalHeight : bmp.height;
      const sc = Math.min(1, MAXSIDE / Math.max(w, h)); const cv = document.createElement('canvas'); cv.width = Math.round(w * sc); cv.height = Math.round(h * sc); cv.getContext('2d')!.drawImage(bmp, 0, 0, cv.width, cv.height);
      img = await createImageBitmap(cv); imgW = cv.width; imgH = cv.height;
      if (s.kind === 'photo') { photoBlob = s.blob ?? null; if (s.file) { s.photoId = `photo-${Date.now().toString(36)}`; cv.toBlob((b) => { if (!b) return; photoBlob = b; if (hasIDB()) images.put(s.photoId!, b).catch(() => {}); }, 'image/webp', 0.85); } }
      if (s.fixedN) { wantN = s.fixedN; markPreset(wantN); ($('jg-custom') as HTMLInputElement).value = ''; }
      updateGrid(); await checkSave();
      if (auto) { if (pendingSave) start(pendingSave); else start(); }
    } catch { toast(T.imgFail); setup.hidden = true; src = null; }
  }
  function updateGrid() { if (!img) return; const g = gridFor(wantN, imgW / imgH), n = g.cols * g.rows; $('jg-grid').textContent = T.gridLabel(g.cols, g.rows, n); const pn = src && src.kind !== 'photo' ? bestDoneN(src.key) : null, xp = Math.round(n * rateFor(src?.kind === 'daily' ? 'daily' : 'gallery', n, pn)).toLocaleString(); $('jg-xp').textContent = pn !== null && n <= pn ? V.earnRepeat(xp) : V.earn(xp); }
  const saveId = () => { if (src!.kind === 'daily') return `daily:${src!.day}`; if (src!.kind === 'photo') return `photo:${src!.photoId}`; const g = gridFor(wantN, imgW / imgH); return `${src!.key}:${g.cols * g.rows}`; };
  // 로그인했으면 서버에 있는 하던 퍼즐 목록(메타)을 한 번 받아 두고, 로컬에 없을 때 대신 씀
  let remoteSaves: SaveMeta[] = []; let remoteReady: Promise<void> = me().then(async (u) => { if (!u) return; const r = await fetchSync(); if (r) remoteSaves = r.saves; }).catch(() => {});
  const dropRemote = (id: string) => { remoteSaves = remoteSaves.filter((m) => m.id !== id); syncDelSave(id); };
  async function checkSave() { pendingSave = null; if (!src || !img || !hasIDB() || src.kind === 'photo' || room) return; try { pendingSave = (await saves.get(saveId())) ?? null; } catch {} if (!pendingSave) { await remoteReady; const m = remoteSaves.find((x) => x.id === saveId()); if (m) { const d = await fetchSave(m.id); if (d && d.savedAt >= m.savedAt - 1) pendingSave = d; } } }
  const bestKey = (n: number) => src?.kind === 'daily' ? `daily:${src.day}` : `${src?.key}:${n}`;
  document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((b) => b.addEventListener('click', () => { wantN = Number(b.dataset.n); markPreset(wantN); ($('jg-custom') as HTMLInputElement).value = ''; updateGrid(); }));
  $('jg-custom').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v >= 6 && v <= 2000) { wantN = v; markPreset(null); updateGrid(); } });

  // ── 게임 상태 — 느슨한 조각은 모두 "뭉치(Group)"에 속한다. 뭉치의 (dx,dy)는 제자리 대비 오프셋이라 뭉치 안 조각들은 격자 관계를 그대로 유지한다
  type Group = { id: number; dx: number; dy: number; pieces: Piece[]; sid?: string };
  type Piece = { r: number; c: number; bmp: PieceBitmap; g: Group | null; locked: boolean; el?: HTMLElement; thumbed?: boolean; hue: number; lum: number; sat: number };
  // 멀티 방
  let room: { id: string; live: boolean; ws: WebSocket | null; me: Player | null; players: Map<string, Player & { x?: number; y?: number }>; holders: Map<string, string>; bySid: Map<string, Group> } | null = null;
  const send = (m: ClientMsg) => { if (room?.ws && room.ws.readyState === 1) room.ws.send(JSON.stringify(m)); };
  // 탭마다 고정된 접속 id — 재접속하면 서버가 같은 pid 의 옛 소켓을 닫아 목록에 내가 여럿으로 남지 않는다. 탭이 다르면 다른 사람(같은 브라우저 두 탭은 둘)
  const PID = (() => { const fresh = () => Math.random().toString(36).slice(2, 10); try { let p = sessionStorage.getItem('jl:pid'); if (!p) { p = fresh(); sessionStorage.setItem('jl:pid', p); } return p; } catch { return fresh(); } })();
  let outline = false, outlineLayer: HTMLCanvasElement | null = null; // 판 위 조각 윤곽선
  // 윤곽선·밑그림을 켜고 끈 것은 기기에 기억한다 — 판을 열 때마다 다시 눌러야 했다. null = 한 번도 안 건드림(윤곽선은 작은 판만 켠 채로)
  const pref = (k: 'outline' | 'hint') => { try { const v = localStorage.getItem(`board:${k}`); return v === null ? null : v === '1'; } catch { return null; } };
  const setPref = (k: 'outline' | 'hint', on: boolean) => { try { localStorage.setItem(`board:${k}`, on ? '1' : '0'); } catch {} };
  let cut: Cut, pieces: Piece[] = [], order: Piece[] = [], grid: Piece[][] = [], total = 0, lockedN = 0, moves = 0, t0 = 0, timer = 0, lockedLayer: HTMLCanvasElement, showHint = false, peek = false, running = false, gen = 0;
  let groups: Group[] = []; // 보드 위 뭉치 (배열 순서 = z 순서)
  let complete = false, completeAlpha = 0, gid = 0;
  const lockReq = new Set<string>();       // 방에서 서버에 청해 둔 잠그기 — 받아들여져야 내 조각으로 친다
  const takeReq = new Set<string>();       // 트레이에서 꺼내며 서버에 청해 둔 take — 거절(deny)되면 트레이로 되돌릴 것과 판 위 뭉치를 잡은 것(grab)을 가른다
  // '남이 잡고 있음' 표시(room.holders)는 내 판의 기억일 뿐이라 묵을 수 있다 — 그 사람이 소리 없이 끊겼거나, 재접속으로 id 가 바뀌었거나,
  // 놓았다는 소식이 안 왔거나. 서버(room.ts holder)는 끊긴 사람·90초 넘게 가만히 둔 점유를 풀어 주지만 그 뭉치에 관한 메시지가 와야 판단한다.
  // 그래서 지금 붙어 있는 사람이 최근에 잡은 것만 여기서 막고, 나머지는 잡아 보고 서버 답(deny)을 따른다. 전에는 여기서 판단을 끝내서 묵은 표시가 붙은 조각은 아무도 못 잡고 영영 떠 있었다
  const HOLD_MAX = 90_000; const holdT = new Map<string, number>();
  const heldByOther = (sid: string) => { const h = room?.holders.get(sid); return !!h && h !== room!.me?.id && room!.players.has(h) && performance.now() - (holdT.get(sid) ?? 0) < HOLD_MAX; };
  let myLocked = 0; // 공개 판에서 이번 회차에 내가 제자리에 놓은 조각 수 (여럿이 며칠에 걸쳐 맞추므로 시간·수순 대신 이걸 보여 준다)
  let dragging: Group | null = null, lifting: Group | null = null;
  const canvas = $('jg-board') as HTMLCanvasElement, ctx = canvas.getContext('2d')!, wrap = $('jg-boardwrap'), tray = $('jg-tray');
  /** 끌던 것을 놓는다 (조각은 그 자리에) — 남이 가져갔거나 서버가 거절했거나 핀치로 넘어갈 때 */
  const endDrag = () => { dragging = null; canvas.classList.remove('drag'); clearReturnHover(); };
  const view = { s: 1, tx: 0, ty: 0 }; let fitS = 1; const dpr = () => Math.min(2, window.devicePixelRatio || 1);
  const maxS = () => Math.max(fitS * 6, 220 / Math.min(cut.pw, cut.ph)), minS = () => fitS * 0.5; // 1000조각도 조각 하나가 220px 로 보일 때까지 확대
  let lastW = 0, lastH = 0;
  const px = (p: Piece) => p.c * cut.pw + (p.g?.dx ?? 0), py = (p: Piece) => p.r * cut.ph + (p.g?.dy ?? 0);
  function resize() { const r = wrap.getBoundingClientRect(); canvas.width = Math.round(r.width * dpr()); canvas.height = Math.round(r.height * dpr()); lastW = r.width; lastH = r.height; }
  // 화면 크기 변화(모바일 주소창 접힘 등): 맞춤 상태였으면 다시 맞춤, 확대 중이면 보드 중심을 그대로 유지
  function onResize() { if (!cut) return; const r = wrap.getBoundingClientRect(); if (!r.width || !r.height || (r.width === lastW && r.height === lastH)) return; const wasFit = Math.abs(view.s - fitS) < 1e-6; const cx = (lastW / 2 - view.tx) / view.s, cy = (lastH / 2 - view.ty) / view.s; resize(); const nf = Math.min(r.width / (cut.W * 1.12), r.height / (cut.H * 1.12)); if (wasFit) { fitS = nf; fit(); return; } fitS = nf; view.s = Math.max(minS(), Math.min(maxS(), view.s)); view.tx = r.width / 2 - cx * view.s; view.ty = r.height / 2 - cy * view.s; draw(); }
  function fit() { const r = wrap.getBoundingClientRect(); fitS = Math.min(r.width / (cut.W * 1.12), r.height / (cut.H * 1.12)); view.s = fitS; view.tx = (r.width - cut.W * fitS) / 2; view.ty = (r.height - cut.H * fitS) / 2; draw(); }
  const toBoard = (cx: number, cy: number) => { const r = wrap.getBoundingClientRect(); return { x: (cx - r.left - view.tx) / view.s, y: (cy - r.top - view.ty) / view.s }; };
  /** 지금 화면에 보이는 보드 좌표 범위 */
  const viewRect = () => { const r = wrap.getBoundingClientRect(); return { x0: -view.tx / view.s, y0: -view.ty / view.s, x1: (r.width - view.tx) / view.s, y1: (r.height - view.ty) / view.s }; };
  function zoomAt(f: number, cx: number, cy: number) { const r = wrap.getBoundingClientRect(); const pxx = cx - r.left, pyy = cy - r.top; const ns = Math.max(minS(), Math.min(maxS(), view.s * f)); const k = ns / view.s; view.tx = pxx - (pxx - view.tx) * k; view.ty = pyy - (pyy - view.ty) * k; view.s = ns; draw(); }

