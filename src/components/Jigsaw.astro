---
// 직소 퍼즐 앱 본체 — 홈 화면(오늘의 퍼즐·내 사진·명화) → 조각 수 다이얼로그 → 플레이(캔버스 보드 + 트레이) → 완성 감상 → 결과
import { JIGSAW } from '../i18n/jigsaw';
import { UI, LI, prefix, type Lang } from '../i18n/ui';
import { PAINTINGS, DAILY_PIECES, todayKST, dailyPick } from '../lib/jigsaw';
import { shelvesFor } from '../lib/catalogView';
import Box from './Box.astro';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const t = JIGSAW[lang], li = LI[lang], P = prefix(lang), U = UI[lang];
const PRESETS = [12, 24, 48, 96, 150, 200];
const day = todayKST(), daily = dailyPick(day, PAINTINGS);
const shelves = shelvesFor(lang);
---
<section class="scene page active picker" data-scene="title">
  <h1 class="serif pick-title">{t.title}</h1>
  <p class="pick-sub">{t.sub}</p>
  <div class="sources">
    <button type="button" class="src daily" id="jg-daily" data-key={daily.painting.key} data-seed={daily.seed} data-day={day}>
      <img id="daily-thumb" src={`/jigsaw/t-${daily.painting.key}.jpg`} alt="" width="240" height="190" />
      <span class="src-text"><b>{t.daily}</b><span id="daily-cap">{t.dailyCap(daily.painting.title[li], DAILY_PIECES)}</span><span class="src-go">{U.hero.cta} →</span></span>
    </button>
    <label class="src drop" id="jg-drop"><input type="file" id="jg-file" accept="image/*" hidden />
      <span class="drop-ic" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="8.5" cy="10" r="1.6"/><path d="m21 15-4.8-4.8a1.5 1.5 0 0 0-2.1 0L6 18"/></svg></span>
      <span class="src-text"><b>{t.pick}</b><span>{t.drop}</span><span class="src-go">{t.privacy}</span></span>
    </label>
  </div>
  <h2 class="gal-h">{t.gallery}</h2>
  <div id="jg-gallery">{shelves.map((sh) => <div class="shelf"><h3>{sh.name}<span class="muted">{sh.items.length}</span></h3><div class="boxes">{sh.items.map((p) => <Box p={p} />)}</div></div>)}</div>
</section>

<div class="modal" id="jg-setup" hidden>
  <div class="modal-bg" id="jg-modal-bg"></div>
  <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="jg-chosen-name">
    <button type="button" class="close" id="jg-close" aria-label={t.toTitle}>✕</button>
    <div class="chosen"><img id="jg-thumb" alt="" /><div><b id="jg-chosen-name">{t.chosen}</b><span class="grid-lbl" id="jg-grid"></span></div></div>
    <p class="lbl">{t.pieces}</p>
    <div class="pieces">{PRESETS.map((n) => <button type="button" data-n={n} class:list={[{ on: n === 48 }]}>{n}</button>)}<input class="input custom" id="jg-custom" type="number" min="6" max="300" placeholder={t.custom} /></div>
    <div class="row"><button class="btn primary" id="jg-start">{t.start}</button></div>
    <p class="muted best" id="jg-best"></p>
  </div>
</div>

<section class="scene play" data-scene="play">
  <div class="play-wrap">
    <div class="hud">
      <span class="chip">⏱ <b id="jg-time">0:00</b></span>
      <span class="chip" id="jg-left"></span>
      <span class="hud-name muted" id="jg-hud-name"></span>
      <span class="sp"></span>
      <button type="button" class="ib" id="jg-hint" title={t.hint} aria-pressed="false">👁</button>
      <button type="button" class="ib" id="jg-edge" title={t.edgeOnly} aria-pressed="false">▢</button>
      <button type="button" class="ib" id="jg-zin" title={t.zoomIn}>＋</button>
      <button type="button" class="ib" id="jg-zout" title={t.zoomOut}>－</button>
      <button type="button" class="ib" id="jg-fit" title={t.fit}>⤢</button>
      <button type="button" class="ib" id="jg-quit" title={t.toTitle}>✕</button>
    </div>
    <div class="progress" aria-hidden="true"><i id="jg-prog"></i></div>
    <div class="boardwrap" id="jg-boardwrap"><canvas id="jg-board"></canvas><p class="loading muted" id="jg-loading">{t.loading}</p>
      <div class="done" id="jg-done" hidden><span>🎉 {t.done}</span><b id="jg-done-time"></b><button type="button" class="btn primary sm" id="jg-toresult">{t.viewResult}</button></div>
    </div>
    <div class="tray" id="jg-tray" aria-label={t.trayHint}></div>
  </div>
</section>

<section class="scene page result" data-scene="result">
  <h2 class="title-h">🎉 {t.done}</h2>
  <p class="muted" id="jg-res-name"></p>
  <canvas class="res-img" id="jg-res-img" width="320" height="240"></canvas>
  <div class="res"><div><small>{t.resTime}</small><b id="jg-res-time">0:00</b></div><div><small>{t.resPieces}</small><b id="jg-res-n">0</b></div><div><small>{t.resMoves}</small><b id="jg-res-m">0</b></div></div>
  <p class="best-line" id="jg-res-best"></p>
  <div class="row">
    <button class="btn primary" id="jg-retry">{t.retry}</button>
    <button class="btn share-btn" data-title="" data-text="">{t.share}</button>
    <button class="btn" id="jg-title">{t.another}</button>
    <a class="btn" href={`${P}/`}>{U.foot.toHome}</a>
  </div>
  <form class="card submit" id="jg-submit" hidden>
    <div class="field"><label for="jg-nick">{t.nickLabel}</label><input class="input" id="jg-nick" maxlength="12" placeholder={t.nickPh} /></div>
    <button class="btn primary" type="submit">{t.submit}</button>
  </form>
</section>

<style>
  .picker { max-width: var(--max); padding-top: 26px; }
  .pick-title { font-size: clamp(1.6rem, 3.6vw, 2.3rem); margin: 0 0 6px; } .pick-sub { margin: 0 0 20px; color: var(--muted); max-width: 40em; }
  .sources { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 700px) { .sources { grid-template-columns: 1fr; } }
  .src { display: flex; align-items: center; gap: 16px; padding: 16px; border: 1px solid var(--line); border-radius: 18px; background: var(--white); color: var(--ink); cursor: pointer; text-align: left; font: inherit; }
  .src:hover, .src.pulse { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .src.drop { border-style: dashed; } .src.drop.over { background: var(--accent-soft); border-color: var(--accent); }
  .src img { width: 92px; height: 74px; object-fit: cover; border-radius: 10px; flex: none; border: 1px solid var(--line-soft); }
  .drop-ic { display: grid; place-items: center; width: 92px; height: 74px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); flex: none; }
  .src-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; } .src-text b { font-size: 1.05rem; } .src-text > span { color: var(--muted); font-size: .88rem; } .src-go { color: var(--accent) !important; font-weight: 600; margin-top: 4px; }
  .gal-h { font-family: var(--serif); font-size: 1.3rem; margin: 30px 0 14px; }
  .shelf { margin: 0 0 24px; } .shelf h3 { display: flex; align-items: baseline; gap: 8px; font-size: 1rem; font-weight: 600; margin: 0 0 12px; } .shelf h3 .muted { font-weight: 400; font-size: .85rem; }
  .picker .boxes { grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 16px 12px; }
  @media (max-width: 480px) { .picker .boxes { grid-template-columns: repeat(3, 1fr); gap: 12px 8px; } .picker .box { padding-left: 9px; } .picker .box .spine { width: 9px; } }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 3px var(--accent-soft); } 50% { box-shadow: 0 0 0 8px var(--accent-soft); } }
  .src.pulse { animation: pulse 1.2s ease-in-out 3; }

  /* 조각 수 다이얼로그 */
  .modal { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .modal-bg { position: absolute; inset: 0; background: rgba(23,26,36,.45); }
  .dialog { position: relative; width: min(92vw, 420px); max-height: 92%; overflow: auto; padding: 20px; background: var(--white); border-radius: 18px; box-shadow: 0 20px 60px rgba(23,26,36,.25); animation: pop .16s ease-out; }
  @keyframes pop { from { transform: scale(.96); opacity: 0; } to { transform: none; opacity: 1; } }
  .close { position: absolute; top: 10px; right: 10px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--white); cursor: pointer; }
  .chosen { display: flex; align-items: center; gap: 12px; margin: 0 32px 4px 0; } .chosen img { width: 72px; height: 72px; object-fit: cover; border-radius: 10px; background: var(--board); flex: none; } .chosen div { display: flex; flex-direction: column; } .grid-lbl { color: var(--accent); font-weight: 600; }
  .lbl { color: var(--muted); font-size: .85rem; font-weight: 600; margin: 14px 0 6px; }
  .pieces { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .pieces button { border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: var(--ink); font-weight: 600; padding: 6px 13px; cursor: pointer; } .pieces button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .custom { width: 96px; min-height: 36px; padding: 4px 10px; }
  .row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin: 16px 0 0; }
  .best { text-align: center; margin: 10px 0 0; min-height: 1.3em; font-size: .9rem; }

  /* 플레이 */
  .play-wrap { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .hud { display: flex; align-items: center; gap: 6px; padding: 8px 10px; flex: none; background: var(--paper); border-bottom: 1px solid var(--line-soft); } .sp { flex: 1; }
  .hud .chip { white-space: nowrap; } .hud .chip b { font-variant-numeric: tabular-nums; }
  .hud-name { font-size: .85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; margin-left: 4px; } @media (max-width: 640px) { .hud-name { display: none; } }
  .progress { height: 3px; background: var(--line-soft); flex: none; } .progress i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .25s ease; }
  @media (max-width: 480px) { .hud { gap: 4px; padding: 6px 8px; } .hud .chip { font-size: .78rem; padding: 3px 8px; } .ib { width: 32px; height: 32px; } }
  .ib { width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line); background: var(--white); color: var(--ink); font-size: 1rem; cursor: pointer; display: grid; place-items: center; } .ib[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .boardwrap { position: relative; flex: 1; min-height: 0; background: var(--board); background-image: radial-gradient(rgba(23,26,36,.09) 1px, transparent 1px); background-size: 22px 22px; }
  .boardwrap canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; } .boardwrap canvas.drag { cursor: grabbing; }
  .loading { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); margin: 0; pointer-events: none; }
  .done { position: absolute; left: 50%; top: 12px; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 16px; border-radius: 999px; background: var(--white); border: 1px solid var(--gold); box-shadow: 0 8px 24px rgba(233,168,32,.25); white-space: nowrap; z-index: 3; font-weight: 600; }
  .done b { font-variant-numeric: tabular-nums; color: var(--accent); }
  .tray { flex: none; height: 104px; display: flex; gap: 8px; align-items: center; padding: 8px 10px; overflow-x: auto; overflow-y: hidden; background: var(--paper); border-top: 1px solid var(--line); touch-action: pan-x; scrollbar-width: thin; }
  .tray :global(.tp) { flex: none; width: 80px; height: 80px; border-radius: 10px; background: var(--white); border: 1px solid var(--line-soft); display: grid; place-items: center; cursor: grab; touch-action: pan-x; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  .tray :global(.tp canvas) { max-width: 72px; max-height: 72px; pointer-events: none; filter: drop-shadow(0 2px 3px rgba(23,26,36,.3)); }
  .tray :global(.tp.lift) { visibility: hidden; }

  /* 결과 */
  .result { text-align: center; padding-top: 40px; } .result .title-h { font-family: var(--serif); font-size: 2.2rem; }
  .res-img { display: block; max-width: min(92vw, 360px); max-height: 270px; width: auto; height: auto; margin: 14px auto 6px; border-radius: 12px; border: 1px solid var(--line); background: var(--board); }
  .res { display: flex; gap: 22px; justify-content: center; margin: 12px 0 4px; } .res div { display: flex; flex-direction: column; align-items: center; } .res small { color: var(--muted); font-size: .8rem; } .res b { font-size: 1.7rem; font-variant-numeric: tabular-nums; }
  .best-line { margin: 4px 0 10px; color: var(--gold); font-weight: 600; min-height: 1.4em; }
  .submit { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; width: 100%; max-width: 440px; margin: 18px auto 0; text-align: left; } .submit .field { flex: 1; min-width: 150px; }
</style>

<script>
  import { JIGSAW } from '../i18n/jigsaw';
  import { gridFor, seeded, makeCut, renderPiece, PAINTINGS, DAILY_PIECES, todayKST, dailyPick, type Cut, type PieceBitmap } from '../lib/jigsaw';
  import { initScenes } from '../lib/scene';
  import { getBest, saveBest, getNick, setNick, deviceId, api, bumpStreak } from '../lib/store';
  import { share, toast } from '../lib/share';
  const hl = document.documentElement.lang, LANG = (hl === 'en' || hl === 'ja' ? hl : 'ko') as 'ko' | 'en' | 'ja', LI = ({ ko: 0, en: 1, ja: 2 } as const)[LANG];
  const T = JIGSAW[LANG]; const scenes = initScenes();
  scenes.onChange((n) => { if (n === 'title') history.replaceState(null, '', location.pathname); });
  const $ = <E extends HTMLElement>(id: string) => document.getElementById(id) as E;
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const loadImg = (u: string) => new Promise<HTMLImageElement>((res, rej) => { const im = new Image(); im.onload = () => res(im); im.onerror = rej; im.src = u; });

  // ── 오늘의 퍼즐 (빌드 시각과 방문 시각의 날짜가 다를 수 있어 클라이언트에서 다시 계산)
  const dailyBtn = $('jg-daily') as HTMLButtonElement;
  const day = todayKST(), pick = dailyPick(day, PAINTINGS);
  dailyBtn.dataset.key = pick.painting.key; dailyBtn.dataset.seed = String(pick.seed); dailyBtn.dataset.day = day;
  ($('daily-thumb') as HTMLImageElement).src = `/jigsaw/t-${pick.painting.key}.jpg`; $('daily-cap').textContent = T.dailyCap(pick.painting.title[LI], DAILY_PIECES);

  // ── 소스 선택 (내 사진 / 오늘의 퍼즐 / 명화)
  type Source = { kind: 'photo' | 'daily' | 'gallery'; key: string; name: string; url?: string; file?: File; seed?: number; day?: string; fixedN?: number };
  let src: Source | null = null, wantN = 48, img: ImageBitmap | null = null, imgW = 0, imgH = 0;
  const setup = $('jg-setup'), thumb = $('jg-thumb') as HTMLImageElement;
  const closeSetup = () => { setup.hidden = true; }; $('jg-close').addEventListener('click', closeSetup); $('jg-modal-bg').addEventListener('click', closeSetup);
  const MAXSIDE = 1600;
  async function loadSource(s: Source) {
    src = s; img = null; setup.hidden = false; $('jg-chosen-name').textContent = s.name; $('jg-grid').textContent = '…';
    document.querySelectorAll('#jg-gallery .box').forEach((b) => b.classList.toggle('on', s.kind === 'gallery' && (b as HTMLElement).dataset.key === s.key));
    const blobUrl = s.file ? URL.createObjectURL(s.file) : s.url!; thumb.src = blobUrl;
    try {
      let bmp: ImageBitmap | HTMLImageElement;
      if (s.file && 'createImageBitmap' in window) { try { bmp = await createImageBitmap(s.file, { imageOrientation: 'from-image' } as any); } catch { bmp = await loadImg(blobUrl); } } else bmp = await loadImg(blobUrl);
      const w = 'naturalWidth' in bmp ? bmp.naturalWidth : bmp.width, h = 'naturalHeight' in bmp ? bmp.naturalHeight : bmp.height;
      const sc = Math.min(1, MAXSIDE / Math.max(w, h)); const cv = document.createElement('canvas'); cv.width = Math.round(w * sc); cv.height = Math.round(h * sc); cv.getContext('2d')!.drawImage(bmp, 0, 0, cv.width, cv.height);
      img = await createImageBitmap(cv); imgW = cv.width; imgH = cv.height;
      if (s.fixedN) { wantN = s.fixedN; document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((b) => b.classList.toggle('on', Number(b.dataset.n) === wantN)); ($('jg-custom') as HTMLInputElement).value = ''; }
      updateGrid();
    } catch { toast(T.imgFail); setup.hidden = true; src = null; }
  }
  function updateGrid() { if (!img) return; const g = gridFor(wantN, imgW / imgH); $('jg-grid').textContent = T.gridLabel(g.cols, g.rows, g.cols * g.rows); const b = getBest(bestKey(g.cols * g.rows)); $('jg-best').textContent = b ? T.best(fmt(b)) : T.noRecord; }
  const bestKey = (n: number) => src?.kind === 'daily' ? `daily:${src.day}` : `${src?.key}:${n}`;
  $('jg-file').addEventListener('change', (e) => { const f = (e.target as HTMLInputElement).files?.[0]; if (f) loadSource({ kind: 'photo', key: 'photo', name: T.myPhoto, file: f }); });
  const drop = $('jg-drop'); drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); }); drop.addEventListener('dragleave', () => drop.classList.remove('over')); drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); const f = e.dataTransfer?.files?.[0]; if (f) loadSource({ kind: 'photo', key: 'photo', name: T.myPhoto, file: f }); });
  dailyBtn.addEventListener('click', () => loadSource({ kind: 'daily', key: pick.painting.key, name: `${T.daily} · ${pick.painting.title[LI]}`, url: `/jigsaw/${pick.painting.key}.jpg`, seed: pick.seed, day, fixedN: DAILY_PIECES }));
  document.querySelectorAll<HTMLButtonElement>('#jg-gallery .box').forEach((b) => b.addEventListener('click', () => { const p = PAINTINGS.find((x) => x.key === b.dataset.key)!; loadSource({ kind: 'gallery', key: p.key, name: T.paintingBy(p.title[LI], p.artist[LI], p.year), url: `/jigsaw/${p.key}.jpg` }); }));
  document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((b) => b.addEventListener('click', () => { if (src?.kind === 'daily') return toast(T.dailyCap('', DAILY_PIECES).trim()); wantN = Number(b.dataset.n); document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((x) => x.classList.toggle('on', x === b)); ($('jg-custom') as HTMLInputElement).value = ''; updateGrid(); }));
  $('jg-custom').addEventListener('input', (e) => { const v = Number((e.target as HTMLInputElement).value); if (v >= 6 && v <= 300 && src?.kind !== 'daily') { wantN = v; document.querySelectorAll<HTMLButtonElement>('.pieces button').forEach((x) => x.classList.remove('on')); updateGrid(); } });

  // ── 게임 상태
  type Piece = { r: number; c: number; x: number; y: number; bmp: PieceBitmap; locked: boolean; onBoard: boolean; el?: HTMLElement };
  let cut: Cut, pieces: Piece[] = [], order: Piece[] = [], total = 0, lockedN = 0, moves = 0, t0 = 0, timer = 0, lockedLayer: HTMLCanvasElement, showHint = false, running = false;
  let boardOrder: Piece[] = []; // 보드 위 느슨한 조각의 z 순서
  let complete = false, completeAlpha = 0;
  let dragging: Piece | null = null, lifting: Piece | null = null;
  const canvas = $('jg-board') as HTMLCanvasElement, ctx = canvas.getContext('2d')!, wrap = $('jg-boardwrap'), tray = $('jg-tray');
  const view = { s: 1, tx: 0, ty: 0 }; let fitS = 1; const dpr = () => Math.min(2, window.devicePixelRatio || 1);
  let lastW = 0, lastH = 0;
  function resize() { const r = wrap.getBoundingClientRect(); canvas.width = Math.round(r.width * dpr()); canvas.height = Math.round(r.height * dpr()); lastW = r.width; lastH = r.height; }
  // 화면 크기 변화(모바일 주소창 접힘 등): 맞춤 상태였으면 다시 맞춤, 확대 중이면 보드 중심을 그대로 유지
  function onResize() { if (!cut) return; const r = wrap.getBoundingClientRect(); if (!r.width || !r.height || (r.width === lastW && r.height === lastH)) return; const wasFit = Math.abs(view.s - fitS) < 1e-6; const cx = (lastW / 2 - view.tx) / view.s, cy = (lastH / 2 - view.ty) / view.s; resize(); const nf = Math.min(r.width / (cut.W * 1.12), r.height / (cut.H * 1.12)); if (wasFit) { fitS = nf; fit(); return; } view.s = Math.max(nf * 0.5, Math.min(nf * 6, view.s)); fitS = nf; view.tx = r.width / 2 - cx * view.s; view.ty = r.height / 2 - cy * view.s; draw(); }
  function fit() { const r = wrap.getBoundingClientRect(); fitS = Math.min(r.width / (cut.W * 1.12), r.height / (cut.H * 1.12)); view.s = fitS; view.tx = (r.width - cut.W * fitS) / 2; view.ty = (r.height - cut.H * fitS) / 2; draw(); }
  const toBoard = (cx: number, cy: number) => { const r = wrap.getBoundingClientRect(); return { x: (cx - r.left - view.tx) / view.s, y: (cy - r.top - view.ty) / view.s }; };
  function zoomAt(f: number, cx: number, cy: number) { const r = wrap.getBoundingClientRect(); const px = cx - r.left, py = cy - r.top; const ns = Math.max(fitS * 0.5, Math.min(fitS * 6, view.s * f)); const k = ns / view.s; view.tx = px - (px - view.tx) * k; view.ty = py - (py - view.ty) * k; view.s = ns; draw(); }

  async function start() {
    if (!img || !src) return toast(T.noImg);
    const g = gridFor(wantN, imgW / imgH); total = g.cols * g.rows;
    const rand = seeded(src.kind === 'daily' ? src.seed! : (Math.random() * 2 ** 32) >>> 0);
    cut = makeCut(imgW, imgH, g.cols, g.rows, rand);
    closeSetup(); $('jg-hud-name').textContent = src.name; complete = false; completeAlpha = 0; $('jg-done').hidden = true; tray.hidden = false; $('jg-hint').hidden = false; $('jg-edge').hidden = false;
    scenes.go('play'); $('jg-loading').hidden = false; tray.innerHTML = ''; pieces = []; boardOrder = []; dragging = null; lifting = null; lockedN = 0; moves = 0; running = false;
    lockedLayer = document.createElement('canvas'); lockedLayer.width = imgW; lockedLayer.height = imgH;
    await new Promise((r) => setTimeout(r, 30));
    const bmpScale = Math.min(1, 1200 / Math.max(imgW, imgH));
    for (let r = 0; r < g.rows; r++) for (let c = 0; c < g.cols; c++) pieces.push({ r, c, x: c * cut.pw, y: r * cut.ph, bmp: renderPiece(cut, r, c, img, bmpScale), locked: false, onBoard: false });
    order = [...pieces].sort(() => Math.random() - 0.5);
    for (const p of order) { const el = document.createElement('div'); el.className = 'tp'; const cv = document.createElement('canvas'); const k = 72 / Math.max(p.bmp.w, p.bmp.h); cv.width = Math.round(p.bmp.w * k); cv.height = Math.round(p.bmp.h * k); cv.getContext('2d')!.drawImage(p.bmp.canvas, 0, 0, cv.width, cv.height); el.appendChild(cv); p.el = el; tray.appendChild(el); bindTray(el, p); }
    applyEdgeFilter(); $('jg-loading').hidden = true; resize(); fit(); updateHud(); t0 = performance.now(); running = true; clearInterval(timer); timer = window.setInterval(tick, 250);
  }
  function tick() { if (!running) return; $('jg-time').textContent = fmt((performance.now() - t0) / 1000); }
  function updateHud() { $('jg-left').textContent = T.left(total - lockedN); ($('jg-prog') as HTMLElement).style.width = `${total ? (lockedN / total) * 100 : 0}%`; }
  let drawQueued = false;
  function draw() { if (drawQueued) return; drawQueued = true; requestAnimationFrame(() => { drawQueued = false; drawNow(); }); }
  function drawNow() {
    if (!cut) return; const d = dpr(); ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.setTransform(d * view.s, 0, 0, d * view.s, d * view.tx, d * view.ty);
    ctx.fillStyle = 'rgba(255,255,255,.55)'; ctx.fillRect(0, 0, cut.W, cut.H);
    if (showHint && img) { ctx.globalAlpha = 0.3; ctx.drawImage(img, 0, 0, cut.W, cut.H); ctx.globalAlpha = 1; }
    ctx.setLineDash([8 / view.s, 6 / view.s]); ctx.lineWidth = 2 / view.s; ctx.strokeStyle = 'rgba(39,72,230,.55)'; ctx.strokeRect(0, 0, cut.W, cut.H); ctx.setLineDash([]);
    ctx.drawImage(lockedLayer, 0, 0);
    if (complete && img) { ctx.globalAlpha = completeAlpha; ctx.drawImage(img, 0, 0, cut.W, cut.H); ctx.globalAlpha = 1; }
