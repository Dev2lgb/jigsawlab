    }
    /** 통계 — 이 기기 기록과 서버 기록을 at 으로 합쳐 셈한다. 방에서 맞춘 판은 내가 놓은 조각(mine)만 조각 수에 넣고 시간은 안 넣는다(방의 시간은 판이 열린 뒤 흐른 시간이라 내 것이 아니다) */
    function renderStats() {
      const local = getDone(); const seen = new Set(local.map((d) => d.at)); const list = [...local, ...remote.done.filter((d) => !seen.has(d.at))];
      const tiles = $('st-tiles'), grid = $('st-grid'), empty = $('e-stats'); tiles.innerHTML = '';
      if (!list.length) { empty.hidden = false; grid.hidden = true; return; } empty.hidden = true; grid.hidden = false;
      let pieces = 0, secs = 0, soloPieces = 0, biggest = 0, daily = 0; const works = new Set<string>();
      for (const d of list) { const mine = d.room && d.mine !== undefined ? d.mine : d.n; pieces += mine; if (!d.room) { secs += d.sec; soloPieces += d.n; } if (d.n > biggest) biggest = d.n; if (d.kind === 'daily') daily++; if (d.kind !== 'photo') works.add(d.key); }
      const ppm = secs > 0 ? (soloPieces * 60) / secs : 0;
      const rows: [string, string][] = [[V.statSolved, String(list.length)], [V.statPieces, pieces.toLocaleString()], [M.statTime, M.hm(Math.floor(secs / 3600), Math.floor((secs % 3600) / 60))], [M.statPpm, ppm >= 10 ? String(Math.round(ppm)) : ppm.toFixed(1)], [M.statBiggest, biggest.toLocaleString()], [M.statDaily, String(daily)], [V.statWorks, String(works.size)]];
      for (const [k, v] of rows) { const w = document.createElement('div'); const b = document.createElement('b'); b.textContent = v; const s = document.createElement('small'); s.textContent = k; w.appendChild(b); w.appendChild(s); tiles.appendChild(w); }
      // 잔디 달력 — 최근 20주, 월요일 시작 열. 날짜는 KST(사이트 전체가 KST 로 하루를 센다)
      const per = new Map<string, number>(); for (const d of list) { const k = kstDay(d.at); per.set(k, (per.get(k) ?? 0) + 1); }
      const today = kstDay(Date.now()); const t = new Date(today + 'T00:00:00Z'); const dow = (t.getUTCDay() + 6) % 7; // 월=0
      const start = new Date(t); start.setUTCDate(t.getUTCDate() - dow - 7 * 19);
      const cal = $('st-cal'); cal.innerHTML = ''; let most = 0;
      for (let i = 0; i < 20 * 7; i++) { const d = new Date(start); d.setUTCDate(start.getUTCDate() + i); const key = d.toISOString().slice(0, 10); if (key > today) break; const n = per.get(key) ?? 0; if (n > most) most = n; const c = document.createElement('i'); c.className = 'd' + (n ? ' c' + Math.min(4, n >= 5 ? 4 : n >= 3 ? 3 : n) : '') + (key === today ? ' today' : ''); c.title = `${key} · ${M.calN(n)}`; cal.appendChild(c); }
      { const from = start.toISOString().slice(0, 10); let inWin = 0; for (const [k, n] of per) if (k >= from) inWin += n; $('st-cal-legend').textContent = M.calN(inWin); }
      // 진열대별 진도 — 그림(키)이 서로 다른 것만 센다
      const byCat = new Map<string, Set<string>>(); for (const k of works) { const c = meta[k]?.[3]; if (!c) continue; if (!byCat.has(c)) byCat.set(c, new Set()); byCat.get(c)!.add(k); }
      const ul = $('st-cats'); ul.innerHTML = '';
      for (const [id, name, total] of cats) { const n = byCat.get(id)?.size ?? 0; const li = document.createElement('li'); if (n >= total) li.className = 'all'; const nm = document.createElement('span'); nm.className = 'cb-n'; nm.textContent = name; const bar = document.createElement('span'); bar.className = 'cb-bar'; bar.innerHTML = `<i style="width:${(n / total) * 100}%"></i>`; const b = document.createElement('b'); b.textContent = `${n} / ${total}`; li.appendChild(nm); li.appendChild(bar); li.appendChild(b); ul.appendChild(li); }
      requestAnimationFrame(() => cal.querySelector<HTMLElement>('.today')?.scrollIntoView({ block: 'nearest', inline: 'end' }));
    }
    function renderFav() {
      const box = $('l-fav'); box.innerHTML = ''; const list = favs().filter((k) => meta[k]);
      $('e-fav').hidden = !!list.length; $('c-fav').textContent = list.length ? String(list.length) : '';
      for (const k of list) { const m = meta[k]; box.appendChild(card({ href: `${P}/puzzle/${k}/`, img: `/jigsaw/t-${k}.webp`, title: m[0], sub: `${m[1]} · ${m[2]}`, onDel: () => { toggleFav(k); renderFav(); } })); }
    }
    async function renderAcct() {
      const u = await me(); const box = $('acct-box'), st = $('acct-state'), bt = $('acct-btns'); bt.innerHTML = '';
      if (!authAvailable()) return; box.hidden = false;
      const btn = (t: string, cls: string, fn: () => void) => { const b = document.createElement(cls.includes('link') ? 'a' : 'button') as HTMLButtonElement; b.className = `btn sm ${cls}`; b.textContent = t; b.addEventListener('click', fn); bt.appendChild(b); return b; };
      if (!u) { st.textContent = A.notSignedIn; btn(A.loginBtn, 'primary', () => openLogin()); return; }
      st.textContent = A.signedIn(u.nick || '?'); $('my-sub').textContent = A.synced;
      btn(A.rename, '', async () => { const n = await askNick(u.nick, 'edit'); if (n && n !== u.nick && (await setNickRemote(n))) renderAcct(); });
      btn(A.logout, '', async () => { await logout(); location.reload(); });
      btn(A.del, 'danger', async () => { if (!confirm(A.delAsk)) return; if (await deleteAccount()) { alert(A.deleted); location.reload(); } });
      const r = await fetchSync(); if (r) { remote = r; renderProg(); renderDone(); renderStats(); }
    }
    async function renderLevel() {
      const d = await fetchLevel(); if (!d) return;
      const pr = levelProgress(d.xp);
      $('lvl-n').textContent = String(pr.level);
      $('lvl-tier').textContent = TIER_NAMES[tierOf(pr.level)][LI];
      $('lvl-next').textContent = pr.need > 0 ? V.nextIn(pr.need) : V.maxed;
      const tiles: [string, string][] = [
        [V.totalXp, d.xp.toLocaleString()], [V.weekXp, d.week.xp.toLocaleString()],
        [V.rankAll, d.rank ? V.nth(d.rank) : V.none], [V.rankWeek, d.week.rank ? V.nth(d.week.rank) : V.none],
        [V.statSolved, String(d.stats.solved)], [V.statPieces, d.stats.pieces.toLocaleString()],
        [V.statWorks, String(d.stats.works)], [V.statStreak, String(d.stats.streak_best)],
      ];
      const box = $('lvl-stats'); box.innerHTML = '';
      for (const [k, v] of tiles) { const w = document.createElement('div'); const b = document.createElement('b'); b.textContent = v; const s = document.createElement('small'); s.textContent = k; w.appendChild(b); w.appendChild(s); box.appendChild(w); }
      $('lvl').hidden = false;
      requestAnimationFrame(() => { ($('lvl-fill') as HTMLElement).style.width = `${pr.pct}%`; });
      // 업적 — 딴 것 먼저, 그 뒤로 가까운 순
      const got = new Set(d.badges.map((b) => b.code));
      const list = [...BADGES].sort((a, b) => { const ga = got.has(a.code) ? 1 : 0, gb = got.has(b.code) ? 1 : 0; if (ga !== gb) return gb - ga; return b.goal(d.stats) / b.need - a.goal(d.stats) / a.need; });
      const grid = $('l-bdg'); grid.innerHTML = '';
      for (const b of list) {
        const on = got.has(b.code), t = BADGE_TEXT[b.code], have = Math.min(b.goal(d.stats), b.need);
        const w = document.createElement('div'); w.className = `bd ${on ? 'on' : 'off'}`;
        const i = document.createElement('span'); i.className = 'bd-i'; i.textContent = b.icon;
        const tx = document.createElement('div'); const nm = document.createElement('b'); nm.textContent = t.n[LI];
        const ds = document.createElement('small');
        if (on) ds.textContent = t.d[LI]; else { ds.textContent = `${t.d[LI]} · `; const p = document.createElement('span'); p.className = 'bd-p'; p.textContent = `${have.toLocaleString()} / ${b.need.toLocaleString()}`; ds.appendChild(p); }
        tx.appendChild(nm); tx.appendChild(ds); w.appendChild(i); w.appendChild(tx); grid.appendChild(w);
      }
      $('c-bdg').textContent = V.badgeCount(got.size, BADGES.length);
      // 딴 업적이 앞에 오도록 정렬돼 있어서 접어 둬도 첫 줄에 내 것이 보인다
      const blk = $('blk-bdg'), more = $('bdg-more') as HTMLButtonElement;
      const label = () => { more.textContent = blk.classList.contains('open') ? V.awLess : V.awAll(BADGES.length); };
      more.onclick = () => { blk.classList.toggle('open'); label(); };
      label();
      blk.hidden = false;
    }
    renderProg(); renderDone(); renderStats(); renderFav(); renderAcct(); renderLevel();
  </script>
