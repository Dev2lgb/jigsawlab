---
// 내 퍼즐 — 하던 퍼즐(IndexedDB) · 완성한 퍼즐(localStorage) · 즐겨찾기는 이 기기 안.
// 레벨·XP·업적은 서버가 매기므로 구글 로그인 회원에게만 보인다 (/api/level)
import Base from '../layouts/Base.astro';
import { altsFor, UI, LI, prefix, type Lang } from '../i18n/ui';
import { WORKS } from '../data/works';
import { CATEGORIES } from '../data/catalog';
import { icon } from '../lib/icons';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], P = prefix(lang), li = LI[lang], M = T.my, A = T.acct, V = T.lv;
// 넷째 칸 cat 은 통계의 진열대별 진도용 — works 를 클라이언트에 안 싣고도 그림 → 진열대를 안다
const meta = JSON.stringify(Object.fromEntries(WORKS.map((w) => [w.key, [w.title[li], w.artist[li], w.year, w.cat]])));
const cats = JSON.stringify(CATEGORIES.map((c) => [c.id, c.name[li], WORKS.filter((w) => w.cat === c.id).length]).filter((c) => (c[2] as number) > 0));
---
<Base title={`${M.title} · jigsawlab`} desc={M.onDevice} lang={lang} alts={altsFor('/my/')} path={`${P}/my/`} noindex>
  <div class="wrap my">
    <div class="my-head"><h1>{M.title}</h1><p class="muted" id="my-sub">{M.onDevice}</p></div>
    <section class="acct-box" id="acct-box" hidden>
      <div class="acct-row"><b id="acct-state"></b><div class="acct-btns" id="acct-btns"></div></div>
      <p class="muted acct-why">{A.why}</p>
    </section>
    <section class="lvl" id="lvl" hidden>
      <div class="lvl-top">
        <span class="lvl-num"><small>Lv</small><b id="lvl-n">1</b></span>
        <div class="lvl-mid">
          <b class="lvl-tier" id="lvl-tier"></b>
          <div class="lvl-bar"><i id="lvl-fill"></i></div>
          <small id="lvl-next"></small>
        </div>
        <a class="btn sm" href={`${P}/rank/`}>{V.seeRank} →</a>
      </div>
      <div class="lvl-stats" id="lvl-stats"></div>
    </section>
    <section class="blk bdg-blk" id="blk-bdg" hidden><h2>{V.badgesTitle}<small id="c-bdg"></small></h2><div class="bdgs" id="l-bdg"></div><button type="button" class="shelf-all bdg-more" id="bdg-more"></button></section>
    <!-- 통계 — 이 기기의 완성 목록(+회원이면 서버 기록)으로 브라우저에서 셈한다. 시간은 개인 기록으로만 보여 주고 랭킹에는 안 쓴다 -->
    <section class="blk stats-blk" id="blk-stats"><h2>{M.stats}</h2>
      <div class="st-tiles" id="st-tiles"></div>
      <p class="empty muted" id="e-stats" hidden>{M.emptyStats}</p>
      <div class="st-grid" id="st-grid" hidden>
        <div class="st-card"><h3>{M.calendar}</h3><div class="cal-wrap"><div class="cal" id="st-cal"></div></div><p class="cal-legend muted" id="st-cal-legend"></p></div>
        <div class="st-card"><h3>{M.byShelf}</h3><ul class="catbars" id="st-cats"></ul></div>
      </div>
    </section>
    <section class="blk"><h2>{M.inProgress}<small id="c-prog"></small></h2><div class="cards" id="l-prog"></div><p class="empty muted" id="e-prog" hidden>{M.emptyProgress}</p></section>
    <section class="blk"><h2>{M.done}<small id="c-done"></small></h2><div class="cards" id="l-done"></div><p class="empty muted" id="e-done" hidden>{M.emptyDone}</p></section>
    <section class="blk"><h2>{M.favs}<small id="c-fav"></small></h2><div class="cards" id="l-fav"></div><p class="empty muted" id="e-fav" hidden>{M.emptyFavs}</p></section>
  </div>
  <!-- 완성 보기 — 완성한 퍼즐 카드를 누르면. 그 판의 컷으로 조각 윤곽이 보이는 완성본을 그리고, 놓은 순서가 이 기기에 있으면 타임랩스 -->
  <div class="gdlg" id="done-dlg" hidden>
    <div class="gdlg-bg" id="done-bg"></div>
    <div class="gdlg-box done-box" role="dialog" aria-modal="true" aria-labelledby="done-h">
      <button type="button" class="gdlg-x" id="done-x" aria-label={A.close}><Fragment set:html={icon('x', 18)} /></button>
      <div class="done-art"><canvas id="done-cv" width="640" height="480"></canvas><button type="button" class="done-play" id="done-play" hidden title={M.replay} aria-label={M.replay}><Fragment set:html={icon('play', 18)} /></button></div>
      <h2 id="done-h"></h2>
      <p class="done-sub" id="done-sub"></p>
      <div class="done-row"><a class="btn primary" id="done-again">{M.again}</a><button type="button" class="btn" id="done-close">{A.close}</button></div>
    </div>
  </div>
  <script is:inline define:vars={{ meta, cats }}>window.__meta = JSON.parse(meta); window.__cats = JSON.parse(cats);</script>
  <style>
    .my { padding-top: clamp(24px, 4vw, 48px); } .my-head { margin-bottom: 8px; } .my-head h1 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.04em; } .my-head p { margin: 6px 0 0; }
    .acct-box { margin-top: 18px; padding: 16px 18px; border-radius: var(--r); background: var(--bg-2); } .acct-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; } .acct-btns { display: flex; gap: 8px; flex-wrap: wrap; } .acct-btns :global(.btn) { font-size: .85rem; } .acct-why { margin: 10px 0 0; font-size: .82rem; line-height: 1.55; }
    /* 레벨 카드 */
    .lvl { margin-top: 14px; padding: 18px; border-radius: var(--r); background: var(--bg-2); border: 1px solid var(--line); }
    .lvl-top { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .lvl-num { display: flex; align-items: baseline; gap: 4px; flex: none; color: var(--accent); }
    .lvl-num small { font-size: .82rem; font-weight: 800; letter-spacing: .04em; } .lvl-num b { font-family: var(--head); font-size: clamp(2.2rem, 6vw, 3rem); line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .lvl-mid { flex: 1; min-width: 190px; display: flex; flex-direction: column; gap: 6px; }
    .lvl-tier { font-size: 1.05rem; letter-spacing: -.02em; }
    .lvl-bar { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; } .lvl-bar i { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--accent); transition: width .8s var(--ease); }
    .lvl-mid small { color: var(--muted); font-size: .82rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    /* 아래 칸·업적 카드는 스크립트가 만드므로 :global (스코프 속성이 안 붙는다) */
    .lvl-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 10px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
    .lvl-stats:empty { display: none; }
    .lvl-stats :global(div) { display: flex; flex-direction: column; gap: 2px; } .lvl-stats :global(b) { font-size: 1.15rem; font-variant-numeric: tabular-nums; letter-spacing: -.02em; } .lvl-stats :global(small) { color: var(--muted); font-size: .76rem; font-weight: 600; }
    /* 업적 */
    /* 24가지를 다 펼치면 하던 퍼즐이 한참 아래로 밀린다 — 처음엔 첫 줄만(가장 좁을 땐 3개) */
    .bdgs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    @media (max-width: 1000px) { .bdgs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 760px) { .bdgs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 520px) { .bdgs { grid-template-columns: 1fr; } }
    .bdg-blk:not(.open) .bdgs :global(> :nth-child(n + 5)) { display: none; }
    @media (max-width: 1000px) { .bdg-blk:not(.open) .bdgs :global(> :nth-child(n + 4)) { display: none; } }
    @media (max-width: 760px) { .bdg-blk:not(.open) .bdgs :global(> :nth-child(n + 3)) { display: none; } }
    /* 한 칸짜리 너비에서는 한 장만 보이면 목록 같지가 않아 3장까지. 앞 쿼리에서 숨긴 3번째를 되살려 놓는다 */
    @media (max-width: 520px) { .bdg-blk:not(.open) .bdgs :global(> :nth-child(-n + 3)) { display: flex; } .bdg-blk:not(.open) .bdgs :global(> :nth-child(n + 4)) { display: none; } }
    .bdg-more { margin-top: 14px; }
    .bdgs :global(.bd) { display: flex; gap: 11px; align-items: flex-start; padding: 12px 13px; border-radius: var(--r-sm); background: var(--bg-2); border: 1px solid transparent; }
    .bdgs :global(.bd.on) { border-color: var(--accent); background: var(--bg); }
    .bdgs :global(.bd.off) { opacity: .55; } .bdgs :global(.bd.off .bd-i) { filter: grayscale(1); }
    .bdgs :global(.bd-i) { font-size: 1.45rem; line-height: 1.2; flex: none; }
    .bdgs :global(.bd b) { display: block; font-size: .92rem; } .bdgs :global(.bd small) { display: block; color: var(--muted); font-size: .78rem; line-height: 1.5; margin-top: 2px; }
    .bdgs :global(.bd-p) { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
    /* 통계 — 타일은 레벨 카드의 것과 같은 꼴. 달력·진열대 진도는 스크립트가 만드므로 :global */
    .st-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 10px; }
    .st-tiles :global(div) { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; border-radius: var(--r-sm); background: var(--bg-2); } .st-tiles :global(b) { font-size: 1.35rem; font-variant-numeric: tabular-nums; letter-spacing: -.02em; } .st-tiles :global(small) { color: var(--muted); font-size: .76rem; font-weight: 600; }
    .st-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; margin-top: 14px; } @media (max-width: 860px) { .st-grid { grid-template-columns: 1fr; } }
    .st-card { padding: 16px 18px; border-radius: var(--r); background: var(--bg-2); border: 1px solid var(--line); min-width: 0; } .st-card h3 { font-family: var(--font); font-size: .95rem; font-weight: 700; margin: 0 0 12px; }
    .cal-wrap { overflow-x: auto; scrollbar-width: thin; padding-bottom: 4px; }
    .cal { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 13px); grid-auto-columns: 13px; gap: 3px; width: max-content; }
    .cal :global(.d) { width: 13px; height: 13px; border-radius: 3px; background: var(--bg-3); } .cal :global(.d.c1) { background: #ffe1a3; } .cal :global(.d.c2) { background: var(--gold); } .cal :global(.d.c3) { background: #d98b06; } .cal :global(.d.c4) { background: #a86400; } .cal :global(.d.today) { box-shadow: inset 0 0 0 1.5px var(--ink); }
    .cal-legend { margin: 10px 0 0; font-size: .76rem; }
    .catbars { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .catbars :global(li) { display: grid; grid-template-columns: minmax(0, 9em) minmax(0, 1fr) auto; align-items: center; gap: 10px; font-size: .84rem; }
    .catbars :global(.cb-n) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: var(--ink-2); }
    .catbars :global(.cb-bar) { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; } .catbars :global(.cb-bar i) { display: block; height: 100%; border-radius: 999px; background: var(--accent); } .catbars :global(li.all .cb-bar i) { background: var(--gold); }
    .catbars :global(b) { font-variant-numeric: tabular-nums; font-size: .8rem; color: var(--muted); white-space: nowrap; } .catbars :global(li.all b) { color: #8a5f00; }
    /* 완성 보기 창 — 공용 .gdlg-box 보다 넓게, 그림이 주인공 */
    .done-box { width: min(94vw, 860px); padding: 14px 14px 18px; }
    .done-art { position: relative; border-radius: 14px; overflow: hidden; background: var(--board); box-shadow: 0 20px 50px -30px rgba(15,18,34,.6); } .done-art canvas { display: block; width: 100%; height: auto; }
    .done-play { position: absolute; left: 12px; bottom: 12px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(15,18,34,.65); color: #fff; display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(4px); transition: transform .15s var(--ease), background .15s; } .done-play:hover { background: rgba(15,18,34,.85); transform: scale(1.08); } .done-play:disabled { opacity: .4; cursor: default; transform: none; }
    #done-h { margin: 14px 4px 2px; font-size: 1.3rem; letter-spacing: -.03em; } .done-sub { margin: 0 4px; color: var(--muted); font-size: .88rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .done-row { display: flex; gap: 8px; flex-wrap: wrap; margin: 14px 4px 0; }
    .cards :global(.mc.click) { cursor: pointer; }
    .blk { padding: clamp(28px, 4vw, 44px) 0 0; } .blk h2 { font-size: 1.35rem; margin: 0 0 14px; display: flex; align-items: baseline; gap: 10px; } .blk h2 small { color: var(--muted); font-size: .9rem; font-weight: 600; }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
    .empty { margin: 0; padding: 22px; border-radius: var(--r); background: var(--bg-2); }
    .cards :global(.mc) { position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-sm); background: var(--bg); overflow: hidden; color: var(--ink); text-decoration: none; transition: transform .2s var(--ease), box-shadow .2s; }
    .cards :global(.mc:hover) { transform: translateY(-3px); box-shadow: 0 16px 30px -18px rgba(15,18,34,.5); text-decoration: none; }
    .cards :global(.mc img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--board); display: block; }
    .cards :global(.mc .bar) { height: 4px; background: var(--line); } .cards :global(.mc .bar i) { display: block; height: 100%; background: var(--accent); }
    .cards :global(.mc .t) { padding: 10px 12px 2px; font-weight: 700; font-size: .92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .cards :global(.mc .s) { padding: 0 12px 12px; color: var(--muted); font-size: .8rem; }
    .cards :global(.mc .s b) { color: var(--ink); font-variant-numeric: tabular-nums; }
    .cards :global(.mc .x) { position: absolute; top: 8px; right: 8px; width: 28px; height: 28px; border-radius: 50%; border: 0; background: rgba(15,18,34,.6); color: #fff; cursor: pointer; font-size: .8rem; }
    .cards :global(.mc .badge) { position: absolute; top: 8px; left: 8px; padding: 3px 9px; border-radius: 999px; background: var(--gold); color: #fff; font-size: .72rem; font-weight: 800; }
  </style>
  <script>
    import { allSaves, deleteSave } from '../lib/saves';
    import { getDone, fmtSec, type DoneEntry } from '../lib/store';
    import { openLogin, askNick } from '../lib/authui';
    import { me, logout, deleteAccount, setNickRemote, fetchSync, authAvailable, fetchLevel, type SaveMeta } from '../lib/account';
    import { BADGES, levelProgress, tierOf, kstDay } from '../lib/level';
    import { BADGE_TEXT, TIER_NAMES } from '../i18n/badges';
    import { favs, toggleFav } from '../lib/fav';
    import { makeCut, seeded, piecePath, gridFor, hashStr, type Cut } from '../lib/jigsaw';
    import { replays, hasIDB } from '../lib/db';
    import { docLang, prefix, LI as LIDX, UI } from '../i18n/ui';
    const LANG = docLang(), LI = LIDX[LANG], M = UI[LANG].my, A = UI[LANG].acct, V = UI[LANG].lv, P = prefix(LANG);
    let remote: { done: DoneEntry[]; saves: SaveMeta[] } = { done: [], saves: [] };
    const meta = (window as any).__meta as Record<string, string[]>, cats = (window as any).__cats as [string, string, number][];
    const $ = (id: string) => document.getElementById(id)!;
    const card = (o: { href?: string; img: string; title: string; sub: string; bar?: number; badge?: string; onDel?: () => void; onClick?: () => void }) => {
      const a = document.createElement(o.href ? 'a' : 'div') as HTMLAnchorElement; a.className = 'mc'; if (o.href) a.href = o.href;
      if (o.onClick) { a.classList.add('click'); a.setAttribute('role', 'button'); a.tabIndex = 0; a.addEventListener('click', o.onClick); a.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); o.onClick!(); } }); }
      const im = document.createElement('img'); im.src = o.img; im.alt = ''; im.loading = 'lazy'; a.appendChild(im);
      if (o.bar !== undefined) { const b = document.createElement('div'); b.className = 'bar'; b.innerHTML = `<i style="width:${o.bar}%"></i>`; a.appendChild(b); }
      const t = document.createElement('div'); t.className = 't'; t.textContent = o.title; const s = document.createElement('div'); s.className = 's'; s.innerHTML = o.sub; a.appendChild(t); a.appendChild(s);
      if (o.badge) { const b = document.createElement('span'); b.className = 'badge'; b.textContent = o.badge; a.appendChild(b); }
      if (o.onDel) { const x = document.createElement('button'); x.type = 'button'; x.className = 'x'; x.textContent = '✕'; x.title = M.del; x.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); o.onDel!(); }); a.appendChild(x); }
      return a;
    };
    async function renderProg() {
      const box = $('l-prog'); box.innerHTML = ''; const list = await allSaves(remote.saves);
      $('e-prog').hidden = !!list.length; $('c-prog').textContent = list.length ? String(list.length) : '';
      for (const sv of list) box.appendChild(card({ href: `${P}/board/?resume=${encodeURIComponent(sv.id)}`, img: sv.thumb, title: sv.name, sub: `<b>${Math.round((sv.done / sv.total) * 100)}%</b> · ${M.pieces(sv.total)} · ${fmtSec(sv.elapsed / 1000)}`, bar: (sv.done / sv.total) * 100, badge: sv.remote ? A.synced : undefined, onDel: async () => { await deleteSave(sv); remote.saves = remote.saves.filter((m) => m.id !== sv.id); renderProg(); } }));
    }
    function renderDone() {
      const box = $('l-done'); box.innerHTML = ''; const local = getDone(); const seen = new Set(local.map((d) => d.at)); const list = [...local, ...remote.done.filter((d) => !seen.has(d.at))].sort((a, b) => b.at - a.at);
      $('e-done').hidden = !!list.length; $('c-done').textContent = list.length ? M.doneCount(list.length) : '';
      // 카드를 누르면 다시 맞추기가 아니라 완성 보기 — 맞춘 그림을 조각 모양째 감상하고 순서를 되돌려 본다. 다시 맞추기는 그 창 안에
      for (const d of list) { const m = meta[d.key]; const isPhoto = d.kind === 'photo'; box.appendChild(card({ img: isPhoto ? '' : `/jigsaw/t-${d.key}.webp`, title: isPhoto ? M.photo : (m ? m[0] : d.name), sub: `<b>${fmtSec(d.sec)}</b> · ${M.pieces(d.n)} · ${new Date(d.at).toLocaleDateString()}`, badge: d.kind === 'daily' ? '📅' : undefined, onClick: isPhoto || !m ? undefined : () => openView(d) })); }
    }
    // ── 완성 보기: 그 판의 컷(seed·cols·rows)으로 조각 윤곽이 보이는 완성본. 순서(replays)가 이 기기에 있으면 3초 타임랩스 —
    //  조각마다 경로로 클립해 그 자리만 그린다(비트맵을 다시 뜨지 않는다). seed 가 없는 기록(옛 것·다른 기기)은 같은 조각 수의 정해진 컷으로
    const dlg = $('done-dlg'), dcv = $('done-cv') as HTMLCanvasElement, dplay = $('done-play') as HTMLButtonElement; let viewGen = 0;
    const closeView = () => { viewGen++; dlg.hidden = true; document.documentElement.classList.toggle('dlg-open', !!document.querySelector('.gdlg:not([hidden])')); };
    for (const id of ['done-bg', 'done-x', 'done-close']) $(id).addEventListener('click', closeView);
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !dlg.hidden) closeView(); });
    const loadImg = (u: string) => new Promise<HTMLImageElement>((res, rej) => { const im = new Image(); im.onload = () => res(im); im.onerror = rej; im.src = u; });
    const strokePiece = (c: CanvasRenderingContext2D, cut: Cut, k: number, r: number, col: number) => { c.save(); c.setTransform(k, 0, 0, k, 0, 0); c.lineWidth = Math.max(1.2 / k, Math.min(cut.pw, cut.ph) * 0.035); c.strokeStyle = 'rgba(15,18,34,.38)'; c.lineJoin = 'round'; c.stroke(piecePath(cut, r, col)); c.restore(); };
    async function openView(d: DoneEntry) {
      const m = meta[d.key]; if (!m) return; const my = ++viewGen;
      dlg.hidden = false; document.documentElement.classList.add('dlg-open'); dplay.hidden = true;
      $('done-h').textContent = m[0]; $('done-sub').textContent = `${m[1]} · ${M.pieces(d.n)} · ${fmtSec(d.sec)} · ${new Date(d.at).toLocaleDateString()}`;
      ($('done-again') as HTMLAnchorElement).href = `${P}/puzzle/${d.key}/`;
      const c = dcv.getContext('2d')!; c.setTransform(1, 0, 0, 1, 0, 0); c.clearRect(0, 0, dcv.width, dcv.height);
      let img: HTMLImageElement; try { img = await loadImg(`/jigsaw/${d.key}.webp`); } catch { return; } if (my !== viewGen) return;
      const W = img.naturalWidth, H = img.naturalHeight, g = d.cols && d.rows ? { cols: d.cols, rows: d.rows } : gridFor(d.n, W / H);
      const cut = makeCut(W, H, g.cols, g.rows, seeded(d.seed ?? hashStr(`${d.key}:${d.n}`)));
