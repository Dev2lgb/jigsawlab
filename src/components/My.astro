          for (; drawn < upto; drawn++) { const i = order[drawn], r = Math.floor(i / g.cols), col = i % g.cols; const x = col * cut.pw - cut.padX, y = r * cut.ph - cut.padY, w = cut.pw + cut.padX * 2, h = cut.ph + cut.padY * 2;
