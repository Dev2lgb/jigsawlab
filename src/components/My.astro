      const still = () => { c.setTransform(1, 0, 0, 1, 0, 0); c.clearRect(0, 0, dcv.width, dcv.height); c.drawImage(img, 0, 0, dcv.width, dcv.height); for (let r = 0; r < g.rows; r++) for (let col = 0; col < g.cols; col++) strokePiece(c, cut, k, r, col); dplay.disabled = false; };
