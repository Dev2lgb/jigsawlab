---
import { BODY } from '../i18n/body';
// /photo/ — 내 사진으로 퍼즐 만들기. /play/ 와 달리 검색으로 들어온 사람을 받는 랜딩이라
// 히어로에서 바로 업로드하고(선택 화면을 거치지 않음), 아래에 본문을 둔다.
// 고른 사진은 IndexedDB 에 임시로 넣고 /board/?photo=<id>&n=<조각> 으로 넘긴다 — 파일은 URL 로 못 넘기니까.
import Base from '../layouts/Base.astro';
import { altsFor, UI, prefix, type Lang } from '../i18n/ui';
import { JIGSAW } from '../i18n/jigsaw';
import { WORKS } from '../data/works';
import { icon } from '../lib/icons';
import Guide from './Guide.astro';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], P = prefix(lang), F = T.photo, J = JIGSAW[lang];
const PRESETS = [48, 100, 200, 300, 500, 1000], DEFAULT_N = 100;
const ld = { '@context': 'https://schema.org', '@type': 'HowTo', name: F.seoTitle, description: F.seoDesc, step: F.steps.map(([h, b], n) => ({ '@type': 'HowToStep', position: n + 1, name: h, text: b })) };
---
<Base title={`${F.seoTitle} · jigsawlab`} desc={F.seoDesc} lang={lang} alts={altsFor('/photo/')} path={`${P}/photo/`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <h1>{F.h1}</h1>
        <p class="lead">{F.lead}</p>
        <ol class="steps">{F.steps.map(([h, b]) => <li><b>{h}</b><span>{b}</span></li>)}</ol>
      </div>
      <div class="up-side">
        <label class="drop" id="ph-drop">
          <input type="file" id="ph-file" accept="image/*" hidden />
          <span class="ic" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="15" rx="3"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="m4 17 4.5-4.5a2 2 0 0 1 2.8 0L16 17"/><path d="m14 14 1.6-1.6a2 2 0 0 1 2.8 0L21 15"/></svg>
          </span>
          <b>{F.cta}</b>
          <small>{F.hint}</small>
        </label>
        <!-- 사진을 고르면 여기서 조각 수까지 정한다. 판으로 넘어가는 건 시작을 누른 뒤 한 번뿐 -->
        <div class="picked" id="ph-picked" hidden data-grid-tpl={F.gridTpl} data-fail={F.fail}>
          <div class="prev"><img id="ph-thumb" alt="" /><div><b>{J.myPhoto}</b><span class="grid-lbl" id="ph-grid">…</span></div></div>
          <p class="lbl">{J.pieces}</p>
          <div class="pieces" id="ph-pieces">{PRESETS.map((n) => <button type="button" data-n={n} class:list={[{ on: n === DEFAULT_N }]}>{n}</button>)}<input class="input custom" id="ph-custom" type="number" min="6" max="2000" placeholder={J.custom} /></div>
          <p class="xp-row"><a class="xp-tip" id="ph-xp" href={`${P}/rank/`} data-tpl={T.lv.earn('{n}')}></a></p>
          <div class="go"><button type="button" class="btn primary lg" id="ph-start" data-n={DEFAULT_N}>{J.start}</button><button type="button" class="btn lg" id="ph-together"><Fragment set:html={icon('users', 18)} /> {T.play.together}</button></div>
          <p class="muted together-sub">{T.play.togetherSub}</p>
          <button type="button" class="btn ghost sm" id="ph-reset">{F.another}</button>
        </div>
        <p class="safe">{F.safe}</p>
      </div>
    </div>
  </section>

  <Guide html={BODY[lang].photo} prefix="p" />

  <section class="sec"><div class="wrap end">
    <p>{T.catalog.all(WORKS.length)}</p>
    <a class="btn primary lg" href={`${P}/play/`}>{T.hero.pick}</a>
  </div></section>

  <style>
    .hero { background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
    .hero-in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding-top: clamp(40px, 6vw, 90px); padding-bottom: clamp(40px, 6vw, 80px); }
    @media (max-width: 900px) { .hero-in { grid-template-columns: 1fr; } .up-side { order: -1; } }
    .hero h1 { font-family: var(--brand); font-size: clamp(2.2rem, 5vw, 3.9rem); letter-spacing: -.03em; line-height: 1.08; white-space: pre-line; }
    .lead { margin: 18px 0 0; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--ink-2); max-width: 34em; }
    .steps { list-style: none; margin: 28px 0 0; padding: 20px 0 0; border-top: 1px solid var(--line); display: grid; gap: 14px; counter-reset: s; }
    .steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: baseline; counter-increment: s; }
    .steps li::before { content: counter(s); display: grid; place-items: center; width: 26px; height: 26px; border-radius: 9px; background: var(--ink); color: #fff; font-size: .8rem; font-weight: 800; }
    .steps b { display: block; } .steps span { color: var(--ink-2); font-size: .95rem; } .steps li > span { grid-column: 2; }
    .steps li b + span { display: block; margin-top: 2px; }

    .drop { display: grid; place-items: center; gap: 6px; padding: clamp(34px, 5vw, 56px) 24px; text-align: center; cursor: pointer; border: 2px dashed var(--line-2, rgba(15,18,34,.22)); border-radius: calc(var(--r) * 1.2); background: var(--bg); transition: border-color .2s var(--ease), background .2s var(--ease), transform .2s var(--ease); }
    .drop:hover, .drop.over { border-color: var(--ink); background: var(--bg-2); transform: translateY(-2px); }
    .drop[hidden] { display: none; } /* .drop 의 display:grid 가 [hidden] 을 이기므로 명시한다 */
    .drop .ic { color: var(--ink); opacity: .75; } .drop b { font-size: 1.15rem; } .drop small { color: var(--muted); }
    .safe { margin: 14px 2px 0; color: var(--muted); font-size: .88rem; line-height: 1.6; }

    .picked { padding: 22px; border-radius: calc(var(--r) * 1.2); background: var(--bg-2); border: 1px solid var(--line); }
    .prev { display: flex; gap: 14px; align-items: center; } .prev img { width: 92px; height: 74px; object-fit: cover; border-radius: 12px; background: var(--bg-3); }
    .prev b { display: block; } .grid-lbl { color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums; }
    .lbl { margin: 20px 0 10px; font-size: .8rem; font-weight: 700; color: var(--muted); }
    .pieces { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .pieces button { padding: 11px 0; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); font-weight: 700; font-variant-numeric: tabular-nums; cursor: pointer; transition: border-color .15s var(--ease), background .15s var(--ease); }
    .pieces button:hover { border-color: var(--ink); } .pieces button.on { background: var(--ink); color: #fff; border-color: var(--ink); }
    .pieces .custom { grid-column: span 2; text-align: center; }
    .xp-row { margin: 12px 0 0; }
    :global(html:not(.member)) .xp-row { display: none; }
    .go { display: flex; gap: 8px; margin-top: 18px; } .go .btn { flex: 1; } .go .btn :global(svg) { flex: none; }
    .together-sub { margin: 10px 2px 0; font-size: .85rem; }
    #ph-reset { margin-top: 12px; width: 100%; }
    @media (max-width: 460px) { .go { flex-direction: column; } }

    .end { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; } .end p { margin: 0; color: var(--ink-2); }
  </style>

  <script>
    import { images, hasIDB } from '../lib/db';
    import { gridFor } from '../lib/jigsaw';
    import { toast } from '../lib/share';
    import { docLang, prefix } from '../i18n/langs';
    const P = prefix(docLang());
    const $ = (id: string) => document.getElementById(id)!;
    const drop = $('ph-drop'), picked = $('ph-picked'), file = $('ph-file') as HTMLInputElement;
    const thumb = $('ph-thumb') as HTMLImageElement, grid = $('ph-grid'), startBtn = $('ph-start') as HTMLButtonElement;
    const togetherBtn = $('ph-together') as HTMLButtonElement;
    const custom = $('ph-custom') as HTMLInputElement, tpl = picked.dataset.gridTpl!, failMsg = picked.dataset.fail!;
    // IDB 가 없거나 사진을 못 읽는 드문 경우 — 넘길 데가 없으니 이 자리에서 알린다
    const bail = () => { toast(failMsg); startBtn.disabled = false; drop.hidden = false; picked.hidden = true; };

    let chosen: File | null = null, aspect = 1, wantN = Number(startBtn.dataset.n);
    // 내 사진은 배수가 없어 조각 수가 곧 XP
    const xpTip = $('ph-xp'), xpTpl = xpTip.dataset.tpl!;
    const showGrid = () => { const g = gridFor(wantN, aspect), n = g.cols * g.rows; grid.textContent = tpl.replace('{c}', String(g.cols)).replace('{r}', String(g.rows)).replace('{n}', String(n)); xpTip.textContent = xpTpl.replace('{n}', n.toLocaleString()); };

    async function pick(f: File) {
      if (!f.type.startsWith('image/') || !hasIDB()) return bail();
      let w = 0, h = 0;
      try {
        if ('createImageBitmap' in window) { const b = await createImageBitmap(f, { imageOrientation: 'from-image' } as any); w = b.width; h = b.height; b.close?.(); }
        else { const i = new Image(); i.src = URL.createObjectURL(f); await i.decode(); w = i.naturalWidth; h = i.naturalHeight; }
      } catch { return bail(); }
      if (!w || !h) return bail();
      chosen = f; aspect = w / h;
      thumb.src = URL.createObjectURL(f);
      drop.hidden = true; picked.hidden = false; showGrid();
      picked.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    file.addEventListener('change', () => { const f = file.files?.[0]; if (f) pick(f); });
    drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); const f = e.dataTransfer?.files?.[0]; if (f) pick(f); });

    $('ph-pieces').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      wantN = Number(b.dataset.n); custom.value = '';
      picked.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      showGrid();
    });
    custom.addEventListener('input', () => {
      const v = Number(custom.value); if (!(v >= 6 && v <= 2000)) return;
      wantN = v; picked.querySelectorAll('.pieces button').forEach((x) => x.classList.remove('on')); showGrid();
    });
    $('ph-reset').addEventListener('click', () => { chosen = null; file.value = ''; picked.hidden = true; drop.hidden = false; });

    // 파일은 URL 로 못 넘기니 IndexedDB 에 임시로 두고 id 만 넘긴다. n 이 함께 가니 판은 다이얼로그 없이 바로 열린다
    async function go(together: boolean) {
      if (!chosen) return;
      startBtn.disabled = true; togetherBtn.disabled = true;
      const id = `pending-${Date.now().toString(36)}`;
      try { await images.put(id, chosen); } catch { togetherBtn.disabled = false; return bail(); }
      location.href = `${P}/board/?photo=${id}&n=${wantN}${together ? '&together=1' : ''}`;
    }
    startBtn.addEventListener('click', () => go(false));
    togetherBtn.addEventListener('click', () => go(true));
  </script>
</Base>
