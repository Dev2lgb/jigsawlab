---
// 그림 상세 = 상자를 연 화면. 큰 상자 + 그림 이야기 + 조각 수 선택(→ /board/) + 같은 진열대의 다른 상자
import Base from '../layouts/Base.astro';
import Box from './Box.astro';
import { UI, LI, prefix, type Lang } from '../i18n/ui';
import { JIGSAW } from '../i18n/jigsaw';
import { WORK_BY_KEY, WORKS } from '../data/works';
import { CATEGORIES } from '../data/catalog';
import { icon } from '../lib/icons';
import { paintingFor } from '../lib/catalogView';
const { lang = 'ko', key } = Astro.props as { lang?: Lang; key: string };
const T = UI[lang], li = LI[lang], P = prefix(lang), J = JIGSAW[lang];
const p = WORK_BY_KEY[key]!, a = p, cat = CATEGORIES.find((c) => c.id === p.cat)!;
const title = p.title[li], artist = p.artist[li];
const PRESETS = [48, 100, 200, 300, 500, 1000];
const srcName = /artic\.edu/.test(p.source ?? '') ? T.detail.sources.aic : /wikimedia\.org/.test(p.source ?? '') ? T.detail.sources.commons : /nasa\.gov/.test(p.source ?? '') ? T.detail.sources.nasa : a.museum[li];
const sib = WORKS.filter((w) => w.cat === p.cat && w.key !== key); const i0 = Math.max(0, WORKS.filter((w) => w.cat === p.cat).findIndex((w) => w.key === key) - 3); const others = sib.slice(i0, i0 + 8).map((w) => paintingFor(w.key, lang)!);
const alts = { ko: `/puzzle/${key}/`, en: `/en/puzzle/${key}/`, ja: `/ja/puzzle/${key}/` };
const pageTitle = { ko: `${title} 직소 퍼즐 — ${artist} · jigsawlab`, en: `${title} jigsaw puzzle — ${artist} · jigsawlab`, ja: `${title} ジグソーパズル — ${artist} · jigsawlab` }[lang];
const ld = { '@context': 'https://schema.org', '@type': 'VisualArtwork', name: title, creator: { '@type': 'Person', name: artist }, dateCreated: p.year, image: new URL(`/jigsaw/${key}.webp`, Astro.site).toString(), description: a.about[li], ...(p.medium ? { artMedium: p.medium } : {}) };
---
<Base title={pageTitle} desc={a.about[li]} lang={lang} ogImage={`/jigsaw/o-${key}.jpg`} alts={alts} path={alts[lang]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  <div class="wrap detail">
    <p class="crumb"><a href={`${P}/#catalog`}>{T.detail.back}</a> <span>/</span> <span>{cat.name[li]}</span></p>
    <div class="detail-in">
      <div class="stage" data-reveal><Box p={{ key, title, artist, year: p.year }} big fav={false} /><div class="floor" aria-hidden="true"></div></div>
      <div class="info" data-reveal="1">
        <div class="t-row"><h1>{title}</h1><button type="button" class="fav fav-lg" data-fav={key} aria-pressed="false" aria-label={T.catalog.favAdd}>♡</button></div>
        <p class="by">{artist}</p>
        <dl class="meta"><div><dt>{T.detail.year}</dt><dd>{p.year}</dd></div><div><dt>{T.detail.museum}</dt><dd>{a.museum[li]}</dd></div>{p.medium && <div><dt>{T.detail.medium}</dt><dd>{p.medium}</dd></div>}</dl>
        <p class="about">{a.about[li]}</p>{p.source && <p class="src muted"><a href={p.source} rel="noopener">{T.detail.source} ({srcName})</a> · {p.license ?? 'CC0'}{p.credit && p.license?.startsWith('CC BY') && <> · {p.credit}</>}</p>}
        <a class="btn primary lg daily-cta" id="daily-cta" href={`${P}/board/?daily=1&k=${key}`} hidden>{T.hero.today} · {T.hero.pieces(48)} {T.detail.startDaily}</a>
        <h2 class="pick-h">{T.detail.pieces}</h2>
        <div class="presets" id="presets" role="radiogroup">{PRESETS.map((n) => <button type="button" class="preset" aria-pressed={n === 48 ? 'true' : 'false'} data-n={n}><b>{n}</b><small></small></button>)}</div>
        <p class="best muted" id="best" data-key={key}></p>
        <div class="go"><a class="btn primary lg" id="go-solo" href={`${P}/board/?k=${key}&n=48`}>{T.detail.start}</a><button type="button" class="btn lg" id="together" data-key={key}><Fragment set:html={icon('users', 18)} /> {T.play.together}</button></div>
        <p class="muted together-sub">{T.play.togetherSub}</p>
        <div class="fullload" id="fullload" role="status"><span class="spin"></span><p id="fullload-txt" data-creating={T.play.creating} data-opening={J.opening}>{J.opening}</p></div>
      </div>
    </div>
    {others.length > 0 && <section class="more"><h2 class="sec-h">{T.detail.more}</h2><div class="shelf-row">{others.map((o) => <Box p={o} href={`${P}/puzzle/${o.key}/`} />)}</div></section>}
  </div>
  <style>
    .detail { padding-top: 22px; }
    .crumb { margin: 0 0 22px; color: var(--muted); font-size: .92rem; font-weight: 600; } .crumb span { margin: 0 6px; }
    .detail-in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
    @media (max-width: 860px) { .detail-in { grid-template-columns: 1fr; gap: 26px; } }
    .stage { position: relative; padding: 30px 0 40px; display: flex; justify-content: center; }
    .stage :global(.box3d) { --w: clamp(300px, 36vw, 520px); --h: calc(var(--w) * .92); --d: 96px; } @media (max-width: 860px) { .stage :global(.box3d) { --w: min(440px, 78vw); --d: 72px; } }
    .stage :global(.box3d .bt small) { font-size: .95rem; } .stage :global(.box3d .bt b) { font-size: 1.3rem; } .stage :global(.box3d .bf .logo) { font-size: .9rem; } .stage :global(.box3d .bf small) { font-size: .9rem; } .stage :global(.box3d .side span) { font-size: .95rem; } .stage :global(.box3d img) { border-width: 3px; }
    .stage :global(.box3d .cube) { transform: rotateX(-8deg) rotateY(22deg); } .stage :global(.box3d:hover .cube) { transform: rotateX(-4deg) rotateY(8deg) translateY(-8px); }
    .t-row { display: flex; align-items: start; gap: 14px; } .t-row h1 { flex: 1; } .t-row :global(.fav) { position: static; opacity: 1; width: 48px; height: 48px; font-size: 1.5rem; flex: none; margin-top: 6px; }
    .info h1 { font-size: clamp(2rem, 4.2vw, 3.4rem); letter-spacing: -.04em; } .by { margin: 8px 0 0; color: var(--ink-2); font-size: 1.15rem; font-weight: 500; }
    .meta { display: flex; gap: 28px; margin: 18px 0 0; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); } .meta div { display: flex; flex-direction: column; } .meta dt { font-size: .8rem; color: var(--muted); font-weight: 600; } .meta dd { margin: 0; font-weight: 700; }
    .about { margin: 18px 0 0; color: var(--ink-2); line-height: 1.75; font-size: 1.05rem; } .src { margin: 8px 0 0; font-size: .82rem; } .src a { color: var(--muted); }
    .meta { flex-wrap: wrap; }
    .daily-cta { margin-top: 22px; width: 100%; } .daily-cta::before { content: '🔥'; }
    .pick-h { font-size: 1.05rem; font-weight: 700; margin: 28px 0 12px; }
    .presets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .preset { display: flex; flex-direction: column; align-items: center; padding: 14px 6px 10px; border: 1px solid var(--line-2); border-radius: 16px; background: var(--bg); color: var(--ink); cursor: pointer; font: inherit; transition: transform .2s var(--ease), box-shadow .2s, border-color .2s; } .preset:hover { border-color: var(--ink); transform: translateY(-3px); box-shadow: 0 14px 30px -16px rgba(15,18,34,.35); }
    .preset b { font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; } .preset small { color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; min-height: 1em; font-weight: 600; }
    .preset[aria-pressed="true"] { border-color: var(--ink); background: var(--ink); color: #fff; } .preset[aria-pressed="true"] small { color: rgba(255,255,255,.7); }
    .best { margin: 14px 0 0; font-size: .92rem; min-height: 1.4em; font-weight: 600; }
    .fullload { display: none; position: fixed; inset: 0; z-index: 200; background: var(--bg); flex-direction: column; align-items: center; justify-content: center; gap: 18px; color: var(--muted); } .fullload.on { display: flex; }
    .spin { width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--ink); animation: spin .8s linear infinite; } @keyframes spin { to { transform: rotate(360deg); } }
    .go { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; } #together { display: inline-flex; align-items: center; gap: 6px; } .together-sub { margin: 10px 0 0; font-size: .88rem; }
    .more { margin-top: clamp(40px, 6vw, 80px); } .more .shelf-row { --w: 210px; --h: 190px; --d: 44px; }
  </style>
  <script>
    import { gridFor, todayKST, dailyPick } from '../lib/jigsaw';
    import { DAILY_POOL } from '../data/works';
    import { initFavUI } from '../lib/fav';
    initFavUI();
    import { getBest } from '../lib/store';
    import { UI, type Lang } from '../i18n/ui';
    const hl = document.documentElement.lang, LANG = (hl === 'en' || hl === 'ja' ? hl : 'ko') as Lang, T = UI[LANG];
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const img = document.querySelector<HTMLImageElement>('.stage .box3d img')!, key = document.getElementById('best')!.dataset.key!;
    const fl = document.getElementById('fullload')!, flTxt = document.getElementById('fullload-txt')!;
    addEventListener('pageshow', () => { const b = document.getElementById('together') as HTMLButtonElement; b.disabled = false; fl.classList.remove('on'); });
    // 방을 만드는 곳은 여기와 Jigsaw.astro 두 곳뿐. host:<id> 는 /board/ 가 초대 안내를 띄울지 판단하는 표시(maybeInvite)
    document.getElementById('together')!.addEventListener('click', async (e) => { const b = e.currentTarget as HTMLButtonElement; const n = picked; b.disabled = true; flTxt.textContent = flTxt.dataset.creating!; fl.classList.add('on'); try { const r = await fetch('/api/room', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ key, n, lang: LANG }) }); const d = await r.json<any>(); if (d.id) { try { sessionStorage.setItem(`entered:${d.id}`, '1'); sessionStorage.setItem(`host:${d.id}`, '1'); } catch {} } if (d.id) location.href = `${LANG === 'ko' ? '' : '/' + LANG}/board/?room=${d.id}`; else throw 0; } catch { b.disabled = false; fl.classList.remove('on'); } });
    if (dailyPick(todayKST(), DAILY_POOL).painting.key === key) { const a = document.getElementById('daily-cta')!; a.hidden = false; if (new URLSearchParams(location.search).get('daily') === '1') { a.scrollIntoView({ block: 'center' }); history.replaceState(null, '', location.pathname); } }
    const P = LANG === 'ko' ? '' : `/${LANG}`; let picked = Number(localStorage.getItem('pieces') || 48) || 48; if (![48, 100, 200, 300, 500, 1000].includes(picked)) picked = 48;
    const solo = document.getElementById('go-solo') as HTMLAnchorElement; const bestEl = document.getElementById('best')!;
    // 시작 버튼에 손이 가면 /board/ 문서와 원본 이미지를 미리 받아 두고, 누르면 새 페이지가 뜨기 전에도 로딩 화면을 바로 보여 준다(/board/ 는 첫 페인트부터 같은 로딩 화면으로 이어짐)
    let warmed = false; const warm = () => { if (warmed) return; warmed = true; for (const [href, as] of [[`/jigsaw/${key}.webp`, 'image'], [`${P}/board/`, 'document']] as const) { const l = document.createElement('link'); l.rel = 'prefetch'; l.as = as; l.href = href; document.head.appendChild(l); } };
    for (const ev of ['pointerenter', 'touchstart', 'focus'] as const) solo.addEventListener(ev, warm, { passive: true });
    solo.addEventListener('click', (e) => { if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; flTxt.textContent = flTxt.dataset.opening!; fl.classList.add('on'); });
    const asp = () => (img.naturalWidth || 1200) / (img.naturalHeight || 950);
    const select = (n: number) => { picked = n; try { localStorage.setItem('pieces', String(n)); } catch {} document.querySelectorAll<HTMLButtonElement>('.preset').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.n) === n))); solo.href = `${P}/board/?k=${key}&n=${n}`; const g = gridFor(n, asp()); const b = getBest(`${key}:${g.cols * g.rows}`); bestEl.textContent = b ? T.detail.best(fmt(b)) : T.detail.noBest; };
    document.querySelectorAll<HTMLButtonElement>('.preset').forEach((b) => b.addEventListener('click', () => select(Number(b.dataset.n))));
    const fill = () => { document.querySelectorAll<HTMLButtonElement>('.preset').forEach((a) => { const g = gridFor(Number(a.dataset.n), asp()); a.querySelector('small')!.textContent = T.detail.gridOf(g.cols, g.rows); }); select(picked); };
    img.complete ? fill() : img.addEventListener('load', fill);
  </script>
</Base>
