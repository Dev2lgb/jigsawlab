---
import Base from '../layouts/Base.astro';
import { PAINTINGS } from '../lib/jigsaw';
import { JIGSAW } from '../i18n/jigsaw';
import { prefix, type Lang } from '../i18n/ui';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const li = ({ ko: 0, en: 1, ja: 2 } as const)[lang], P = prefix(lang), T = JIGSAW[lang];
import { parseShare } from '../lib/shareParams';
const { k, n, t, m, daily } = parseShare(Astro.url)!; // 페이지에서 검사·리다이렉트 완료
const pnt = PAINTINGS.find((p) => p.key === k)!;
const fmt = `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
const S = {
  ko: { h: daily ? '오늘의 퍼즐 기록' : '친구의 직소 퍼즐 기록', cmt: `${n}조각${m > 0 ? ` · ${m}번 놓아서 완성` : ''}`, cta: '나도 해보기', hand: daily ? '오늘의 퍼즐, 이 시간보다 빨리 맞출 수 있겠어?' : '같은 그림, 같은 조각 수로 도전해 볼래?', sub: t / n < 3 ? '⚡ 조각당 3초도 안 걸렸어요' : t / n < 8 ? '🔥 손이 빠르네요' : '🧩 차분하게 끝까지' },
  en: { h: daily ? "Today's puzzle record" : "A friend's jigsaw record", cmt: `${n} pieces${m > 0 ? ` · ${m} placements` : ''}`, cta: 'Try it myself', hand: daily ? "Today's puzzle — can you beat this time?" : 'Same painting, same piece count. Your turn?', sub: t / n < 3 ? '⚡ Under 3 seconds per piece' : t / n < 8 ? '🔥 Quick hands' : '🧩 Steady to the end' },
  ja: { h: daily ? '今日のパズル記録' : '友だちのジグソー記録', cmt: `${n}ピース${m > 0 ? ` · ${m}回置いて完成` : ''}`, cta: '自分もやってみる', hand: daily ? '今日のパズル、このタイムより速く解ける？' : '同じ絵・同じピース数で挑戦してみる？', sub: t / n < 3 ? '⚡ 1ピース3秒未満' : t / n < 8 ? '🔥 手が速い' : '🧩 落ち着いて最後まで' },
}[lang];
const title = daily ? T.shareDaily(n, fmt, pnt.title[li]) : T.shareTitle(n, fmt);
const desc = `${pnt.title[li]} — ${pnt.artist[li]} · ${S.cmt}`;
const ctaHref = daily ? `${P}/?d=1&k=${k}` : `${P}/?k=${k}&n=${n}`;
---
<Base title={title} desc={desc} lang={lang} ogImage={`/jigsaw/o-${k}.jpg`} noindex path={Astro.url.pathname + Astro.url.search}>
  <section class="scene page active share">
    <img class="pic" src={`/jigsaw/${k}.jpg`} alt={pnt.title[li]} width="1200" height="950" />
    <h1>{S.h}</h1>
    <p class="muted">{pnt.title[li]} — {pnt.artist[li]}</p>
    <div class="val">{fmt}</div>
    <p class="cmt">{S.cmt}</p>
    <p class="muted">{S.sub}</p>
    <p class="hand">{S.hand}</p>
    <a class="btn primary" href={ctaHref}>{S.cta}</a>
  </section>
  <style>
    .share { text-align: center; }
    .pic { display: block; width: min(80vw, 360px); height: auto; max-height: 360px; object-fit: contain; margin: 0 auto 18px; border-radius: 14px; border: 1px solid var(--line); background: var(--board); }
    h1 { font-size: 1.5rem; margin-bottom: 4px; } .val { font-size: 3rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--accent); margin: 8px 0 0; line-height: 1.1; } .cmt { margin: 4px 0; font-weight: 600; }
    .hand { margin: 22px 0 10px; }
  </style>
</Base>
