---
import Base from '../layouts/Base.astro';
import { altsFor, UI, prefix, type Lang } from '../i18n/ui';
import { BODY } from '../i18n/body';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], P = prefix(lang);
const body = BODY[lang].terms;
---
<Base title={`${T.foot.termsTitle} · jigsawlab`} desc={T.foot.termsTitle} lang={lang} alts={altsFor('/terms/')} path={`${P}/terms/`}>
  <section class="wrap doc seo"><h1>{T.foot.termsTitle}</h1><div set:html={body} /></section>
  <style>.doc { padding-top: clamp(24px, 4vw, 48px); } .doc h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 12px; letter-spacing: -.04em; }</style>
</Base>
