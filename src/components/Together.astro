---
// /together/ — 상설 공개 판 랜딩. 사이트가 굴리는 판 하나(방 id 는 늘 'live')를 보여 주고 그리로 들여보낸다.
// 유저가 만드는 방이 아니라서 "방 만들기"가 없고, 대신 지금 어떤 그림을 몇 %까지 맞췄는지를 첫 화면에 세운다 —
// 목록이 아니라 진행 중인 판 하나만 보여 주므로 접속자가 0명이어도 판은 살아 있어 보인다.
import Base from '../layouts/Base.astro';
import { UI, prefix, type Lang } from '../i18n/ui';
import { LIVE_ID } from '../lib/jigsaw';
import { WORKS } from '../data/works';
import { icon } from '../lib/icons';
const { lang = 'ko' } = Astro.props as { lang?: Lang };
const T = UI[lang], P = prefix(lang), L = T.live;
const board = `${P}/board/?room=${LIVE_ID}`;
/** 문구 안의 숫자 자리를 {n} 으로 남겨 data-* 로 넘긴다 (i18n 을 클라이언트 번들에 통째로 싣지 않으려고 — Photo.astro 와 같은 방식) */
const tpl = (f: (n: any) => string) => f('{n}');
const toc = [...L.body.matchAll(/<h2>(.*?)<\/h2>/g)].map((m, i) => ({ id: `t${i + 1}`, text: m[1] }));
let i = 0; const body = L.body.replace(/<h2>/g, () => `<h2 id="t${++i}">`);
const ld = { '@context': 'https://schema.org', '@type': 'HowTo', name: L.seoTitle, description: L.seoDesc, step: L.steps.map(([h, b], n) => ({ '@type': 'HowToStep', position: n + 1, name: h, text: b })) };
---
<Base title={`${L.seoTitle} · jigsawlab`} desc={L.seoDesc} lang={lang} alts={{ ko: '/together/', en: '/en/together/', ja: '/ja/together/' }} path={`${P}/together/`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />

  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <h1>{L.h1}</h1>
        <p class="lead">{L.lead}</p>
        <ol class="steps">{L.steps.map(([h, b]) => <li><b>{h}</b><span>{b}</span></li>)}</ol>
      </div>
      <div class="lv-side">
        <div class="lv-card" id="lv-card" data-board={board}
          data-t-pct={tpl(L.pct)} data-t-left={tpl(L.left)} data-t-online={tpl(L.online)} data-t-round={tpl(L.round)}
          data-t-alone={L.alone} data-t-offline={L.offline} data-t-cta={L.cta}>
          <p class="lv-top"><span class="lv-badge">{L.badge}</span><span class="lv-round" id="lv-round"></span></p>
          <a class="lv-art" href={board} aria-label={L.cta}><img id="lv-img" alt="" decoding="async" /></a>
          <p class="lv-now">{L.now}</p>
          <p class="lv-name"><b id="lv-title">{L.loading}</b><span id="lv-artist"></span></p>
          <div class="lv-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="lv-bar"><i id="lv-fill"></i></div>
          <p class="lv-meta"><b id="lv-pct"></b><span id="lv-left"></span></p>
          <p class="lv-online" id="lv-online">&nbsp;</p>
          <a class="btn primary lg lv-cta" href={board} id="lv-cta"><Fragment set:html={icon('users', 18)} /> <span>{L.ctaFirst}</span></a>
          <p class="xp-row"><a class="xp-tip" href={`${P}/rank/`}>{T.lv.earnLive}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec"><div class="wrap guide">
    <nav class="toc" aria-label="guide">{toc.map((t) => <a href={`#${t.id}`}>{t.text}</a>)}</nav>
    <article class="seo body" set:html={body} />
  </div></section>

  <section class="sec"><div class="wrap end">
    <p>{T.catalog.all(WORKS.length)}</p>
    <a class="btn primary lg" href={`${P}/play/`}>{T.hero.pick}</a>
  </div></section>

  <style>
    .hero { background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
    .hero-in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding-top: clamp(40px, 6vw, 90px); padding-bottom: clamp(40px, 6vw, 80px); }
    @media (max-width: 900px) { .hero-in { grid-template-columns: 1fr; } .lv-side { order: -1; } }
    .hero h1 { font-family: var(--brand); font-size: clamp(2.2rem, 5vw, 3.9rem); letter-spacing: -.03em; line-height: 1.08; white-space: pre-line; }
    .lead { margin: 18px 0 0; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--ink-2); max-width: 34em; }
    .steps { list-style: none; margin: 28px 0 0; padding: 20px 0 0; border-top: 1px solid var(--line); display: grid; gap: 14px; counter-reset: s; }
    .steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: baseline; counter-increment: s; }
    .steps li::before { content: counter(s); display: grid; place-items: center; width: 26px; height: 26px; border-radius: 9px; background: var(--ink); color: #fff; font-size: .8rem; font-weight: 800; }
    .steps b { display: block; } .steps span { color: var(--ink-2); font-size: .95rem; } .steps li > span { grid-column: 2; }
    .steps li b + span { display: block; margin-top: 2px; }
    .lv-card { padding: 18px; border-radius: var(--r); background: var(--bg-2); border: 1px solid var(--line); }
    .lv-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 12px; }
    .lv-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: var(--accent); color: #fff; font-size: .78rem; font-weight: 800; }
    .lv-badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: lv-pulse 1.8s ease-in-out infinite; }
    @keyframes lv-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
    .lv-round { color: var(--muted); font-size: .82rem; font-weight: 700; }
    /* 그림이 오기 전에도 자리를 잡아 두어 카드가 튀지 않게 한다 */
    .lv-art { display: block; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: var(--board, #e9e6df); }
    .lv-art img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s var(--ease); }
    .lv-art img.on { opacity: 1; }
    .lv-now { margin: 12px 0 2px; color: var(--muted); font-size: .78rem; font-weight: 700; letter-spacing: .02em; }
    .lv-name { margin: 0 0 12px; display: flex; flex-direction: column; gap: 2px; min-height: 2.6em; }
    .lv-name b { font-size: 1.05rem; letter-spacing: -.02em; }
    .lv-name span { color: var(--muted); font-size: .85rem; }
    .lv-bar { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; }
    .lv-bar i { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--accent); transition: width .6s var(--ease); }
    .lv-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin: 8px 0 0; }
    .lv-meta b { font-size: 1.5rem; font-weight: 800; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .lv-meta span { color: var(--muted); font-size: .85rem; font-weight: 600; }
    .lv-online { margin: 6px 0 14px; color: var(--muted); font-size: .85rem; font-weight: 600; min-height: 1.3em; }
    .lv-card[data-live] .lv-online { color: var(--accent); }
    .lv-cta { width: 100%; justify-content: center; }
    .xp-row { margin: 10px 0 0; text-align: center; } :global(html:not(.member)) .xp-row { display: none; }

    .guide { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
    .toc { position: sticky; top: calc(var(--top-h) + 24px); display: flex; flex-direction: column; gap: 2px; }
    .toc a { color: var(--ink-2); font-size: .92rem; font-weight: 600; padding: 7px 12px; border-radius: 10px; } .toc a:hover { background: var(--bg-3); text-decoration: none; color: var(--ink); }
    .body :global(h2) { margin-top: 0; scroll-margin-top: calc(var(--top-h) + 20px); } .body :global(h2 + p) { margin-top: 8px; }
    .body :global(h2:not(:first-of-type)) { margin-top: 44px; padding-top: 32px; border-top: 1px solid var(--line); }
    .body :global(p) { max-width: 72ch; }
    @media (max-width: 860px) { .guide { grid-template-columns: 1fr; } .toc { position: static; flex-direction: row; flex-wrap: wrap; gap: 6px; } .toc a { background: var(--bg-2); } }
    .end { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; } .end p { margin: 0; color: var(--ink-2); }
  </style>

  <script>
    // 판 상태는 /api/live 에서 받는다 (서버가 방 정보에 그림 제목까지 얹어 준다). 못 받아도 카드와 CTA 는 그대로 두고 들여보낸다
    const card = document.getElementById('lv-card')!;
    const $ = (id: string) => document.getElementById(id)!;
    const fill = (s: string, n: number) => s.replace('{n}', String(n));
    const LI = ({ ko: 0, en: 1, ja: 2 } as Record<string, number>)[document.documentElement.lang] ?? 0;
    fetch('/api/live', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json<any>() : null))
      .then((d) => {
        if (!d || !d.total) throw 0;
        const pct = Math.min(100, Math.floor((d.locked / d.total) * 100));
        const w = d.work;
        if (w) { const im = $('lv-img') as HTMLImageElement; im.src = `/jigsaw/t-${w.key}.webp`; im.alt = w.title[LI]; im.addEventListener('load', () => im.classList.add('on'), { once: true }); if (im.complete) im.classList.add('on'); }
        $('lv-title').textContent = w ? w.title[LI] : '';
        $('lv-artist').textContent = w ? [w.artist[LI], w.year].filter(Boolean).join(' · ') : '';
        $('lv-round').textContent = fill(card.dataset.tRound!, (d.round ?? 0) + 1);
        ($('lv-fill') as HTMLElement).style.width = `${pct}%`;
        $('lv-bar').setAttribute('aria-valuenow', String(pct));
        $('lv-pct').textContent = fill(card.dataset.tPct!, pct);
        $('lv-left').textContent = fill(card.dataset.tLeft!, d.total - d.locked);
        $('lv-online').textContent = d.players > 0 ? fill(card.dataset.tOnline!, d.players) : card.dataset.tAlone!;
        if (d.players > 0) card.dataset.live = '1';
        // 이미 진행 중인 판이면 '이어서 맞추기'
        if (d.locked > 0) $('lv-cta').querySelector('span')!.textContent = card.dataset.tCta!;
      })
      .catch(() => { $('lv-title').textContent = card.dataset.tOffline!; $('lv-online').textContent = ''; });
  </script>
</Base>
