---
// 공통 틀 — 화면 전체 폭, Pretendard, 큰 라운드·부드러운 그림자, 스크롤 리빌, 3D 퍼즐 상자 공통 스타일
import { UI, LANGS, prefix, type Lang } from '../i18n/ui';
interface Props { title: string; desc: string; lang?: Lang; ogImage?: string; alts?: Partial<Record<Lang, string>>; noindex?: boolean; path?: string }
const { title, desc, lang = 'ko', ogImage = '/og.png', alts, noindex = false, path = Astro.url.pathname } = Astro.props;
const T = UI[lang], P = prefix(lang), site = Astro.site ?? new URL('https://jigsawlab.app');
const canonical = new URL(path, site).toString();
const fontCss = lang === 'ja' ? 'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-jp-dynamic-subset.min.css' : 'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css';
const nav = [
  { href: `${P}/play/?daily=1`, label: T.nav.daily },
  { href: `${P}/play/`, label: T.nav.catalog },
  { href: `${P}/play/?photo=1`, label: T.nav.photo },
  { href: `${P}/my/`, label: T.nav.my },
  { href: `${P}/about/`, label: T.nav.about },
];
const langPath = Astro.url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta name="naver-site-verification" content="1f5678d3427f33062b2e0426990b2f01daab34a7" />
  {noindex && <meta name="robots" content="noindex" />}
  {alts && Object.entries(alts).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, site).toString()} />)}
  {alts?.ko && <link rel="alternate" hreflang="x-default" href={new URL(alts.ko, site).toString()} />}
  <meta property="og:type" content="website" /><meta property="og:site_name" content="jigsawlab" />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site).toString()} /><meta property="og:locale" content={{ ko: 'ko_KR', en: 'en_US', ja: 'ja_JP' }[lang]} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={desc} /><meta name="twitter:image" content={new URL(ogImage, site).toString()} />
  {path === '/' || path === '/en/' || path === '/ja/' ? <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'jigsawlab', url: site.toString(), inLanguage: lang, description: desc })} /> : null}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="preload" href="/fonts/BMHANNAPro.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href={fontCss} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@800&display=swap" />
  <slot name="head" />
  <script is:inline define:vars={{ i18n: { copied: T.foot.copied, shareFail: T.foot.shareFail } }}>window.__i18n = i18n;</script>
</head>
<body>
  <header class="top" id="top">
    <a class="mark" href={`${P}/`} aria-label="jigsawlab">jigsawlab</a>
    <nav class="nav" aria-label="main">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    <div class="right">
      <div class="langs" role="group" aria-label="language">{LANGS.map((l) => <a href={`${prefix(l)}${langPath}`} aria-current={l === lang ? 'page' : undefined} lang={l} data-lang={l}>{l.toUpperCase()}</a>)}</div>
      <a class="btn primary sm play-btn" href={`${P}/play/`}>{T.nav.play}</a>
      <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="menu"><span></span><span></span><span></span></button>
    </div>
  </header>
  <div class="menu" id="menu" hidden>
    <div class="menu-bg" id="menu-bg"></div>
    <nav class="menu-sheet" aria-label="menu">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="btn primary" href={`${P}/play/`}>{T.nav.play}</a>
      <div class="menu-langs">{LANGS.map((l) => <a href={`${prefix(l)}${langPath}`} aria-current={l === lang ? 'page' : undefined} lang={l} data-lang={l}>{UI[l].langName}</a>)}</div>
    </nav>
  </div>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-brand"><span class="mark-text">jigsawlab</span><p>{T.tagline}</p></div>
      <div class="foot-links">
        <a href={`${P}/play/?daily=1`}>{T.nav.daily}</a>
        <a href={`${P}/play/`}>{T.nav.catalog}</a>
        <a href={`${P}/play/?photo=1`}>{T.nav.photo}</a>
        <a href={`${P}/my/`}>{T.nav.my}</a>
        <a href={`${P}/about/`}>{T.nav.about}</a>
        <a href={`${P}/contact/`}>{T.foot.contact}</a>
        <a href={`${P}/terms/`}>{T.foot.terms}</a>
        <a href={`${P}/privacy/`}>{T.foot.privacy}</a>
      </div>
      <div class="foot-meta"><span>{T.foot.rights}</span><a href={`${P}/contact/`}>{T.foot.contact}</a><span>© 2026 jigsawlab</span></div>
    </div>
  </footer>
  <script>
    // 스크롤 리빌: [data-reveal] 요소가 화면에 들어오면 .in — 모션 최소화 설정이면 즉시 표시
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('in'));
    else { const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }); els.forEach((e) => io.observe(e)); }
    const top = document.getElementById('top')!; const onS = () => top.classList.toggle('scrolled', scrollY > 8); onS(); addEventListener('scroll', onS, { passive: true });
    // 모바일 메뉴
    const mb = document.getElementById('menu-btn')!, menu = document.getElementById('menu')!;
    const setMenu = (o: boolean) => { menu.hidden = !o; mb.setAttribute('aria-expanded', String(o)); document.documentElement.style.overflow = o ? 'hidden' : ''; };
    mb.addEventListener('click', () => setMenu(menu.hidden)); document.getElementById('menu-bg')!.addEventListener('click', () => setMenu(false)); addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
    // 언어: 직접 고르면 기억, 첫 방문이면 브라우저 언어로
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang!); } catch {} }));
    try { const pageLang = document.documentElement.lang, saved = localStorage.getItem('lang'); const want = saved || (navigator.language || '').slice(0, 2); if (['ko', 'en', 'ja'].includes(want) && want !== pageLang && !saved) { localStorage.setItem('lang', want); const path = location.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/'; location.replace((want === 'ko' ? '' : '/' + want) + path + location.search); } } catch {}
  </script>
</body>
</html>

<style is:global>
  /* 한나체는 한글·영문·숫자만. 기호(·, ×, ♡ 등)는 글리프가 비어 있어 프리텐다드로 */
  @font-face { font-family: 'BM HANNA Pro'; src: url('/fonts/BMHANNAPro.woff2') format('woff2'); font-weight: 100 900; font-display: swap; unicode-range: U+0020-007E, U+1100-11FF, U+3131-318E, U+AC00-D7A3; }
  :root {
    --bg: #ffffff; --bg-2: #f5f6f8; --bg-3: #eceef2; --board: #e6e8ee; --ink: #0f1222; --ink-2: #3a3f55; --muted: #6b7188; --line: #e3e6ec; --line-2: #d2d6df;
    --accent: #14172a; --accent-deep: #000000; --accent-soft: #eceef2; --accent-glow: rgba(15,18,34,.35); --gold: #f0a71b; --gold-soft: #fff4dc;
    --box: #f7f2e7; --box-2: #eee6d3; --box-3: #d9cfb5; --box-frame: #b08d55;
    --hd: 64px; --hd-gap: 12px; --top-h: calc(var(--hd) + var(--hd-gap)); --r: 24px; --r-sm: 14px; --max: 1440px; --gutter: clamp(20px, 4vw, 64px);
    --font: 'Pretendard Variable', Pretendard, 'Apple SD Gothic Neo', 'Noto Sans KR', system-ui, sans-serif;
    --head: 'BM HANNA Pro', 'Pretendard Variable', Pretendard, 'Apple SD Gothic Neo', 'Noto Sans KR', system-ui, sans-serif;
    --brand: 'Syne', var(--font);
    --ease: cubic-bezier(.2, .8, .2, 1);
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 16px; line-height: 1.6; min-height: 100dvh; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  a { color: var(--ink); text-decoration: none; } a:hover { text-decoration: underline; }
  button, input { font: inherit; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
  h1, h2, h3 { margin: 0; line-height: 1.15; letter-spacing: -0.01em; font-weight: 800; font-family: var(--head); }
  .seo h3, .field label { font-family: var(--font); }
  img { max-width: 100%; }
  html[data-play="on"] { overflow: hidden; } html[data-play="on"] .foot { display: none; }
  .wrap { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }

  /* 헤더 */
  .top { height: calc(var(--hd) + var(--hd-gap)); display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 28px; padding: var(--hd-gap) max(var(--gutter), calc((100% - var(--max)) / 2)) 0; position: sticky; top: 0; z-index: 20; }
  .top::before { content: ''; position: absolute; z-index: -1; left: 0; right: 0; top: 0; bottom: 0; background: rgba(255,255,255,.72); backdrop-filter: saturate(1.5) blur(16px); -webkit-backdrop-filter: saturate(1.5) blur(16px); border-radius: 0; box-shadow: 0 0 0 0 rgba(15,18,34,0); border: 1px solid transparent; transition: left .5s var(--ease), right .5s var(--ease), top .5s var(--ease), border-radius .5s var(--ease), box-shadow .5s var(--ease), background .5s, border-color .5s; }
  .top.scrolled::before { left: calc(max(var(--gutter), (100% - var(--max)) / 2) - 18px); right: calc(max(var(--gutter), (100% - var(--max)) / 2) - 18px); top: var(--hd-gap); border-radius: 22px; background: rgba(255,255,255,.82); border-color: rgba(255,255,255,.9); box-shadow: 0 18px 40px -20px rgba(15,18,34,.4), 0 1px 2px rgba(15,18,34,.08); }
  #main > :first-child { margin-top: calc((var(--hd) + var(--hd-gap)) * -1); padding-top: calc(var(--hd) + var(--hd-gap) + clamp(20px, 3vw, 40px)); }
  .mark { display: inline-flex; align-items: center; color: var(--ink); font-family: var(--brand); font-weight: 800; font-size: 1.45rem; letter-spacing: -0.02em; line-height: 1; } .mark:hover { text-decoration: none; }
  .nav { display: flex; gap: 2px; justify-self: center; } .nav a { color: var(--ink-2); font-weight: 600; font-size: .95rem; padding: 9px 14px; border-radius: 999px; transition: background .15s, color .15s; } .nav a:hover { background: var(--bg-3); text-decoration: none; color: var(--ink); }
  .right { display: flex; align-items: center; gap: 10px; }
  .langs { display: flex; padding: 3px; border-radius: 999px; background: var(--bg-3); } .langs a { color: var(--muted); font-size: .74rem; font-weight: 700; padding: 5px 9px; border-radius: 999px; letter-spacing: .02em; } .langs a[aria-current] { color: var(--ink); background: var(--bg); box-shadow: 0 1px 3px rgba(15,18,34,.15); } .langs a:hover { text-decoration: none; color: var(--ink); }
  .menu-btn { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 5px; } .menu-btn span { display: block; width: 18px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s var(--ease), opacity .2s; }
  .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); } .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; } .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .menu { position: fixed; inset: 0; z-index: 19; } .menu-bg { position: absolute; inset: 0; background: rgba(15,18,34,.35); }
  .menu-sheet { position: absolute; left: var(--gutter); right: var(--gutter); top: calc(var(--hd) + var(--hd-gap) + 8px); border-radius: 22px; background: var(--bg); padding: 12px 20px 24px; display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(15,18,34,.5); animation: sheet .25s var(--ease); }
  @keyframes sheet { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
  .menu-sheet > a:not(.btn) { padding: 14px 6px; font-size: 1.15rem; font-weight: 700; border-bottom: 1px solid var(--line-soft); } .menu-sheet .btn { margin-top: 14px; }
  .menu-langs { display: flex; gap: 6px; margin-top: 16px; } .menu-langs a { padding: 6px 12px; border-radius: 999px; background: var(--bg-3); font-size: .85rem; font-weight: 600; color: var(--muted); } .menu-langs a[aria-current] { background: var(--ink); color: #fff; }
  @media (max-width: 860px) { :root { --hd: 56px; --hd-gap: 10px; } .top { grid-template-columns: auto 1fr; gap: 12px; } .top.scrolled::before { border-radius: 18px; left: calc(var(--gutter) - 10px); right: calc(var(--gutter) - 10px); } .nav { display: none; } .right { justify-self: end; } .langs { display: none; } .menu-btn { display: flex; width: 40px; height: 40px; } }
  @media (min-width: 861px) { .menu { display: none !important; } }
  @media (max-width: 640px) { html[data-play="on"] .top { display: none; } html[data-play="on"] { --top-h: 0px; } .top .play-btn { display: none; } }
  #main { flex: 1; display: flex; flex-direction: column; }

  /* 푸터 */
  .foot { background: var(--ink); color: #c9cde0; margin-top: 90px; }
  .foot-in { padding-top: 56px; padding-bottom: 56px; display: grid; gap: 28px; grid-template-columns: 1.2fr 1fr; }
  .mark-text { display: inline-flex; align-items: center; color: #fff; font-family: var(--brand); font-weight: 800; font-size: 1.4rem; letter-spacing: -0.02em; } .foot-brand p { margin: 8px 0 0; color: #9aa0bd; font-size: 1rem; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 22px; align-content: start; justify-content: end; } .foot-links a { color: #dfe2f0; font-weight: 600; font-size: .95rem; }
  .foot-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 22px; color: #8189a8; font-size: .82rem; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.1); } .foot-meta a { color: #8189a8; }
  @media (max-width: 640px) { .foot-in { grid-template-columns: 1fr; } .foot-links { justify-content: start; } }

  /* 섹션 공통 */
  .sec { padding: clamp(56px, 8vw, 110px) 0 0; } .sec-h { font-size: clamp(1.7rem, 3.4vw, 2.6rem); margin: 0 0 10px; } .sec-sub { margin: 0 0 30px; color: var(--muted); font-size: 1.08rem; max-width: 46em; }
  .sec-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 26px; } .sec-head .sec-sub { margin: 0; }

  /* 리빌 */
  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s var(--ease), transform .7s var(--ease); } [data-reveal].in { opacity: 1; transform: none; }
  [data-reveal="1"] { transition-delay: .08s; } [data-reveal="2"] { transition-delay: .16s; } [data-reveal="3"] { transition-delay: .24s; }

  /* 장면 (플레이 앱) */
  .scene { display: none; } .scene.active { display: block; }
  .scene.page { width: 100%; max-width: var(--max); margin: 0 auto; padding: 28px var(--gutter) 40px; }
  .scene.play { position: fixed; left: 0; right: 0; bottom: 0; top: var(--top-h); background: var(--board); z-index: 10; }

  /* 부품 */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 8px 22px; border-radius: 999px; border: 1px solid var(--line-2); background: var(--bg); color: var(--ink); font-weight: 700; cursor: pointer; transition: transform .15s var(--ease), box-shadow .2s, background .15s; white-space: nowrap; }
  .btn:hover { background: var(--bg-2); text-decoration: none; transform: translateY(-1px); } .btn:active { transform: translateY(0); }
  .btn.primary { background: var(--ink); border-color: var(--ink); color: #fff; box-shadow: 0 10px 24px -12px rgba(15,18,34,.6); } .btn.primary:hover { background: #000; box-shadow: 0 14px 30px -12px rgba(15,18,34,.6); }
  .btn.ghost { background: transparent; border-color: transparent; } .btn.ghost:hover { background: var(--bg-3); }
  .btn.lg { min-height: 58px; padding: 12px 30px; font-size: 1.08rem; } .btn.sm { min-height: 38px; padding: 4px 16px; font-size: .9rem; }
  .card { background: var(--bg); border: 1px solid var(--line); border-radius: var(--r); padding: 24px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); font-size: .85rem; font-weight: 600; white-space: nowrap; }
  .input { width: 100%; min-height: 46px; padding: 8px 14px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--bg); color: var(--ink); font-size: 16px; } .input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 4px var(--accent-soft); }
  .field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: 4px; }
  .muted { color: var(--muted); }
  .toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 12px); background: var(--ink); color: #fff; padding: 12px 18px; border-radius: 999px; font-size: .92rem; font-weight: 600; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s var(--ease); z-index: 50; box-shadow: 0 16px 40px -12px rgba(15,18,34,.5); } .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .lb { list-style: none; margin: 0; padding: 0; } .lb li { display: flex; align-items: center; gap: 14px; padding: 12px 0; border-top: 1px solid var(--line); } .lb li:first-child { border-top: 0; } .lb li.empty { color: var(--muted); padding: 6px 0; }
  .lb .rank { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-3); color: var(--ink-2); font-weight: 800; font-size: .85rem; font-variant-numeric: tabular-nums; flex: none; } .lb li:nth-child(1) .rank { background: var(--gold); color: #fff; } .lb li:nth-child(2) .rank { background: #c9ced9; color: #fff; } .lb li:nth-child(3) .rank { background: #d8a880; color: #fff; }
  .lb .nick { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; } .lb .score { font-weight: 800; font-variant-numeric: tabular-nums; } .lb .score small { color: var(--muted); font-weight: 500; }

  /* 3D 퍼즐 상자 — --w/--h/--d 로 크기. 앞면·왼쪽 옆면·윗면 세 면을 가진 큐브, 호버하면 정면으로 돌아옴 */
  .box3d { --w: 200px; --h: 180px; --d: 40px; position: relative; display: block; width: calc(var(--w) + var(--d) * .55); height: calc(var(--h) + var(--d) * .7); color: var(--ink); text-decoration: none; perspective: 1100px; perspective-origin: 35% 35%; -webkit-tap-highlight-color: transparent; border: 0; background: none; padding: 0; cursor: pointer; text-align: left; font: inherit; flex: none; }
  .box3d:hover { text-decoration: none; }
  .box3d .cube { position: absolute; left: calc(var(--d) * .55); top: calc(var(--d) * .4); width: var(--w); height: var(--h); transform-style: preserve-3d; transform: rotateX(-9deg) rotateY(26deg); transition: transform .65s var(--ease); }
  .box3d:hover .cube, .box3d.on .cube { transform: rotateX(-4deg) rotateY(10deg) translateY(-10px); }
  .box3d .face { position: absolute; backface-visibility: hidden; }
  .box3d .front { left: 0; top: 0; width: var(--w); height: var(--h); transform: translateZ(calc(var(--d) / 2)); background: linear-gradient(160deg, #fdfaf3, var(--box) 60%, var(--box-2)); border-radius: 3px; padding: 6% 6% 5%; display: flex; flex-direction: column; box-shadow: inset 0 0 0 1px rgba(255,255,255,.6); }
