---
// 공통 틀: 라이트 종이 바탕, 코발트 한 가지 강조색, IBM Plex Sans KR. 헤더는 워드마크 + 언어 전환만
import { UI, LANGS, prefix, type Lang } from '../i18n/ui';
interface Props { title: string; desc: string; lang?: Lang; ogImage?: string; alts?: Partial<Record<Lang, string>>; noindex?: boolean; path?: string }
const { title, desc, lang = 'ko', ogImage = '/og.png', alts, noindex = false, path = Astro.url.pathname } = Astro.props;
const T = UI[lang], site = Astro.site ?? new URL('https://jigsawlab.app');
const canonical = new URL(path, site).toString();
const fontFam = lang === 'ja' ? 'IBM+Plex+Sans+JP:wght@400;600;700' : 'IBM+Plex+Sans+KR:wght@400;600;700';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {alts && Object.entries(alts).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, site).toString()} />)}
  {alts?.ko && <link rel="alternate" hreflang="x-default" href={new URL(alts.ko, site).toString()} />}
  <meta property="og:type" content="website" /><meta property="og:site_name" content="jigsawlab" />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site).toString()} /><meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f4f5f8" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${fontFam}&display=swap`} />
  <slot name="head" />
  <script is:inline define:vars={{ i18n: { copied: T.copied, shareFail: T.shareFail } }}>window.__i18n = i18n;</script>
</head>
<body>
  <header class="top">
    <a class="mark" href={`${prefix(lang)}/`} aria-label="jigsawlab">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><path d="M4 4h7.2a3 3 0 1 1 3.6 0H22v7.2a3 3 0 1 0 0 3.6V22h-7.2a3 3 0 1 1-3.6 0H4v-7.2a3 3 0 1 0 0-3.6z" fill="currentColor"/></svg>
      <span>jigsawlab</span>
    </a>
    <nav class="langs" aria-label="language">
      {LANGS.map((l) => <a href={`${prefix(l)}/`} aria-current={l === lang ? 'page' : undefined}>{UI[l].langName}</a>)}
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <span>© 2026 jigsawlab</span>
    <a href={`${prefix(lang)}/privacy/`}>{T.privacy}</a>
    <a href="https://cantong.app" rel="noopener">{T.madeBy}</a>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --paper: #f4f5f8; --board: #e7e9ef; --white: #fff; --ink: #171a24; --muted: #5c6273; --line: #d3d7e0; --line-soft: #e4e7ee;
    --accent: #2748e6; --accent-deep: #1c37bf; --accent-soft: #e6ebfd; --gold: #e9a820; --gold-soft: #fff4d6;
    --top-h: 56px; --radius: 14px; --font: 'IBM Plex Sans KR', 'IBM Plex Sans JP', 'Apple SD Gothic Neo', 'Noto Sans KR', system-ui, sans-serif;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font); font-size: 16px; line-height: 1.55; min-height: 100dvh; display: flex; flex-direction: column; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  button, input { font: inherit; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  h1, h2, h3 { margin: 0; line-height: 1.2; letter-spacing: -0.01em; }
  img { max-width: 100%; }
  html[data-play="on"] { overflow: hidden; } html[data-play="on"] .foot { display: none; }

  .top { height: var(--top-h); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid var(--line-soft); background: var(--paper); position: sticky; top: 0; z-index: 20; }
  .mark { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.02em; } .mark svg { color: var(--accent); } .mark:hover { text-decoration: none; }
  .langs { display: flex; gap: 4px; } .langs a { color: var(--muted); font-size: .85rem; padding: 6px 8px; border-radius: 8px; } .langs a[aria-current] { color: var(--ink); background: var(--white); box-shadow: inset 0 0 0 1px var(--line); } .langs a:hover { text-decoration: none; color: var(--ink); }
  @media (max-width: 640px) { html[data-play="on"] .top { display: none; } html[data-play="on"] { --top-h: 0px; } }
  #main { flex: 1; display: flex; flex-direction: column; }
  .foot { display: flex; gap: 18px; flex-wrap: wrap; justify-content: center; padding: 28px 20px 40px; color: var(--muted); font-size: .85rem; } .foot a { color: var(--muted); }

  /* 장면 */
  .scene { display: none; } .scene.active { display: block; }
  .scene.page { width: 100%; max-width: 760px; margin: 0 auto; padding: 28px 20px 40px; }
  .scene.play { position: fixed; left: 0; right: 0; bottom: 0; top: var(--top-h); background: var(--board); }
  .scene.play.active { display: block; }

  /* 부품 */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 8px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink); font-weight: 600; cursor: pointer; transition: background .12s, transform .08s; }
  .btn:hover { background: #fafbfd; text-decoration: none; } .btn:active { transform: translateY(1px); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; } .btn.primary:hover { background: var(--accent-deep); }
  .btn.sm { min-height: 36px; padding: 4px 14px; font-size: .9rem; }
  .card { background: var(--white); border: 1px solid var(--line-soft); border-radius: var(--radius); padding: 18px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: var(--white); border: 1px solid var(--line-soft); font-size: .85rem; font-weight: 600; }
  .input { width: 100%; min-height: 44px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); font-size: 16px; } .input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
  .field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: 4px; }
  .muted { color: var(--muted); }
  .toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 12px); background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 999px; font-size: .9rem; opacity: 0; pointer-events: none; transition: opacity .18s, transform .18s; z-index: 50; } .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .seo { max-width: 760px; margin: 0 auto; padding: 8px 20px 24px; color: var(--ink); } .seo h2 { font-size: 1.25rem; margin: 28px 0 8px; } .seo h3 { font-size: 1.02rem; margin: 18px 0 4px; } .seo p, .seo li { color: #363b4a; } .seo .lead { font-size: 1.05rem; } .seo ol, .seo ul { padding-left: 20px; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>
