---
// 공통 틀 — 화면 전체 폭, Pretendard, 큰 라운드·부드러운 그림자, 스크롤 리빌, 3D 퍼즐 상자 공통 스타일
import { icon } from '../lib/icons';
import { OG_LOCALE, UI, LANGS, prefix, stripLang, type Lang } from '../i18n/ui';
interface Props { title: string; desc: string; lang?: Lang; ogImage?: string; alts?: Partial<Record<Lang, string>>; noindex?: boolean; path?: string; ads?: boolean }
const { title, desc, lang = 'ko', ogImage = '/og.png', alts, noindex = false, path = Astro.url.pathname, ads = true } = Astro.props;
const T = UI[lang], P = prefix(lang), site = Astro.site ?? new URL('https://jigsawlab.app');
const canonical = new URL(path, site).toString();
const fontCss = lang === 'ja' ? 'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-jp-dynamic-subset.min.css' : 'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css';
const nav = [
  { href: `${P}/board/?daily=1`, label: T.nav.daily },
  { href: `${P}/play/`, label: T.nav.catalog },
  { href: `${P}/together/`, label: T.nav.together },
  { href: `${P}/photo/`, label: T.nav.photo },
  { href: `${P}/my/`, label: T.nav.my },
  // 랭킹·소개는 메뉴·바닥글에만. 나비는 다섯 항목이 한계라(언어마다 낱말 길이가 달라 여섯이면 글자가 두 줄로 접힌다)
  { href: `${P}/rank/`, label: T.nav.rank, sheetOnly: true },
  { href: `${P}/about/`, label: T.nav.about, sheetOnly: true },
];
// Cloudflare Web Analytics — 쿠키 없이 방문 수만 센다. 대시보드 Web Analytics 에서 사이트 추가 후 나온 토큰을 여기에
const CF_BEACON = '34fd6584be234e4b8b1e580413d95d1f';
const langPath = stripLang(Astro.url.pathname);
// 홈에만 구조화 데이터 — 한글 브랜드명(직소랩)을 alternateName 으로 알려 주고, 게임 앱이라는 것도 함께
const isHome = stripLang(path) === '/'; // 언어 코드를 손으로 나열하면 de·es 가 조용히 빠진다
const brand = { name: 'jigsawlab', ...(T.altName ? { alternateName: T.altName } : {}) };
const homeSchema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebSite', ...brand, url: site.toString(), inLanguage: lang, description: desc },
  { '@type': 'WebApplication', ...brand, url: canonical, inLanguage: lang, description: desc, applicationCategory: 'GameApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
] };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta name="naver-site-verification" content="1f5678d3427f33062b2e0426990b2f01daab34a7" />
  {noindex && <meta name="robots" content="noindex" />}
  {alts && Object.entries(alts).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, site).toString()} />)}
  {alts?.ko && <link rel="alternate" hreflang="x-default" href={new URL(alts.ko, site).toString()} />}
  <meta property="og:type" content="website" /><meta property="og:site_name" content="jigsawlab" />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site).toString()} /><meta property="og:locale" content={OG_LOCALE[lang]} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={desc} /><meta name="twitter:image" content={new URL(ogImage, site).toString()} />
  {isHome && <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="preload" href="/fonts/BMHANNAPro.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href={fontCss} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@800&display=swap" />
  {ads && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5830650963828895" crossorigin="anonymous" is:inline></script>}
  {CF_BEACON && import.meta.env.PROD && <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON })} is:inline></script>}
  <slot name="head" />
  <script is:inline define:vars={{ i18n: { copied: T.foot.copied, shareFail: T.foot.shareFail, prev: T.catalog.prev, next: T.catalog.next } }}>window.__i18n = i18n;</script>
</head>
<body>
  <header class="top" id="top">
    <a class="mark" href={`${P}/`} aria-label="jigsawlab">jigsawlab</a>
    <nav class="nav" aria-label="main">{nav.filter((n) => !n.sheetOnly).map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    <div class="right">
      <details class="langsel" id="langsel">
        <summary aria-label="language" title={UI[lang].langName}><Fragment set:html={icon('globe', 15)} /><span>{lang.toUpperCase()}</span></summary>
        <div class="langsel-pop">{LANGS.map((l) => <a href={`${prefix(l)}${langPath}`} aria-current={l === lang ? 'page' : undefined} lang={l} data-lang={l}><b>{l.toUpperCase()}</b>{UI[l].langName}</a>)}</div>
      </details>
      <button type="button" class="install-btn" id="install-btn" aria-label={T.app.install} title={T.app.install}><Fragment set:html={icon('download', 16)} /><span>{T.app.install}</span></button>
      <a class="acct" id="acct" href={`${P}/my/`} data-login={T.acct.login} data-fail={T.acct.fail} data-nick-ask={T.play.nickAsk} data-noauth="1"><Fragment set:html={icon('user', 16)} /><span id="acct-nick">{T.acct.login}</span></a>
      <a class="btn primary sm play-btn" href={`${P}/play/`}>{T.nav.play}</a>
      <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="menu"><span></span><span></span><span></span></button>
    </div>
  </header>
  <div class="gdlg" id="auth-dlg" hidden>
    <div class="gdlg-bg" id="auth-bg"></div>
    <div class="gdlg-box auth" role="dialog" aria-modal="true" aria-labelledby="auth-h">
      <button type="button" class="gdlg-x" id="auth-close" aria-label={T.acct.close}><Fragment set:html={icon('x', 18)} /></button>
      <div class="auth-mark">jigsawlab</div>
      <h2 id="auth-h">{T.acct.dlgTitle}</h2>
      <p class="auth-lead">{T.acct.dlgLead}</p>
      <a class="gbtn" id="auth-google" href={`/api/auth/login?next=${encodeURIComponent(`${P}/`)}`} rel="nofollow"><svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.5 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.3l7.9 6.1C12.4 13.7 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.7 6c4.5-4.2 6.9-10.3 6.9-17.7z"/><path fill="#FBBC05" d="M10.5 28.6c-.5-1.5-.8-3-.8-4.6s.3-3.1.8-4.6l-7.9-6.1C.9 16.5 0 20.1 0 24s.9 7.5 2.6 10.7l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.3 0 11.7-2.1 15.6-5.7l-7.7-6c-2.1 1.4-4.8 2.3-7.9 2.3-6.3 0-11.6-4.2-13.5-10l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg><span>{T.acct.google}</span></a>
      <ul class="auth-pts">{T.acct.dlgPoints.map((p) => <li><Fragment set:html={icon('check', 14)} />{p}</li>)}</ul>
      <p class="auth-foot"><a href={`${P}/privacy/`}>{T.foot.privacyTitle}</a></p>
    </div>
  </div>
  <div class="gdlg" id="nick-dlg" hidden data-title={T.acct.nickTitle} data-start={T.acct.nickStart} data-save={T.acct.nickSave}>
    <div class="gdlg-bg" id="nick-bg"></div>
    <form class="gdlg-box nick" id="nick-form" role="dialog" aria-modal="true" aria-labelledby="nick-h">
      <h2 id="nick-h">{T.acct.nickTitle}</h2>
      <p class="auth-lead">{T.acct.nickLead}</p>
      <div class="nick-wrap"><input class="input nick-in" id="nick-input" maxlength="12" autocomplete="nickname" placeholder={T.acct.nickPh} /><button type="button" class="nick-shuffle" id="nick-shuffle" title={T.acct.shuffle} aria-label={T.acct.shuffle}><Fragment set:html={icon('shuffle', 18)} /></button></div>
      <p class="nick-hint">{T.acct.nickHint}</p>
      <div class="nick-row"><button type="button" class="btn" id="nick-cancel">{T.acct.later}</button><button type="submit" class="btn primary" id="nick-ok">{T.acct.nickStart}</button></div>
    </form>
  </div>
  <!-- 레벨업·업적 다이얼로그. 채우고 여는 건 lib/levelup.ts (무거운 데이터를 물고 있어 필요할 때만 동적으로 불러온다) -->
  <div class="gdlg" id="aw-dlg" hidden>
    <div class="gdlg-bg" id="aw-bg"></div>
    <canvas class="aw-fx" id="aw-fx" aria-hidden="true"></canvas>
    <div class="gdlg-box aw-box" role="dialog" aria-modal="true" aria-labelledby="aw-h">
      <button type="button" class="gdlg-x" id="aw-x" aria-label={T.acct.close}><Fragment set:html={icon('x', 18)} /></button>
      <div class="aw-lv" id="aw-lv" hidden>
        <span class="aw-ring"><small>Lv</small><b id="aw-lv-n">1</b></span>
        <b class="aw-tier" id="aw-tier"></b>
        <small class="aw-jump" id="aw-jump"></small>
      </div>
      <h2 id="aw-h"></h2>
      <p class="aw-xp" id="aw-xp"></p>
      <p class="aw-nb" id="aw-nb" hidden>{T.lv.awNew}</p>
      <ul class="aw-list" id="aw-list"></ul>
      <div class="aw-cta"><button type="button" class="btn primary" id="aw-ok">{T.lv.awClose}</button><a class="btn" href={`${P}/my/`}>{T.lv.seeMy}</a></div>
    </div>
  </div>
  <div class="gdlg" id="install-dlg" hidden>
    <div class="gdlg-bg" id="install-bg"></div>
    <div class="gdlg-box install" role="dialog" aria-modal="true" aria-labelledby="install-h">
      <button type="button" class="gdlg-x" id="install-close" aria-label={T.acct.close}><Fragment set:html={icon('x', 18)} /></button>
      <img class="install-icon" src="/apple-touch-icon.png" alt="" width="72" height="72" />
      <h2 id="install-h">{T.app.installTitle}</h2>
      <p class="auth-lead" data-ios={T.app.iosLead} data-other={T.app.otherLead} data-samsung={T.app.samsungLead}>{T.app.iosLead}</p>
      <a class="btn primary install-chrome" id="install-chrome" hidden>{T.app.openChrome}</a>
      <ol class="install-steps" id="install-steps"><li><Fragment set:html={icon('share', 18)} /><span>{T.app.iosStep1}</span></li><li><Fragment set:html={icon('plus-square', 18)} /><span>{T.app.iosStep2}</span></li></ol>
    </div>
  </div>
  <div class="menu" id="menu" hidden>
    <div class="menu-bg" id="menu-bg"></div>
    <nav class="menu-sheet" aria-label="menu">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <button type="button" class="menu-install" id="menu-install" hidden><Fragment set:html={icon('download', 18)} /><span>{T.app.install}</span></button>
      <a class="btn primary" href={`${P}/play/`}>{T.nav.play}</a>
      <div class="menu-langs">{LANGS.map((l) => <a href={`${prefix(l)}${langPath}`} aria-current={l === lang ? 'page' : undefined} lang={l} data-lang={l}>{UI[l].langName}</a>)}</div>
    </nav>
  </div>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-brand"><span class="mark-text">jigsawlab</span><p>{T.tagline}</p></div>
      <div class="foot-links">
        <a href={`${P}/board/?daily=1`}>{T.nav.daily}</a>
        <a href={`${P}/play/`}>{T.nav.catalog}</a>
        <a href={`${P}/together/`}>{T.nav.together}</a>
        <a href={`${P}/photo/`}>{T.nav.photo}</a>
        <a href={`${P}/my/`}>{T.nav.my}</a>
        <a href={`${P}/rank/`}>{T.nav.rank}</a>
        <a href={`${P}/about/`}>{T.nav.about}</a>
        <a href={`${P}/contact/`}>{T.foot.contact}</a>
        <a href={`${P}/terms/`}>{T.foot.terms}</a>
        <a href={`${P}/privacy/`}>{T.foot.privacy}</a>
      </div>
      <div class="foot-meta"><span>{T.foot.rights}</span><a href={`${P}/contact/`}>{T.foot.contact}</a><span>© 2026 jigsawlab</span></div>
    </div>
  </footer>
  <script>
    import { initShelves } from '../lib/shelf';
    import { LANGS, docLang } from '../i18n/langs'; // 언어 목록·판별만 — i18n/ui 를 물면 언어팩 5개가 모든 페이지에 실린다
    initShelves(); // 가로 진열대: PC 화살표·드래그
    // 스크롤 리빌: [data-reveal] 요소가 화면에 들어오면 .in — 모션 최소화 설정이면 즉시 표시
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('in'));
    else { const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }); els.forEach((e) => io.observe(e)); }
    const top = document.getElementById('top')!; const onS = () => top.classList.toggle('scrolled', scrollY > 8); onS(); addEventListener('scroll', onS, { passive: true });
    // 계정 버튼(선택 로그인). 로그인 직후 해시로 결과를 받음: new → 닉네임 정하기, ok → 이 기기 기록 합치기
    Promise.all([import('../lib/account'), import('../lib/authui'), import('../lib/nickgen')]).then(async ([{ me, setNickRemote, mergeLocalDone, authAvailable }, { initAuthUI, openLogin, askNick }, { randomNick }]) => {
      initAuthUI();
      const a = document.getElementById('acct') as HTMLAnchorElement, nk = document.getElementById('acct-nick')!;
      const h = location.hash.match(/^#login=(\w+)/); if (h) history.replaceState(null, '', location.pathname + location.search);
      const u = await me(!!h); a.dataset.noauth = authAvailable() ? '0' : '1';
      // XP·레벨·업적은 회원만 쌓이므로 XP 안내(.xp-tip)도 회원에게만 보인다 — 화면마다 검사하지 않고 여기서 한 번에
      document.documentElement.classList.toggle('member', !!u);
      if (u) { nk.textContent = u.nick || a.dataset.login!; }
      else { nk.textContent = a.dataset.login!; a.href = '#'; a.addEventListener('click', (e) => { e.preventDefault(); openLogin(); }); }
      if (h?.[1] === 'fail') alert(a.dataset.fail ?? 'login failed');
      if (u && (h?.[1] === 'new' || !u.nick)) { let cur = ''; try { cur = localStorage.getItem('nick') ?? ''; } catch {} const n = (await askNick(cur, 'new')) || cur || randomNick(docLang()); if (n && (await setNickRemote(n))) nk.textContent = n; }
      // 로그인한 채 맞췄는데 서버에 못 올라간 판(완성 때 전송 실패)을 올린다. 비회원으로 맞춘 판은 로그인해도 안 준다
      if (u) mergeLocalDone().then(async (a) => {
        if (!a || a.gained <= 0) return;
        const { showAwardDialog } = await import('../lib/levelup');
        if (showAwardDialog(a)) return; // 레벨업·업적이 있으면 다이얼로그로 (합치면서 여러 단계 오르기도 한다)
        const { toast } = await import('../lib/share'); const { UI, docLang } = await import('../i18n/ui');
        toast(UI[docLang()].lv.merged(a.xp.toLocaleString(), a.level));
      });
    });
    // 모바일 메뉴
    const mb = document.getElementById('menu-btn')!, menu = document.getElementById('menu')!;
    const setMenu = (o: boolean) => { menu.hidden = !o; mb.setAttribute('aria-expanded', String(o)); document.documentElement.style.overflow = o ? 'hidden' : ''; };
    mb.addEventListener('click', () => setMenu(!!menu.hidden)); document.getElementById('menu-bg')!.addEventListener('click', () => setMenu(false)); addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
    // 앱 설치 — Chrome·Edge 는 beforeinstallprompt 를 붙들어 두었다가 버튼에서 띄우고, iOS Safari 는 설치 프롬프트가 없어 '홈 화면에 추가' 안내를 띄운다. 이미 앱으로 열렸으면 숨긴다
    const ib = document.getElementById('install-btn')!, mi = document.getElementById('menu-install')!, idlg = document.getElementById('install-dlg')!;
    const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
    const ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    // 삼성 인터넷은 WebAPK 를 옛 targetSdk 로 찍어 안드로이드 14+ 가 '이전 버전용 앱'이라며 설치를 막는다(삼성 쪽 문제) → 프롬프트 대신 같은 주소를 Chrome 으로 여는 intent 링크
    const samsung = /SamsungBrowser/i.test(navigator.userAgent);
    let deferred: any = null;
    const showInstall = (on: boolean) => { ib.classList.toggle('on', on); mi.hidden = !on; };
    const installDlg = (on: boolean) => { idlg.hidden = !on; document.documentElement.classList.toggle('dlg-open', !!document.querySelector('.gdlg:not([hidden])')); if (on) setMenu(false); };
    const install = async () => {
      const lead = idlg.querySelector<HTMLElement>('.auth-lead')!, chrome = document.getElementById('install-chrome') as HTMLAnchorElement, steps = document.getElementById('install-steps')!;
      if (samsung) { lead.textContent = lead.dataset.samsung!; steps.hidden = true; chrome.hidden = false; chrome.href = `intent://${location.host}${location.pathname}${location.search}#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url=${encodeURIComponent('https://play.google.com/store/apps/details?id=com.android.chrome')};end`; installDlg(true); return; }
      if (deferred) { const ev = deferred; deferred = null; setMenu(false); ev.prompt(); try { const { outcome } = await ev.userChoice; if (outcome === 'accepted') showInstall(false); else deferred = ev; } catch { deferred = ev; } return; }
      lead.textContent = ios ? lead.dataset.ios! : lead.dataset.other!; steps.hidden = !ios; chrome.hidden = true; installDlg(true);
    };
    if (!standalone) {
      addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; showInstall(true); });
      addEventListener('appinstalled', () => { deferred = null; showInstall(false); });
      if (ios || samsung) showInstall(true);
    }
    ib.addEventListener('click', install); mi.addEventListener('click', install);
    document.getElementById('install-bg')!.addEventListener('click', () => installDlg(false)); document.getElementById('install-close')!.addEventListener('click', () => installDlg(false)); addEventListener('keydown', (e) => { if (e.key === 'Escape') installDlg(false); });
    // 언어 드롭다운 — 바깥을 누르거나 Esc 로 닫는다
    const lsel = document.getElementById('langsel') as HTMLDetailsElement | null;
    if (lsel) { addEventListener('click', (e) => { if (lsel.open && !lsel.contains(e.target as Node)) lsel.open = false; }); addEventListener('keydown', (e) => { if (e.key === 'Escape') lsel.open = false; }); }
    // 언어: 직접 고르면 기억, 첫 방문이면 브라우저 언어로
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang!); } catch {} }));
    try { const pageLang = document.documentElement.lang, saved = localStorage.getItem('lang'); const want = saved || (navigator.language || '').slice(0, 2); if ((LANGS as string[]).includes(want) && want !== pageLang && !saved) { localStorage.setItem('lang', want); const path = location.pathname.replace(new RegExp('^/(' + LANGS.filter((l) => l !== 'ko').join('|') + ')(?=/|$)'), '') || '/'; location.replace((want === 'ko' ? '' : '/' + want) + path + location.search); } } catch {}
  </script>
</body>
</html>

<style is:global>
