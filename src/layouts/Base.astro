---
// 공통 틀 — 밝은 종이 바탕, 코발트 하나, 제목은 명조(고운바탕 / Zen Old Mincho), 본문은 IBM Plex Sans
import { UI, LANGS, prefix, type Lang } from '../i18n/ui';
interface Props { title: string; desc: string; lang?: Lang; ogImage?: string; alts?: Partial<Record<Lang, string>>; noindex?: boolean; path?: string; bare?: boolean }
const { title, desc, lang = 'ko', ogImage = '/og.png', alts, noindex = false, path = Astro.url.pathname, bare = false } = Astro.props;
const T = UI[lang], P = prefix(lang), site = Astro.site ?? new URL('https://jigsawlab.app');
const canonical = new URL(path, site).toString();
const fonts = lang === 'ja' ? 'family=Zen+Old+Mincho:wght@700&family=IBM+Plex+Sans+JP:wght@400;500;700' : 'family=Gowun+Batang:wght@700&family=IBM+Plex+Sans+KR:wght@400;500;700';
const nav = [
  { href: `${P}/play/?daily=1`, label: T.nav.daily },
  { href: `${P}/#catalog`, label: T.nav.catalog },
  { href: `${P}/play/?photo=1`, label: T.nav.photo },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {alts && Object.entries(alts).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, site).toString()} />)}
  {alts?.ko && <link rel="alternate" hreflang="x-default" href={new URL(alts.ko, site).toString()} />}
  <meta property="og:type" content="website" /><meta property="og:site_name" content="jigsawlab" />
  <meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site).toString()} /><meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f3f4f6" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
  <slot name="head" />
  <script is:inline define:vars={{ i18n: { copied: T.foot.copied, shareFail: T.foot.shareFail } }}>window.__i18n = i18n;</script>
</head>
<body class:list={[{ bare }]}>
  <header class="top">
    <a class="mark" href={`${P}/`} aria-label="jigsawlab">
      <svg width="28" height="28" viewBox="0 0 26 26" aria-hidden="true"><path d="M4 4h7.2a3 3 0 1 1 3.6 0H22v7.2a3 3 0 1 0 0 3.6V22h-7.2a3 3 0 1 1-3.6 0H4v-7.2a3 3 0 1 0 0-3.6z" fill="currentColor"/></svg>
      <span>jigsawlab</span>
    </a>
    <nav class="nav" aria-label="main">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    <div class="right">
      <a class="btn primary sm play-btn" href={`${P}/play/`}>{T.nav.play}</a>
      <nav class="langs" aria-label="language">{LANGS.map((l) => <a href={`${prefix(l)}${Astro.url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/'}`} aria-current={l === lang ? 'page' : undefined} lang={l}>{UI[l].langName}</a>)}</nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="foot-in">
      <div class="foot-brand"><span class="mark-text">jigsawlab</span><p>{T.tagline}</p></div>
      <div class="foot-links">
        <a href={`${P}/play/?daily=1`}>{T.nav.daily}</a>
        <a href={`${P}/#catalog`}>{T.nav.catalog}</a>
        <a href={`${P}/play/?photo=1`}>{T.nav.photo}</a>
        <a href={`${P}/privacy/`}>{T.foot.privacy}</a>
      </div>
      <div class="foot-meta"><span>{T.foot.rights}</span><a href="https://cantong.app" rel="noopener">{T.foot.madeBy}</a><span>© 2026 jigsawlab</span></div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --paper: #f3f4f6; --paper-2: #eaecf0; --board: #e4e7ed; --white: #fff; --ink: #14172a; --ink-2: #3b4056; --muted: #676d82; --line: #d3d7e0; --line-soft: #e5e8ee;
    --accent: #2a46e0; --accent-deep: #1e35b8; --accent-soft: #e6eafb; --gold: #d9971a; --gold-soft: #fdf3dc;
    --box: #f6f1e6; --box-2: #e9e1cf; --box-edge: #cbbf9f; --box-frame: #a8834c;
    --top-h: 60px; --radius: 16px; --max: 1120px;
    --sans: 'IBM Plex Sans KR', 'IBM Plex Sans JP', 'Apple SD Gothic Neo', 'Noto Sans KR', system-ui, sans-serif;
    --serif: 'Gowun Batang', 'Zen Old Mincho', 'Apple Myungjo', 'Noto Serif KR', serif;
    color-scheme: light;
  }
  html[lang="ja"] { --serif: 'Zen Old Mincho', 'Hiragino Mincho ProN', 'Noto Serif JP', serif; --sans: 'IBM Plex Sans JP', 'Hiragino Sans', 'Noto Sans JP', system-ui, sans-serif; }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 16px; line-height: 1.6; min-height: 100dvh; display: flex; flex-direction: column; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  button, input { font: inherit; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  h1, h2, h3 { margin: 0; line-height: 1.25; letter-spacing: -0.01em; }
  .serif { font-family: var(--serif); font-weight: 700; letter-spacing: -0.005em; }
  img { max-width: 100%; }
  html[data-play="on"] { overflow: hidden; } html[data-play="on"] .foot { display: none; }

  /* 헤더 */
  .top { height: var(--top-h); display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; padding: 0 max(20px, calc((100% - var(--max)) / 2)); border-bottom: 1px solid var(--line-soft); background: rgba(243,244,246,.92); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 20; }
  .mark { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; } .mark svg { color: var(--accent); } .mark:hover { text-decoration: none; }
  .nav { display: flex; gap: 4px; } .nav a { color: var(--ink-2); font-weight: 500; font-size: .95rem; padding: 8px 12px; border-radius: 10px; } .nav a:hover { background: var(--paper-2); text-decoration: none; color: var(--ink); }
  .right { display: flex; align-items: center; gap: 12px; }
  .langs { display: flex; gap: 2px; } .langs a { color: var(--muted); font-size: .82rem; padding: 6px 8px; border-radius: 8px; white-space: nowrap; } .langs a[aria-current] { color: var(--ink); background: var(--white); box-shadow: inset 0 0 0 1px var(--line); } .langs a:hover { text-decoration: none; color: var(--ink); }
  @media (max-width: 760px) { .top { grid-template-columns: auto 1fr; gap: 12px; padding: 0 14px; } .nav { display: none; } .right { justify-self: end; gap: 6px; } .top .play-btn { display: none; } .langs a { padding: 6px 6px; font-size: .8rem; } }
  @media (max-width: 640px) { html[data-play="on"] .top { display: none; } html[data-play="on"] { --top-h: 0px; } }
  #main { flex: 1; display: flex; flex-direction: column; }

  /* 푸터 */
  .foot { border-top: 1px solid var(--line-soft); background: var(--paper-2); margin-top: 48px; }
  .foot-in { max-width: var(--max); margin: 0 auto; padding: 36px 20px 44px; display: grid; gap: 22px; grid-template-columns: 1.2fr 1fr; }
  .mark-text { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; } .foot-brand p { margin: 4px 0 0; color: var(--muted); font-family: var(--serif); font-size: 1.02rem; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 6px 18px; align-content: start; } .foot-links a { color: var(--ink-2); font-size: .92rem; }
  .foot-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font-size: .82rem; padding-top: 14px; border-top: 1px solid var(--line-soft); } .foot-meta a { color: var(--muted); }
  @media (max-width: 640px) { .foot-in { grid-template-columns: 1fr; } }

  /* 섹션 공통 */
  .wrap { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 20px; }
  .sec { padding: 56px 0 8px; } .sec-h { font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 8px; } .sec-sub { margin: 0 0 24px; color: var(--muted); max-width: 40em; }
  @media (max-width: 640px) { .sec { padding: 40px 0 4px; } }

  /* 장면 (플레이 앱) */
  .scene { display: none; } .scene.active { display: block; }
  .scene.page { width: 100%; max-width: 760px; margin: 0 auto; padding: 28px 20px 40px; }
  .scene.play { position: fixed; left: 0; right: 0; bottom: 0; top: var(--top-h); background: var(--board); z-index: 10; }

  /* 부품 */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 8px 20px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink); font-weight: 600; cursor: pointer; transition: background .12s, transform .08s, box-shadow .12s; white-space: nowrap; }
  .btn:hover { background: #fafbfd; text-decoration: none; } .btn:active { transform: translateY(1px); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 6px 16px -8px rgba(42,70,224,.7); } .btn.primary:hover { background: var(--accent-deep); }
  .btn.lg { min-height: 54px; padding: 10px 28px; font-size: 1.05rem; } .btn.sm { min-height: 36px; padding: 4px 14px; font-size: .88rem; }
  .card { background: var(--white); border: 1px solid var(--line-soft); border-radius: var(--radius); padding: 20px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: var(--white); border: 1px solid var(--line-soft); font-size: .85rem; font-weight: 600; white-space: nowrap; }
  .input { width: 100%; min-height: 44px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); font-size: 16px; } .input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
  .field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: 4px; }
  .muted { color: var(--muted); }
  .toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 12px); background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 999px; font-size: .9rem; opacity: 0; pointer-events: none; transition: opacity .18s, transform .18s; z-index: 50; } .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .lb { list-style: none; margin: 0; padding: 0; } .lb li { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-top: 1px solid var(--line-soft); } .lb li.empty { color: var(--muted); border: 0; padding: 4px 0; }
  .lb .rank { width: 26px; color: var(--muted); font-weight: 600; font-variant-numeric: tabular-nums; } .lb .nick { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .lb .score { font-weight: 600; font-variant-numeric: tabular-nums; } .lb .score small { color: var(--muted); font-weight: 400; }
  .lb li:nth-child(1) .rank { color: var(--gold); }

  /* 퍼즐 상자 (카탈로그·상세 공통) */
  .box { position: relative; display: block; padding: 0 0 0 13px; border: 0; background: none; cursor: pointer; text-align: left; color: var(--ink); perspective: 800px; -webkit-tap-highlight-color: transparent; text-decoration: none; }
  .box:hover { text-decoration: none; }
  .box .front { display: block; border-radius: 3px 7px 7px 3px; background: linear-gradient(168deg, #fbf8f1 0%, var(--box) 55%, var(--box-2) 100%); box-shadow: 0 1px 0 rgba(255,255,255,.85) inset, 0 14px 24px -12px rgba(20,23,42,.5), 1px 1px 0 rgba(20,23,42,.08); padding: 8px 9px 7px; transform: rotateY(-9deg); transform-origin: left center; transition: transform .18s ease, box-shadow .18s ease; }
  .box .spine { position: absolute; left: 0; top: 0; bottom: 0; width: 13px; border-radius: 3px 0 0 3px; background: linear-gradient(90deg, var(--box-edge), var(--box-2)); box-shadow: inset -1px 0 0 rgba(20,23,42,.08); transform-origin: right center; transform: rotateY(38deg) translateX(1px); overflow: hidden; }
  .box .spine span { position: absolute; left: 50%; top: 9px; transform: translateX(-50%) rotate(90deg); transform-origin: top left; white-space: nowrap; font-size: .55rem; color: #6b6352; letter-spacing: .02em; margin-left: 2px; }
  .box:hover .front, .box.on .front { transform: rotateY(-4deg) translateY(-4px); box-shadow: 0 1px 0 rgba(255,255,255,.85) inset, 0 20px 28px -14px rgba(20,23,42,.55), 0 0 0 2px var(--accent); }
  .box-top { display: flex; align-items: baseline; gap: 6px; margin: 0 0 6px; min-height: 1.1em; } .box-top small { font-size: .68rem; color: #7a715e; font-variant-numeric: tabular-nums; } .box-top b { flex: 1; text-align: center; font-family: var(--serif); font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .box img { display: block; width: 100%; aspect-ratio: 5 / 4; height: auto; object-fit: cover; border: 2px solid var(--box-frame); outline: 1px solid rgba(255,255,255,.7); outline-offset: -3px; background: var(--board); }
  .box-foot { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; margin: 6px 0 0; } .box-foot .logo { font-size: .58rem; font-weight: 700; color: var(--accent); } .box-foot small { font-size: .62rem; color: #7a715e; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .boxes { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 20px 16px; }
  @media (max-width: 480px) { .boxes { grid-template-columns: repeat(2, 1fr); gap: 16px 12px; } }

  .seo { color: var(--ink); } .seo h2 { font-family: var(--serif); font-size: 1.35rem; margin: 30px 0 8px; } .seo h3 { font-size: 1.02rem; margin: 18px 0 4px; } .seo p, .seo li { color: var(--ink-2); max-width: 70ch; } .seo .lead { font-size: 1.08rem; color: var(--ink); } .seo ol, .seo ul { padding-left: 20px; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } html { scroll-behavior: auto; } }
</style>
