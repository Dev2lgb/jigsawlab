---
// /i/?room=<id> — 방 초대 랜딩(서버 렌더). OG 를 방마다 다르게 만들려면 정적일 수 없다. [...lang] 은 진짜 언어 접두어일 때만
import Invite from '../../../components/Invite.astro';
import { langFromParam } from '../../../i18n/ui';
export const prerender = false;
const lang = langFromParam(Astro.params.lang);
if (!lang) return new Response(null, { status: 404 });
---
<Invite lang={lang} />
