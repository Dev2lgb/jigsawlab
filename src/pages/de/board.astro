---
import Base from '../../layouts/Base.astro';
import Jigsaw from '../../components/Jigsaw.astro';
import PlayBoot from '../../components/PlayBoot.astro';
import { JIGSAW } from '../../i18n/jigsaw';
const t = JIGSAW.de;
---
<Base ads={false} noindex title={`${t.boardTitle} · jigsawlab`} desc={t.seoDesc} lang="de" path="/de/board/">
  <PlayBoot slot="head" />
  <Jigsaw lang="de" />
</Base>
