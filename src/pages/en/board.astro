---
import Base from '../../layouts/Base.astro';
import Jigsaw from '../../components/Jigsaw.astro';
import PlayBoot from '../../components/PlayBoot.astro';
import { JIGSAW } from '../../i18n/jigsaw';
const t = JIGSAW.en;
---
<Base ads={false} noindex title={`${t.boardTitle} · jigsawlab`} desc={t.seoDesc} lang="en" path="/en/board/">
  <PlayBoot slot="head" />
  <Jigsaw lang="en" />
</Base>
