---
import Base from '../../layouts/Base.astro';
import Jigsaw from '../../components/Jigsaw.astro';
import PlayBoot from '../../components/PlayBoot.astro';
import { JIGSAW } from '../../i18n/jigsaw';
const t = JIGSAW.en;
---
<Base ads={false} title={`${t.title} · jigsawlab`} desc={t.sub} lang="en" alts={{ ko: '/play/', en: '/en/play/', ja: '/ja/play/' }} path="/en/play/">
  <PlayBoot slot="head" />
  <Jigsaw lang="en" />
</Base>
