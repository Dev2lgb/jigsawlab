---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { altsFor, UI } from '../../i18n/ui';
import { JIGSAW } from '../../i18n/jigsaw';
import { WORKS } from '../../data/works';
const T = UI.es, t = JIGSAW.es;
---
<Base title={T.seoTitle} desc={T.seoDesc(WORKS.length)} lang="es" alts={altsFor('/')} path="/es/">
  <Home lang="es" />
</Base>
