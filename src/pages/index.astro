---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { altsFor, UI } from '../i18n/ui';
import { JIGSAW } from '../i18n/jigsaw';
import { WORKS } from '../data/works';
const T = UI.ko, t = JIGSAW.ko;
---
<Base title={T.seoTitle} desc={T.seoDesc(WORKS.length)} lang="ko" alts={altsFor('/')} path="/">
  <Home lang="ko" />
</Base>
