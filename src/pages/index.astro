---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { UI } from '../i18n/ui';
import { JIGSAW } from '../i18n/jigsaw';
const T = UI.ko, t = JIGSAW.ko;
---
<Base title={T.seoTitle} desc={T.seoDesc} lang="ko" alts={{ ko: '/', en: '/en/', ja: '/ja/' }} path="/">
  <Home lang="ko" />
</Base>
