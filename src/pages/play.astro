---
import Base from '../layouts/Base.astro';
import Jigsaw from '../components/Jigsaw.astro';
import { JIGSAW } from '../i18n/jigsaw';
const t = JIGSAW.ko;
---
<Base title={`${t.title} · jigsawlab`} desc={t.sub} lang="ko" alts={{ ko: '/play/', en: '/en/play/', ja: '/ja/play/' }} path="/play/">
  <Jigsaw lang="ko" />
</Base>
