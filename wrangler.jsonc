{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jigsawlab",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // 정적 HTML 도 Worker 를 먼저 태운다 — worker.ts 의 www → apex 301 이 걸리게 하려고.
  // (기본값에서는 Asset Worker 가 HTML 을 먼저 돌려줘서 worker.ts 까지 오지 않는다)
  // 이미지·번들·폰트는 부정 규칙으로 빼 둔다. 트래픽 대부분이라 Worker 를 태울 이유가 없다
  "assets": { "binding": "ASSETS", "run_worker_first": ["/*", "!/jigsaw/*", "!/_astro/*", "!/fonts/*"] },
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [{ "pattern": "jigsawlab.app", "custom_domain": true }, { "pattern": "www.jigsawlab.app", "custom_domain": true }],
  // D1: 처음 한 번 `npx wrangler d1 create jigsawlab-db` 후 database_id 를 여기에 넣는다
  "d1_databases": [{ "binding": "DB", "database_name": "jigsawlab-db", "database_id": "de162564-bbfa-4ce0-8abf-f3609cc8190b", "migrations_dir": "migrations" }]
}
